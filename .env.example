# 🟡 P3-1: 环境变量配置示例
# ================================
# 复制此文件为 .env 并填写真实值

# ─── 数据库 ───────────────────────
POSTGRES_DB=rmfood_db
POSTGRES_USER=rmfood
POSTGRES_PASSWORD=your_secure_password_here

# ─── 安全 ─────────────────────────
SECRET_KEY=your-very-long-secret-key-min-32-chars-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
HEALTH_CHECK_TOKEN=change-me-in-production

# ─── Redis ────────────────────────
REDIS_PASSWORD=

# ─── 服务端口映射 ─────────────────
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3030

# ─── AI 服务（可选）───────────────
AI_API_KEY=
AI_BASE_URL=

# ─── CORS ────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ─── 日志级别 ─────────────────────
LOG_LEVEL=INFO

# ─── 监控 (Grafana) ───────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123
PROMETHEUS_PORT=9090
GRAFANA_PORT=3030
LOKI_PORT=3100
TEMPO_PORT=3200
TEMPO_HTTP_PORT=4318

# ─── Nginx 代理 ──────────────────
HTTP_PORT=80
HTTPS_PORT=443
