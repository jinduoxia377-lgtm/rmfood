# 🟡 P3-1: RMFOOD配方平台环境变量配置示例
# ================================
# 复制此文件为 .env 并填写真实值

# ─── 基础应用设置 ───────────────────────
ENV=production                    # 运行环境: development/staging/production/test
DEBUG=false                       # 调试模式（生产环境必须为false）
APP_NAME=RMFOOD配方平台           # 应用名称
APP_VERSION=2.0.0                 # 应用版本

# ─── 数据库（PostgreSQL）────────────────
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/rmfood_db  # 主数据库
DATABASE__POOL_SIZE=20            # 连接池大小
DATABASE__MAX_OVERFLOW=10         # 连接池溢出上限
DATABASE__POOL_TIMEOUT=30         # 连接获取超时（秒）
DATABASE__POOL_RECYCLE=3600       # 连接回收周期（秒）
DATABASE__ECHO=false              # 是否打印SQL语句

# 备选：传统环境变量
POSTGRES_HOST=localhost           # 数据库主机
POSTGRES_PORT=5432                # 数据库端口
POSTGRES_USER=rmfood              # 数据库用户
POSTGRES_PASSWORD=your_secure_password_here  # 数据库密码
POSTGRES_DB=rmfood_db             # 数据库名称

# ─── Redis（缓存和会话）─────────────────
REDIS_URL=redis://localhost:6379/0  # Redis连接URL
REDIS__MAX_CONNECTIONS=50         # 最大连接数
REDIS__SOCKET_TIMEOUT=5           # Socket超时（秒）
REDIS__CACHE_TTL=3600             # 默认缓存TTL（秒）
REDIS_PASSWORD=                   # Redis密码（可选）

# ─── 安全设置 ───────────────────────────
SECRET_KEY=your-very-long-secret-key-min-32-chars-change-this  # JWT签名密钥
SECURITY__JWT_ALGORITHM=HS256     # JWT算法
SECURITY__JWT_EXPIRE_MINUTES=480  # JWT过期时间（分钟）
SECURITY__JWT_REFRESH_EXPIRE_DAYS=30  # 刷新令牌过期时间（天）
SECURITY__PASSWORD_MIN_LENGTH=8   # 密码最小长度
SECURITY__CORS_ORIGINS=http://localhost:3000,http://localhost:8080  # CORS允许源
SECURITY__CORS_ALLOW_CREDENTIALS=true  # 是否允许携带凭证

# ─── 日志配置 ───────────────────────────
LOG_LEVEL=INFO                    # 日志级别: DEBUG/INFO/WARNING/ERROR/CRITICAL
LOGGING__FORMAT=json              # 日志格式: json/text
LOGGING__ENABLE_FILE=true         # 是否输出到文件
LOGGING__FILE_DIR=logs            # 日志文件目录
LOGGING__SLOW_QUERY_THRESHOLD_MS=1000  # 慢查询阈值（毫秒）

# ─── 服务器配置 ─────────────────────────
SERVER__HOST=0.0.0.0              # 监听地址
SERVER__PORT=8000                 # 监听端口
SERVER__WORKERS=4                 # 工作进程数
SERVER__TIMEOUT_KEEP_ALIVE=30     # Keep-alive超时（秒）
SERVER__LIMIT_CONCURRENCY=1000    # 最大并发连接数

# ─── AI服务配置（可选）─────────────────
AI_API_KEY=                       # AI服务API Key
AI_BASE_URL=                      # AI服务Base URL
AI_SERVICE__MODEL=gpt-4           # 默认模型
AI_SERVICE__MAX_TOKENS=4096       # 最大Token数
AI_SERVICE__TEMPERATURE=0.7       # Temperature参数
AI_SERVICE__REQUEST_TIMEOUT=60    # 请求超时（秒）

# ─── 监控配置 ──────────────────────────
MONITORING__ENABLE_METRICS=true   # 是否启用Prometheus指标
MONITORING__METRICS_PORT=9090     # Prometheus端口
MONITORING__HEALTH_CHECK_INTERVAL=30  # 健康检查间隔（秒）

# ─── 服务端口映射（Docker部署）─────────
HTTP_PORT=80                      # HTTP端口
HTTPS_PORT=443                    # HTTPS端口
FRONTEND_PORT=3000                # 前端开发端口
PROMETHEUS_PORT=9090              # Prometheus端口
GRAFANA_PORT=3030                 # Grafana端口
LOKI_PORT=3100                    # Loki端口
TEMPO_PORT=3200                   # Tempo端口

# ─── Grafana监控 ──────────────────────
GRAFANA_ADMIN_USER=admin          # Grafana管理员用户
GRAFANA_ADMIN_PASSWORD=admin123   # Grafana管理员密码

# ─── 功能开关 ──────────────────────────
FEATURE__EMAIL_ENABLED=false      # 邮件功能是否启用
FEATURE__SMS_ENABLED=false        # 短信功能是否启用
FEATURE__WEBHOOK_ENABLED=true     # Webhook功能是否启用
FEATURE__API_RATE_LIMIT=true      # API速率限制是否启用

# ─── 外部服务API密钥（可选）───────────
SENDGRID_API_KEY=                 # SendGrid邮件服务API Key
TWILIO_ACCOUNT_SID=               # Twilio短信服务Account SID
TWILIO_AUTH_TOKEN=                # Twilio短信服务Auth Token
STRIPE_API_KEY=                   # Stripe支付服务API Key
