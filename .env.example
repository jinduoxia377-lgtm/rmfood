# ════════════════════════════════════════════════════════════════
# RMFOOD 应用配置 - 示例文件
# ════════════════════════════════════════════════════════════════
# 使用方法:
# 1. 复制此文件为 .env
# 2. 根据环境填入真实配置
# 3. 不要将 .env 文件提交到版本控制
# ════════════════════════════════════════════════════════════════

# ── 应用基础 ─────────────────────────────────────────────────────
APP_NAME=RMFOOD配方制作平台
APP_VERSION=2.1.0
DEBUG=false

# ── 数据库（仅支持 PostgreSQL）───────────────────────────────────
# 本项目仅支持 PostgreSQL，不支持 SQLite 或 MySQL。
# 方式1: 使用完整 URL（推荐）
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
# 方式2: 使用分离的环境变量
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=rmfood
# POSTGRES_PASSWORD=your_secure_password
# POSTGRES_DB=rmfood_db
# 连接池配置
# DATABASE__POOL_SIZE=20
# DATABASE__MAX_OVERFLOW=10
# DATABASE__SSL_MODE=prefer

# ── 安全配置 (必须修改!) ─────────────────────────────────────────
# 生成强密钥命令:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-strong-random-secret-key-min-64-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── 初始管理员账号 ───────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请在此处设置强密码（至少16字符，包含大小写字母和数字）
ADMIN_EMAIL=admin@example.com

# ── CORS 配置 ────────────────────────────────────────────────────
CORS_ORIGINS=["https://yourdomain.com","https://app.yourdomain.com"]

# ── AI 智能服务 (LLM 配置) ──────────────────────────────────────
LLM_PROVIDER=deepseek
OPENAI_API_KEY=your-actual-api-key
OPENAI_BASE_URL=
LLM_MODEL=deepseek-chat
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7

# ── API Key 加密密钥（独立于 SECRET_KEY）─────────────────────────
# 🔒 用途：加密持久化到数据库的 LLM API Key（非 JWT 签名密钥）
# 📦 要求：32 字节 URL-safe base64 字符串
# 🛠️ 生成命令:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ⚠️  必须与 SECRET_KEY 不同！修改后旧加密的 API Key 将无法解密
#     （如需迁移，需手动更新数据库中的 api_key 字段）
ENCRYPTION_KEY=change-me-to-a-32-char-url-safe-base64-string-xyz1234567890ABCDEF=

# ── Ray 分布式计算 (可选, 用于大规模AI任务) ──────────────────────
RAY_ADDRESS=auto                           # Ray集群地址: auto | "ray://host:port"
RAY_NUM_CPUS=0                            # 0 = 使用所有CPU, 整数 = 指定CPU数量
RAY_NUM_GPUS=0                            # 0 = 使用所有GPU, 整数 = 指定GPU数量
RAY_OBJECT_STORE_MEMORY=4_000_000_000     # 对象存储内存: 4GB
RAY_LOG_TO_DRIVER=true                    # 是否将日志发送到驱动程序
RAY_DASHBOARD_HOST=0.0.0.0                # Dashboard 主机
RAY_DASHBOARD_PORT=8265                   # Dashboard 端口
RAY_RUNTIME_ENV=requirements.txt         # 运行时环境依赖文件
RAY_MAX_RESTARTS=3                        # 任务最大重启次数
RAY_REUSE_ACTORS=true                     # 是否重用Actor实例
RAY_INCLUDE_DASHBOARD=true                # 是否包含Dashboard
RAY_RAYLET_CONFIG={"node_manager_port": 6379, "object_store_port": 8076}

# 任务相关配置
RAY_TASK_TIMEOUT_SECONDS=300              # 任务超时时间
RAY_MAX_CONCURRENT_TASKS=10               # 最大并发任务数
RAY_TASK_RETRY_DELAY_SECONDS=5            # 任务重试延迟
RAY_ENABLE_RESOURCE_MONITORING=true       # 启用资源监控
RAY_RESOURCE_CHECK_INTERVAL_SECONDS=30    # 资源检查间隔

# ── 缓存服务 (Redis, 可选) ───────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── 搜索引擎 (Elasticsearch, 可选) ───────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=your-es-api-key

# ── 图数据库 (Neo4j, 可选) ───────────────────────────────────────
# ⚠️ 生产环境请通过环境变量 NEO4J_AUTH 或系统级密钥管理注入密码
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ── 文件上传配置 ─────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ── 日志配置 ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/rmfood.log

# ══════════════════════════════════════
# PepINVERT 配置（可选，用于高级肽设计）
# ══════════════════════════════════════
PEPINVENT_GENERATIVE_MODEL_PATH=./models/pepinvent_generative.pt
PEPINVENT_PREDICTOR_MODEL_PATH=./models/pepinvent_predictor.pt
PEPINVENT_DEVICE=auto  # auto|cuda|cpu
PEPINVENT_TEMPERATURE=1.0
PEPINVENT_TOP_K=50
PEPINVENT_BATCH_SIZE=32
PEPINVENT_LEARNING_RATE=0.0001
PEPINVENT_EPOCHS=10
PEPINVENT_RL_BATCH_SIZE=128
PEPINVENT_TIMEOUT_SECONDS=60
PEPINVENT_ENABLE_CACHE=true
PEPINVENT_CACHE_TTL=3600
