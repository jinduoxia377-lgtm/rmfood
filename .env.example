# ═══════════════════════════════════════════════
# RMFOOD 配方平台 - 环境变量配置模板
# ═══════════════════════════════════════════════
#
# 使用说明:
#   1. 复制此文件: cp .env.example .env
#   2. 根据环境修改配置
#   3. 绝对不要将 .env 提交到版本控制！
#
# ⚠️ 安全要求:
#   - 生产环境必须修改所有默认值
#   - SECRET_KEY ≥ 32 位随机字符串
#   - ADMIN_PASSWORD ≥ 12 位，含大小写+数字+特殊字符
#

# ─────────────────────────────────────────────
# 应用基础
# ─────────────────────────────────────────────
APP_NAME=RMFOOD配方设计平台
APP_VERSION=1.0.0
# true=开发模式（自动生成密钥，详细错误） | false=生产模式（严格校验）
DEBUG=true

# ─────────────────────────────────────────────
# 数据库 — PostgreSQL (全环境统一: 开发/测试/生产)
# ─────────────────────────────────────────────
# 开发/测试环境 (本地 PostgreSQL 或 Docker)
DATABASE_URL=postgresql+asyncpg://rmfood:rmfood_dev_2024@localhost:5432/rmfood
# 生产环境 (修改密码和主机)
# DATABASE_URL=postgresql+asyncpg://rmfood:STRONG_PASSWORD@prod-db-host:5432/rmfood
# 生产环境（经 PgBouncer 连接池）
# DATABASE_URL=postgresql+asyncpg://rmfood:STRONG_PASSWORD@pgbouncer:5432/rmfood

# 只读副本数据库（可选，用于读写分离）
# 留空则所有请求使用主库
# DATABASE_READ_REPLICA_URL=postgresql+asyncpg://rmfood:STRONG_PASSWORD@replica-db-host:5432/rmfood

# 连接池配置（仅 PostgreSQL/MySQL 生效）
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_POOL_PRE_PING=true

# ─────────────────────────────────────────────
# 安全（P0 关键！）
# ─────────────────────────────────────────────
# JWT 密钥 — 生产环境必须设置，≥ 32 位
# 开发环境留空会自动生成
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 账号安全（防暴力破解）
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
MAX_LOGIN_ATTEMPTS_PER_IP=10

# ─────────────────────────────────────────────
# 管理员账号
# ─────────────────────────────────────────────
ADMIN_USERNAME=admin
# 生产环境必须设置，≥ 12 位，含大小写+数字+特殊字符
# 开发环境留空会自动生成
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@rmfood.com

# ─────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_HEADERS=Authorization,Content-Type,Accept,X-Request-ID

# ─────────────────────────────────────────────
# AI / LLM 服务
# ─────────────────────────────────────────────
# 提供商: openai | deepseek | zhipu | qwen | custom
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7

# ─────────────────────────────────────────────
# Redis 缓存（可选）
# ─────────────────────────────────────────────
REDIS_URL=
# redis://localhost:6379/0

# ─────────────────────────────────────────────
# Neo4j 图数据库（可选）
# ─────────────────────────────────────────────
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ─────────────────────────────────────────────
# Elasticsearch（可选）
# ─────────────────────────────────────────────
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=

# ─────────────────────────────────────────────
# 任务队列（可选）
# ─────────────────────────────────────────────
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ─────────────────────────────────────────────
# 外部数据源（可选）
# ─────────────────────────────────────────────
TCMSP_API_URL=
TCMSP_API_KEY=
DFBP_API_URL=
DFBP_API_KEY=

# ─────────────────────────────────────────────
# 文件上传
# ─────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ─────────────────────────────────────────────
# 邮件服务（可选）
# ─────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=RMFOOD配方平台
SMTP_USE_TLS=true

# ─────────────────────────────────────────────
# 日志
# ─────────────────────────────────────────────
LOG_LEVEL=INFO
