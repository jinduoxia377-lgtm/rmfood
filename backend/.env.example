# ════════════════════════════════════════════════════════════════
# RMFOOD 应用配置 - 示例文件
# ════════════════════════════════════════════════════════════════
# 使用方法:
# 1. 复制此文件为 .env
# 2. 根据环境填入真实配置
# 3. 不要将 .env 文件提交到版本控制
# ════════════════════════════════════════════════════════════════

# ── 应用基础 ─────────────────────────────────────────────────────
APP_NAME=RMFOOD配方制作平台
APP_VERSION=1.0.0
DEBUG=false

# ── 数据库 ───────────────────────────────────────────────────────
# 开发: sqlite+aiosqlite:///./rmfood.db?charset=utf8mb4
# 生产: postgresql+asyncpg://user:pass@host:5432/dbname?client_encoding=UTF8
# MySQL: mysql+aiomysql://user:pass@host:3306/dbname?charset=utf8mb4
# 注意: 字符集参数已默认添加，确保中文字符正确存储和读取
DATABASE_URL=sqlite+aiosqlite:///./rmfood.db

# ── 安全配置 (必须修改!) ─────────────────────────────────────────
# 生成强密钥命令:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-strong-random-secret-key-min-64-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── 初始管理员账号 ───────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password-in-production
ADMIN_EMAIL=admin@example.com

# ── CORS 配置 ────────────────────────────────────────────────────
CORS_ORIGINS=["https://yourdomain.com","https://app.yourdomain.com"]

# ── AI 智能服务 (LLM 配置) ──────────────────────────────────────
LLM_PROVIDER=deepseek
OPENAI_API_KEY=your-actual-api-key
OPENAI_BASE_URL=
LLM_MODEL=deepseek-chat
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7

# ── 缓存服务 (Redis, 可选) ───────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── 搜索引擎 (Elasticsearch, 可选) ───────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=your-es-api-key

# ── 图数据库 (Neo4j, 可选) ───────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ── 文件上传配置 ─────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ── 日志配置 ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/rmfood.log

# ══════════════════════════════════════
# PepINVERT 配置（可选，用于高级肽设计）
# ══════════════════════════════════════
PEPINVENT_GENERATIVE_MODEL_PATH=./models/pepinvent_generative.pt
PEPINVENT_PREDICTOR_MODEL_PATH=./models/pepinvent_predictor.pt
PEPINVENT_DEVICE=auto  # auto|cuda|cpu
PEPINVENT_TEMPERATURE=1.0
PEPINVENT_TOP_K=50
PEPINVENT_BATCH_SIZE=32
PEPINVENT_LEARNING_RATE=0.0001
PEPINVENT_EPOCHS=10
PEPINVENT_RL_BATCH_SIZE=128
PEPINVENT_TIMEOUT_SECONDS=60
PEPINVENT_ENABLE_CACHE=true
PEPINVENT_CACHE_TTL=3600
