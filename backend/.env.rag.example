# RAG 知识库系统环境变量配置
# 复制此文件为 .env.rag 并根据实际环境修改

# ═══════════════════════════════════════════
# ChromaDB 向量数据库配置
# ═══════════════════════════════════════════
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=rmfooodfp_rag
CHROMA_SSL=false

# ═══════════════════════════════════════════
# Embedding 服务配置
# ═══════════════════════════════════════════
EMBEDDING_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ═══════════════════════════════════════════
# RAG 检索配置
# ═══════════════════════════════════════════
RAG_TOP_K=5
RAG_RRF_SCORE_THRESHOLD=0.0
RAG_USE_RERANKER=true
RAG_RERANKER_MODEL=BAAI/bge-reranker-base
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_MIN_CHUNK_SIZE=100

# ═══════════════════════════════════════════
# PubMed API 配置
# ═══════════════════════════════════════════
PUBMED_API_KEY=
PUBMED_EMAIL=your-email@example.com
PUBMED_MAX_RESULTS=10
PUBMED_CACHE_TTL=3600

# ═══════════════════════════════════════════
# 监控与告警配置
# ═══════════════════════════════════════════
RAG_MONITOR_ENABLED=true
RAG_MONITOR_INTERVAL=30
RAG_MONITOR_HISTORY_SIZE=10000

# 告警阈值
RAG_ALERT_LATENCY_P95=1000
RAG_ALERT_ERROR_RATE=5
RAG_ALERT_RECALL_MIN=0.5

# ═══════════════════════════════════════════
# 限流配置
# ═══════════════════════════════════════════
RAG_RATE_LIMIT_ENABLED=true
RAG_RATE_LIMIT_CAPACITY=100
RAG_RATE_LIMIT_REFILL_RATE=10.0
RAG_RATE_LIMIT_WINDOW=60

# ═══════════════════════════════════════════
# 增量索引配置
# ═══════════════════════════════════════════
RAG_INCREMENTAL_INDEX_ENABLED=false
RAG_INCREMENTAL_INDEX_DIR=./documents
RAG_INCREMENTAL_INDEX_INTERVAL=300

# ═══════════════════════════════════════════
# 日志配置
# ═══════════════════════════════════════════
RAG_LOG_LEVEL=INFO
RAG_LOG_FILE=./logs/rag.log
RAG_LOG_ROTATE=10485760  # 10MB

# ═══════════════════════════════════════════
# 性能优化配置
# ═══════════════════════════════════════════
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL=3600
RAG_CACHE_MAX_SIZE=1000

RAG_EMBEDDING_BATCH_SIZE=32
RAG_EMBEDDING_CONCURRENT=5

# ═══════════════════════════════════════════
# 测试配置（仅开发环境）
# ═══════════════════════════════════════════
RAG_TEST_MODE=false
RAG_SEED_DATA=true