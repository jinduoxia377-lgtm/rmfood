# ============================================================
# RMFOOD 后端生产环境配置模板
#
# 使用方法:
#   1. 复制此文件: cp .env.production.example .env.production
#   2. 修改下面的值为你的实际配置
#   3. 运行: docker run --env-file .env.production ...
#
# ⚠️ 安全提醒:
#   - 绝对不要将此文件提交到 Git！
#   - SECRET_KEY 和 ADMIN_PASSWORD 必须使用强随机值！
# ============================================================

# ── 应用基础 ──
APP_NAME=RMFOOD配方设计平台
APP_VERSION=1.0.0

# ⚠️ 开发模式必须设为 false（生产环境）
DEBUG=false

# ── 数据库（生产环境推荐 PostgreSQL） ──
# SQLite (开发/测试):
# DATABASE_URL=sqlite+aiosqlite:///./rmfood.db

# PostgreSQL (生产环境推荐):
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/rmfood

# ── 安全（P0修复：必须设置！） ──
# ✅ 生成方法: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<在此处粘贴生成的48位随机密钥>

# JWT 算法 (保持 HS256)
JWT_ALGORITHM=HS256

# Token 过期时间
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS 配置 ──
# 允许的前端域名（用逗号分隔多个域名）
CORS_ORIGINS=https://your-domain.com,https://app.your-domain.com
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_HEADERS=Authorization,Content-Type,Accept,X-Request-ID

# ── 初始管理员（P0修复：必须设置强密码！） ──
ADMIN_USERNAME=admin
# ✅ 密码要求：≥12位，包含大小写字母、数字和特殊字符
ADMIN_PASSWORD=<在此处设置强管理员密码>
ADMIN_EMAIL=admin@your-domain.com

# ── 文件上传 ──
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.gif,.svg,.csv,.json,.zip,.rar

# ═══════════════════════════════════
# Phase 2: AI 推理引擎 (LLM)
# ═══════════════════════════════════
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
VLLM_ENDPOINT=
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7

# ═══════════════════════════════════
# Phase 2: 图数据库 (Neo4j) [可选]
# ═══════════════════════════════════
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ═══════════════════════════════════
# Phase 2: 搜索引擎 (ElasticSearch) [可选]
# ═══════════════════════════════════
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=

# ═════════════════════════════════
# Phase 2: 缓存 (Redis) [生产环境强烈推荐]
# ═══════════════════════════════════
REDIS_URL=redis://localhost:6379/0

# ═══════════════════════════════════
# Phase 2: 任务队列 (Celery) [可选]
# ═══════════════════════════════════
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=

# ═════════════════════════════════
# Phase 2: 外部数据源 [可选]
# ═══════════════════════════════════
TCMSP_API_URL=
TCMSP_API_KEY=
DFBP_API_URL=
DFBP_API_KEY=
