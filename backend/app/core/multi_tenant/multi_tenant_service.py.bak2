"""

浼佷笟绾у绉熸埛组织管理绯荤粺



鍔熻兘:

- 组织 (Organization) 创建涓庣鐞?- 鍥㈤槦 (Team) 涓庢垚鍛樼鐞?- 瑙掕壊权限鐭╅樀 (RBAC)

- 璧勬簮閰嶉管理 (Quotas)

- 组织璁剧疆涓庤璐?- 鏁版嵁闅旂涓庡畨鍏?"""



import json

import logging

import re

import uuid

from dataclasses import dataclass, field

from datetime import datetime, timezone

from enum import Enum

from typing import Any, Dict, List, Optional, Set



from sqlalchemy import text





logger = logging.getLogger(__name__)





# ============================================================

# Enums & Models

# ============================================================



class OrganizationRole(str, Enum):

    """组织瑙掕壊"""

    OWNER = "owner"

    ADMIN = "admin"

    MEMBER = "member"

    GUEST = "guest"





class OrganizationPlan(str, Enum):

    """订阅计划"""

    FREE = "free"

    PRO = "pro"

    ENTERPRISE = "enterprise"





class ResourceType(str, Enum):

    """璧勬簮绫诲瀷"""

    FORMULAS = "formulas"

    EXPERIMENTS = "experiments"

    STORAGE = "storage"

    API_CALLS = "api_calls"

    AI_GENERATIONS = "ai_generations"

    MEMBERS = "members"

    TEAMS = "teams"





@dataclass

class Organization:

    """组织"""

    id: int

    name: str

    slug: str

    description: Optional[str] = None

    logo_url: Optional[str] = None

    owner_id: int = 0

    plan: OrganizationPlan = OrganizationPlan.FREE

    settings: Dict[str, Any] = field(default_factory=dict)

    created_at: datetime = field(default_factory=lambda: datetime.now(timezone.utc))

    updated_at: datetime = field(default_factory=lambda: datetime.now(timezone.utc))

    is_active: bool = True





@dataclass

class Team:

    """鍥㈤槦"""

    id: int

    organization_id: int

    name: str

    description: Optional[str] = None

    lead_id: Optional[int] = None

    members: List[int] = field(default_factory=list)

    permissions: Dict[str, Any] = field(default_factory=dict)

    created_at: datetime = field(default_factory=lambda: datetime.now(timezone.utc))





@dataclass

class OrganizationMember:

    """组织成员"""

    user_id: int

    organization_id: int

    role: OrganizationRole = OrganizationRole.MEMBER

    team_ids: List[int] = field(default_factory=list)

    joined_at: datetime = field(default_factory=lambda: datetime.now(timezone.utc))

    invited_by: Optional[int] = None





@dataclass

class QuotaUsage:

    """閰嶉浣跨敤鎯呭喌"""

    resource_type: ResourceType

    used: float

    limit: float

    unit: str = ""

    reset_date: Optional[datetime] = None



    @property

    def percentage(self) -> float:

        if self.limit == 0:

            return 0

        return round((self.used / self.limit) * 100, 2)



    @property

    def is_exceeded(self) -> bool:

        return self.used >= self.limit



    @property

    def remaining(self) -> float:

        return max(0, self.limit - self.used)





@dataclass

class PlanLimits:

    """计划闄愬埗"""

    plan: OrganizationPlan

    max_members: int

    max_teams: int

    max_formulas: int

    storage_mb: int

    api_calls_per_day: int

    ai_generations_per_day: int

    features: List[str]





PLAN_LIMITS: Dict[OrganizationPlan, PlanLimits] = {

    OrganizationPlan.FREE: PlanLimits(

        plan=OrganizationPlan.FREE,

        max_members=5,

        max_teams=1,

        max_formulas=50,

        storage_mb=500,

        api_calls_per_day=100,

        ai_generations_per_day=10,

        features=["鍩虹閰嶆柟管理", "鍥㈤槦鍗忎綔", "鏁版嵁瀵煎嚭"],

    ),

    OrganizationPlan.PRO: PlanLimits(

        plan=OrganizationPlan.PRO,

        max_members=50,

        max_teams=10,

        max_formulas=1000,

        storage_mb=10240,

        api_calls_per_day=10000,

        ai_generations_per_day=200,

        features=["全部FREE功能", "高级分析报表", "API访问", "优先支持", "自定义品牌"],

    ),

    OrganizationPlan.ENTERPRISE: PlanLimits(

        plan=OrganizationPlan.ENTERPRISE,

        max_members=-1,

        max_teams=-1,

        max_formulas=-1,

        storage_mb=-1,

        api_calls_per_day=-1,

        ai_generations_per_day=-1,

        features=["全部PRO功能", "无限资源", "专属客户经理", "SLA保障", "私有部署", "SSO集成"],

    ),

}





# ============================================================

# Organization Service

# ============================================================



class OrganizationService:

    """

    澶氱鎴风粍缁囩鐞嗘湇鍔?    

    Features:

    - 组织CRUD鎿嶄綔

    - 成员閭€璇蜂笌管理

    - 鍥㈤槦创建涓庢潈闄愬垎閰?    - 閰嶉鐩戞帶涓庨璀?    - 计划鍗囩骇/闄嶇骇

    """



    def __init__(self, db):

        self.db = db



    async def create_organization(

        self,

        owner_id: int,

        name: str,

        slug: Optional[str] = None,

        **kwargs

    ) -> Organization:

        """

        创建鏂扮粍缁?        

        Args:

            owner_id: 创建鑰咃紙灏嗘垚涓篛WNER锛?            name: 组织鍚嶇О

            slug: URL鏍囪瘑绗︼紙鍙€夛紝鑷姩鐢熸垚锛?            

        Returns:

            创建鐨凮rganization瀵硅薄

        """

        final_slug = slug or self._generate_slug(name)



        if await self._slug_exists(final_slug):

            raise ValueError(f"组织标识 '"+ final_slug + "' 已存在")



        org = Organization(

            id=0,

            name=name,

            slug=final_slug,

            owner_id=owner_id,

            settings={

                "allow_invitation": True,

                "require_approval": False,

                "default_role": "member",

                **kwargs.get("settings", {}),

            },

        )



        result = await self.db.execute(

            text("""INSERT INTO organizations

               (name, slug, description, owner_id, plan, settings, is_active, created_at, updated_at)

               VALUES (:name, :slug, :description, :owner_id, :plan, :settings::jsonb, :is_active, NOW(), NOW())

               RETURNING id"""),

            {

                "name": org.name,

                "slug": org.slug,

                "description": org.description,

                "owner_id": org.owner_id,

                "plan": org.plan.value,

                "settings": json.dumps(org.settings),

                "is_active": org.is_active,

            },

        )

        

        row = result.fetchone()

        org.id = row.id



        await self.add_member(org.id, owner_id, OrganizationRole.OWNER, invited_by=owner_id)



        logger.info(f"馃彚锔?创建组织: {name} (slug={final_slug}, owner={owner_id})")

        

        return org



    async def get_organization(self, organization_id: int) -> Optional[Organization]:

        """获取组织璇︽儏"""

        result = await self.db.execute(

            text("SELECT * FROM organizations WHERE id = :id AND is_active = TRUE"),

            {"id": organization_id},

        )

        row = result.fetchone()

        

        if not row:

            return None

        

        return Organization(

            id=row.id,

            name=row.name,

            slug=row.slug,

            description=row.description,

            logo_url=row.logo_url,

            owner_id=row.owner_id,

            plan=OrganizationPlan(row.plan),

            settings=json.loads(row.settings) if row.settings else {},

            created_at=row.created_at,

            updated_at=row.updated_at,

            is_active=row.is_active,

        )



    async def get_organization_by_slug(self, slug: str) -> Optional[Organization]:

        """閫氳繃slug获取组织"""

        result = await self.db.execute(

            text("SELECT * FROM organizations WHERE slug = :slug AND is_active = TRUE"),

            {"slug": slug},

        )

        row = result.fetchone()

        

        if not row:

            return None

        

        return Organization(

            id=row.id,

            name=row.name,

            slug=row.slug,

            description=row.description,

            logo_url=row.logo_url,

            owner_id=row.owner_id,

            plan=OrganizationPlan(row.plan),

            settings=json.loads(row.settings) if row.settings else {},

            created_at=row.created_at,

            updated_at=row.updated_at,

            is_active=row.is_active,

        )



    async def update_organization(

        self,

        organization_id: int,

        updater_id: int,

        **updates

    ) -> Organization:

        """更新组织淇℃伅"""

        if not await self._check_permission(organization_id, updater_id, [OrganizationRole.OWNER, OrganizationRole.ADMIN]):

            raise PermissionError(无权修改此组织)



        allowed_fields = ["name", "description", "logo_url", "settings"]

        set_clauses = []

        params = {"id": organization_id}

        

        for key, value in updates.items():

            if key in allowed_fields:

                if key == "settings":

                    set_clauses.append(f"{key} = :{key}::jsonb")

                    params[key] = json.dumps(value)

                else:

                    set_clauses.append(f"{key} = :{key}")

                    params[key] = value



        if set_clauses:

            set_clauses.append("updated_at = NOW()")

            

            await self.db.execute(

                text(f"UPDATE organizations SET {', '.join(set_clauses)} WHERE id = :id"),

                params,

            )

            await self.db.commit()



        return await self.get_organization(organization_id)



    async def delete_organization(self, organization_id: int, deleter_id: int) -> bool:

        """删除组织锛堜粎OWNER锛?""

        if not await self._check_permission(organization_id, deleter_id, [OrganizationRole.OWNER]):

            raise PermissionError("仅组织拥有者可ɾ����֯")



        await self.db.execute(

            text("UPDATE organizations SET is_active = FALSE, updated_at = NOW() WHERE id = :id"),

            {"id": organization_id},

        )

        await self.db.commit()



        logger.info(f"馃棏锔?组织宸插垹闄? organization_id={organization_id}")

        

        return True



    # ============================================================

    # Member Management

    # ============================================================



    async def add_member(

        self,

        organization_id: int,

        user_id: int,

        role: OrganizationRole = OrganizationRole.MEMBER,

        *,

        invited_by: Optional[int] = None,

        team_ids: Optional[List[int]] = None,

    ) -> OrganizationMember:

        """

        娣诲姞组织成员

        

        Args:

            organization_id: 组织ID

            user_id: 鐢ㄦ埛ID

            role: 瑙掕壊

        invited_by: 邀请人ID

            team_ids: 鍒濆鍥㈤槦鍒楄〃

            

        Returns:

            OrganizationMember瀵硅薄

        """

        existing = await self._get_membership(organization_id, user_id)

        if existing:

            raise ValueError(f"鐢ㄦ埛宸叉槸璇ョ粍缁囨垚鍛?)



        limits = PLAN_LIMITS[(await self.get_organization(organization_id)).plan]

        member_count = await self._count_members(organization_id)

        

        if limits.max_members > 0 and member_count >= limits.max_members:

            raise ValueError(f"宸茶揪成员涓婇檺 ({limits.max_members})")



        member = OrganizationMember(

            user_id=user_id,

            organization_id=organization_id,

            role=role,

            team_ids=team_ids or [],

            invited_by=invited_by,

        )



        await self.db.execute(

            text("""INSERT INTO organization_members (user_id, organization_id, role, team_ids, joined_at, invited_by)

               VALUES (:user_id, :organization_id, :role, :team_ids::int[], NOW(), :invited_by)"""),

            {

                "user_id": member.user_id,

                "organization_id": member.organization_id,

                "role": member.role.value,

                "team_ids": member.team_ids,

                "invited_by": member.invited_by,

            },

        )

        await self.db.commit()



        logger.info(f"馃懃 娣诲姞成员: user={user_id} 鈫?org={organization_id} as {role.value}")

        

        return member



    async def remove_member(self, organization_id: int, user_id: int, remover_id: int) -> bool:

        """绉婚櫎组织成员"""

        if user_id == remover_id:

            if not await self._check_permission(organization_id, remover_id, [OrganizationRole.OWNER]):

                raise PermissionError("组织鎷ユ湁鑰呮棤娉曢€€鍑?)

        else:

            if not await self._check_permission(organization_id, remover_id, [OrganizationRole.OWNER, OrganizationRole.ADMIN]):

                raise PermissionError("��Ȩ移除��Ա")



        await self.db.execute(

            text("DELETE FROM organization_members WHERE organization_id = :organization_id AND user_id = :user_id"),

            {"organization_id": organization_id, "user_id": user_id},

        )

        await self.db.commit()



        logger.info(f"馃毇 绉婚櫎成员: user={user_id} from org={organization_id}")

        

        return True



    async def change_role(

        self,

        organization_id: int,

        target_user_id: int,

        new_role: OrganizationRole,

        changer_id: int,

    ) -> bool:

        """淇敼成员瑙掕壊"""

        if not await self._check_permission(organization_id, changer_id, [OrganizationRole.OWNER, OrganizationRole.ADMIN]):

            raise PermissionError("��Ȩ修改角色")



        if new_role == OrganizationRole.OWNER and not await self._check_permission(organization_id, changer_id, [OrganizationRole.OWNER]):

            raise PermissionError("仅拥有者可转让OWNER角色")



        await self.db.execute(

            text("UPDATE organization_members SET role = :role WHERE organization_id = :organization_id AND user_id = :user_id"),

            {"role": new_role.value, "organization_id": organization_id, "user_id": target_user_id},

        )

        await self.db.commit()



        logger.info(f"馃攧 瑙掕壊鍙樻洿: user={target_user_id} 鈫?{new_role.value} in org={organization_id}")

        

        return True



    async def get_members(self, organization_id: int) -> List[Dict[str, Any]]:

        """获取组织鎵€鏈夋垚鍛?""

        result = await self.db.execute(

            text("""SELECT m.user_id, m.role, m.joined_at, m.invited_id,

                      u.username, u.email, u.avatar_url

               FROM organization_members m

               JOIN users u ON m.user_id = u.id

               WHERE m.organization_id = :organization_id

               ORDER BY m.joined_at ASC"""),

            {"organization_id": organization_id},

        )

        

        return [dict(row._mapping) for row in result.fetchall()]



    # ============================================================

    # Team Management

    # ============================================================



    async def create_team(

        self,

        organization_id: int,

        name: str,

        creator_id: int,

        description: Optional[str] = None,

    ) -> Team:

        """创建鍥㈤槦"""

        if not await self._check_permission(organization_id, creator_id, [OrganizationRole.OWNER, OrganizationRole.ADMIN]):

            raise PermissionError("��Ȩ����团队")



        org = await self.get_organization(organization_id)

        limits = PLAN_LIMITS[org.plan]

        team_count = await self._count_teams(organization_id)

        

        if limits.max_teams > 0 and team_count >= limits.max_teams:

            raise ValueError(f"宸茶揪鍥㈤槦涓婇檺 ({limits.max_teams})")



        result = await self.db.execute(

            text("""INSERT INTO teams (organization_id, name, description, lead_id, permissions, created_at)

               VALUES (:organization_id, :name, :description, :lead_id, '{}'::jsonb, NOW())

               RETURNING id"""),

            {"organization_id": organization_id, "name": name, "description": description, "lead_id": creator_id},

        )

        

        row = result.fetchone()

        team = Team(id=row.id, organization_id=organization_id, name=name, description=description, lead_id=creator_id)



        logger.info(f"馃懃 创建鍥㈤槦: {name} in org={organization_id}")

        

        return team



    async def get_teams(self, organization_id: int) -> List[Team]:

        """获取组织鐨勬墍鏈夊洟闃?""

        result = await self.db.execute(

            text("SELECT * FROM teams WHERE organization_id = :organization_id ORDER BY name ASC"),

            {"organization_id": organization_id},

        )

        

        teams = []

        for row in result.fetchall():

            teams.append(Team(

                id=row.id,

                organization_id=row.organization_id,

                name=row.name,

                description=row.description,

                lead_id=row.lead_id,

                permissions=json.loads(row.permissions) if row.permissions else {},

                created_at=row.created_at,

            ))

        

        return teams



    async def add_team_member(self, team_id: int, user_id: int, adder_id: int) -> bool:

        """娣诲姞鍥㈤槦成员"""

        team = await self._get_team(team_id)

        if not team:

            raise ValueError("鍥㈤槦涓嶅瓨鍦?)



        if not await self._check_permission(team.organization_id, adder_id, [OrganizationRole.OWNER, OrganizationRole.ADMIN, OrganizationRole.MEMBER]):

            if team.lead_id != adder_id:

                raise PermissionError("��Ȩ添加团队��Ա")



        await self.db.execute(

            text("""UPDATE organization_members

               SET team_ids = array_append(team_ids, :team_id)

               WHERE user_id = :user_id AND organization_id = :organization_id"""),

            {"team_id": team_id, "user_id": user_id, "organization_id": team.organization_id},

        )

        await self.db.commit()



        return True



    # ============================================================

    # Quota Management

    # ============================================================



    async def get_quota_usage(self, organization_id: int) -> Dict[str, QuotaUsage]:

        """获取组织鐨勯厤棰濅娇鐢ㄦ儏鍐?""

        org = await self.get_organization(organization_id)

        if not org:

            raise ValueError("组织涓嶅瓨鍦?)



        limits = PLAN_LIMITS[org.plan]

        quotas = {}



        formulas_count = await self._count_resource(organization_id, "formulas")

        quotas["formulas"] = QuotaUsage(

            resource_type=ResourceType.FORMULAS,

            used=formulas_count,

            limit=float(limits.max_formulas),

            unit="涓?,

        )



        experiments_count = await self._count_resource(organization_id, "experiments")

        quotas["experiments"] = QuotaUsage(

            resource_type=ResourceType.EXPERIMENTS,

            used=experiments_count,

            limit=float(limits.max_formulas) * 2,

            unit="涓?,

        )



        storage_used_mb = await self._get_storage_usage(organization_id)

        quotas["storage"] = QuotaUsage(

            resource_type=ResourceType.STORAGE,

            used=storage_used_mb,

            limit=float(limits.storage_mb),

            unit="MB",

        )



        member_count = await self._count_members(organization_id)

        quotas["members"] = QuotaUsage(

            resource_type=ResourceType.MEMBERS,

            used=float(member_count),

            limit=float(limits.max_members),

            unit="浜?,

        )



        team_count = await self._count_teams(organization_id)

        quotas["teams"] = QuotaUsage(

            resource_type=ResourceType.TEAMS,

            used=float(team_count),

            limit=float(limits.max_teams),

            unit="涓?,

        )



        api_calls_today = await self._count_api_calls_today(organization_id)

        quotas["api_calls"] = QuotaUsage(

            resource_type=ResourceType.API_CALLS,

            used=float(api_calls_today),

            limit=float(limits.api_calls_per_day),

            unit="娆?,

            reset_date=datetime.now(timezone.utc).replace(hour=23, minute=59, second=59),

        )



        ai_gen_today = await self._count_ai_generations_today(organization_id)

        quotas["ai_generations"] = QuotaUsage(

            resource_type=ResourceType.AI_GENERATIONS,

            used=float(ai_gen_today),

            limit=float(limits.ai_generations_per_day),

            unit="娆?,

            reset_date=datetime.now(timezone.utc).replace(hour=23, minute=59, second=59),

        )



        return quotas



    async def check_quota(self, organization_id: int, resource: ResourceType, amount: float = 1) -> bool:

        """妫€鏌ユ槸鍚︽湁瓒冲閰嶉"""

        quotas = await self.get_quota_usage(organization_id)

        quota = quotas.get(resource.value)

        

        if not quota:

            return True

        

        return (quota.used + amount) <= quota.limit



    # ============================================================

    # Helper Methods

    # ============================================================



    def _generate_slug(self, name: str) -> str:

        """浠庡悕绉扮敓鎴怳RL鍙嬪ソ鐨剆lug"""

        base = re.sub(r'[^\w\u4e00-\u9fff-]', '', name.lower().replace(' ', '-'))

        suffix = uuid.uuid4().hex[:6]

        return f"{base}-{suffix}"



    async def _slug_exists(self, slug: str) -> bool:

        """妫€鏌lug鏄惁已存在""

        result = await self.db.execute(

            text("SELECT COUNT(*) FROM organizations WHERE slug = :slug"),

            {"slug": slug},

        )

        return (result.scalar() or 0) > 0



    async def _get_membership(self, organization_id: int, user_id: int) -> Optional[Dict]:

        """获取成员鍏崇郴"""

        result = await self.db.execute(

            text("SELECT * FROM organization_members WHERE organization_id = :organization_id AND user_id = :user_id"),

            {"organization_id": organization_id, "user_id": user_id},

        )

        row = result.fetchone()

        return dict(row._mapping) if row else None



    async def _check_permission(self, organization_id: int, user_id: int, required_roles: List[OrganizationRole]) -> bool:

        """妫€鏌ョ敤鎴峰湪组织涓殑权限"""

        membership = await self._get_membership(organization_id, user_id)

        if not membership:

            return False

        

        role_hierarchy = {

            OrganizationRole.GUEST: 0,

            OrganizationRole.MEMBER: 1,

            OrganizationRole.ADMIN: 2,

            OrganizationRole.OWNER: 3,

        }

        

        user_level = role_hierarchy.get(OrganizationRole(membership["role"]), 0)

        min_required = max(role_hierarchy.get(r, 0) for r in required_roles)

        

        return user_level >= min_required



    async def _count_members(self, organization_id: int) -> int:

        """缁熻成员鏁?""

        result = await self.db.execute(

            text("SELECT COUNT(*) FROM organization_members WHERE organization_id = :organization_id"),

            {"organization_id": organization_id},

        )

        return result.scalar() or 0



    async def _count_teams(self, organization_id: int) -> int:

        """缁熻鍥㈤槦鏁?""

        result = await self.db.execute(

            text("SELECT COUNT(*) FROM teams WHERE organization_id = :organization_id"),

            {"organization_id": organization_id},

        )

        return result.scalar() or 0



    async def _count_resource(self, organization_id: int, table: str) -> int:

        """缁熻璧勬簮鏁伴噺"""

        result = await self.db.execute(

            f"SELECT COUNT(*) FROM {table} WHERE organization_id = :organization_id",

            {"organization_id": organization_id},

        )

        return result.scalar() or 0



    async def _get_storage_usage(self, organization_id: int) -> float:

        """获取瀛樺偍浣跨敤閲?MB)"""

        result = await self.db.execute(

            text("SELECT COALESCE(SUM(file_size), 0) FROM files WHERE organization_id = :organization_id"),

            {"organization_id": organization_id},

        )

        bytes_total = result.scalar() or 0

        return round(bytes_total / 1024 / 1024, 2)



    async def _count_api_calls_today(self, organization_id: int) -> int:

        """缁熻浠婃棩API璋冪敤娆℃暟"""

        result = await self.db.execute(

            text("""SELECT COUNT(*) FROM api_logs

               WHERE organization_id = :organization_id

               AND created_at >= CURRENT_DATE"""),

            {"organization_id": organization_id},

        )

        return result.scalar() or 0



    async def _count_ai_generations_today(self, organization_id: int) -> int:

        """缁熻浠婃棩AI鐢熸垚娆℃暟"""

        result = await self.db.execute(

            text("""SELECT COUNT(*) FROM ai_generations

               WHERE organization_id = :organization_id

               AND created_at >= CURRENT_DATE"""),

            {"organization_id": organization_id},

        )

        return result.scalar() or 0



    async def _get_team(self, team_id: int) -> Optional[Team]:

        """获取鍥㈤槦璇︽儏"""

        result = await self.db.execute(

            text("SELECT * FROM teams WHERE id = :id"),

            {"id": team_id},

        )

        row = result.fetchone()

        

        if not row:

            return None

        

        return Team(

            id=row.id,

            organization_id=row.organization_id,

            name=row.name,

            description=row.description,

            lead_id=row.lead_id,

            permissions=json.loads(row.permissions) if row.permissions else {},

            created_at=row.created_at,

        )





# ============================================================

# 新增方法：数据分析和高级功能

# ============================================================



    async def archive_organization(self, organization_id: int, actor_id: int) -> bool:

        """归档组织（软删除，保留数据用于恢复）"""

        if not await self._check_permission(organization_id, actor_id, [OrganizationRole.OWNER]):

            raise PermissionError("����֯ӵ���߿ɹ鵵��֯")

        

        org = await self.get_organization(organization_id)

        if not org:

            raise ValueError("��֯������")

        

        await self.db.execute(

            text("UPDATE organizations SET is_active = FALSE, archived_at = NOW() WHERE id = :id"),

            {"id": organization_id},

        )

        await self.db.commit()

        

        logger.info(f"📦 组织已归档: organization_id={organization_id} by={actor_id}")

        return True



    async def restore_organization(self, organization_id: int, actor_id: int) -> bool:

        """恢复已归档的组织"""

        if not await self._check_permission(organization_id, actor_id, [OrganizationRole.OWNER]):

            raise PermissionError("����֯ӵ���߿ɻָ���֯")

        

        await self.db.execute(

            text("UPDATE organizations SET is_active = TRUE, archived_at = NULL WHERE id = :id"),

            {"id": organization_id},

        )

        await self.db.commit()

        

        logger.info(f"♻️ 组织已恢复: organization_id={organization_id}")

        return True



    async def clone_organization(self, source_org_id: int, actor_id: int, new_name: str) -> int:

        """克隆组织（复制基本信息，不复制成员和数据）"""

        source_org = await self.get_organization(source_org_id)

        if not source_org:

            raise ValueError("Դ��֯������")

        

        if not await self._check_permission(source_org_id, actor_id, [OrganizationRole.OWNER]):

            raise PermissionError("����֯ӵ���߿ɿ�¡��֯")

        

        # 创建新组织

        new_slug = self._generate_slug(new_name)

        while await self._slug_exists(new_slug):

            new_slug = self._generate_slug(new_name)

        

        result = await self.db.execute(

            text("""INSERT INTO organizations

                   (name, slug, description, owner_id, plan, settings, is_active, created_at, updated_at)

                   VALUES (:name, :slug, :description, :owner_id, :plan, :settings, TRUE, NOW(), NOW())

                   RETURNING id"""),

            {

                "name": new_name,

                "slug": new_slug,

                "description": source_org.description,

                "owner_id": actor_id,

                "plan": source_org.plan.value,

                "settings": json.dumps(source_org.settings),

            },

        )

        new_org_id = result.fetchone().id

        

        # 将当前用户添加为新组织的OWNER

        await self.add_member(new_org_id, actor_id, OrganizationRole.OWNER, invited_by=actor_id)

        

        logger.info(f"📋 组织已克隆: {source_org.name} → {new_name} (id={new_org_id})")

        return new_org_id



    async def suspend_member(self, organization_id: int, user_id: int, actor_id: int) -> bool:

        """停用成员（保留记录但禁止访问）"""

        if not await self._check_permission(organization_id, actor_id, [OrganizationRole.OWNER, OrganizationRole.ADMIN]):

            raise PermissionError("Ȩ�޲���")

        

        membership = await self._get_membership(organization_id, user_id)

        if not membership:

            raise ValueError("��Ա������")

        

        await self.db.execute(

            text("UPDATE organization_members SET is_active = FALSE WHERE organization_id = :org_id AND user_id = :user_id"),

            {"org_id": organization_id, "user_id": user_id},

        )

        await self.db.commit()

        

        logger.info(f"🚫 成员已停用: user={user_id} from org={organization_id}")

        return True



    async def resume_member(self, organization_id: int, user_id: int, actor_id: int) -> bool:

        """恢复成员（重新激活）"""

        if not await self._check_permission(organization_id, actor_id, [OrganizationRole.OWNER, OrganizationRole.ADMIN]):

            raise PermissionError("Ȩ�޲���")

        

        await self.db.execute(

            text("UPDATE organization_members SET is_active = TRUE WHERE organization_id = :org_id AND user_id = :user_id"),

            {"org_id": organization_id, "user_id": user_id},

        )

        await self.db.commit()

        

        logger.info(f"✅ 成员已恢复: user={user_id} in org={organization_id}")

        return True



    async def get_analytics(self, organization_id: int, time_range: str = "30d") -> Dict[str, Any]:

        """获取组织数据分析"""

        org = await self.get_organization(organization_id)

        if not org:

            raise ValueError("��֯������")

        

        days_map = {"7d": 7, "30d": 30, "90d": 90}

        days = days_map.get(time_range, 30)

        start_date = datetime.now(timezone.utc) - timedelta(days=days)

        

        # 基本统计

        member_count = await self._count_members(organization_id)

        team_count = await self._count_teams(organization_id)

        storage_mb = await self._get_storage_usage(organization_id)

        

        # API调用统计

        result = await self.db.execute(

            text("""SELECT COUNT(*) as total_calls,

                          COALESCE(AVG(response_time_ms), 0) as avg_response_time,

                          COALESCE(SUM(CASE WHEN status_code >= 400 THEN 1 ELSE 0 END), 0) as error_count

                   FROM api_logs

                   WHERE organization_id = :org_id AND created_at >= :start_date"""),

            {"org_id": organization_id, "start_date": start_date},

        )

        row = result.fetchone()

        api_stats = {

            "total_calls": row.total_calls or 0,

            "avg_response_time": row.avg_response_time or 0,

            "error_rate": round((row.error_count or 0) / max(row.total_calls or 1, 1) * 100, 2),

        }

        

        # 成员增长趋势

        trend_result = await self.db.execute(

            text("""SELECT DATE(joined_at) as date, COUNT(*) as count

                   FROM organization_members

                   WHERE organization_id = :org_id AND joined_at >= :start_date

                   GROUP BY DATE(joined_at)

                   ORDER BY date ASC"""),

            {"org_id": organization_id, "start_date": start_date},

        )

        member_trend = [{"date": r.date.isoformat(), "count": r.count} for r in trend_result.fetchall()]

        

        # 资源使用历史

        usage_result = await self.db.execute(

            text("""SELECT DATE(created_at) as date,

                          SUM(file_size) / 1024 / 1024 as storage_mb

                   FROM files

                   WHERE organization_id = :org_id AND created_at >= :start_date

                   GROUP BY DATE(created_at)

                   ORDER BY date ASC"""),

            {"org_id": organization_id, "start_date": start_date},

        )

        storage_trend = [{"date": r.date.isoformat(), "storage_mb": round(r.storage_mb or 0, 2)} 

                         for r in usage_result.fetchall()]

        

        return {

            "total_members": member_count,

            "total_teams": team_count,

            "storage_used_mb": round(storage_mb, 2),

            "api_stats": api_stats,

            "member_trend": member_trend,

            "storage_trend": storage_trend,

            "time_range": time_range,

        }



    async def get_audit_log(self, organization_id: int, limit: int = 50, offset: int = 0) -> Dict[str, Any]:

        """获取组织审计日志"""

        result = await self.db.execute(

            text("""SELECT a.*, u.username as actor_name, u.email as actor_email

                   FROM audit_logs a

                   LEFT JOIN users u ON a.actor_id = u.id

                   WHERE a.organization_id = :org_id

                   ORDER BY a.created_at DESC

                   LIMIT :limit OFFSET :offset"""),

            {"org_id": organization_id, "limit": limit, "offset": offset},

        )

        logs = [dict(row._mapping) for row in result.fetchall()]

        

        count_result = await self.db.execute(

            text("SELECT COUNT(*) FROM audit_logs WHERE organization_id = :org_id"),

            {"org_id": organization_id},

        )

        total = count_result.scalar() or 0

        

        return {

            "logs": logs,

            "total": total,

            "limit": limit,

            "offset": offset,

        }



    async def export_organization(self, organization_id: int, format_type: str = "json") -> Dict[str, Any]:

        """导出组织数据"""

        org = await self.get_organization(organization_id)

        if not org:

            raise ValueError("��֯������")

        

        members = await self.get_members(organization_id)

        teams = await self.get_teams(organization_id)

        quotas = await self.get_quota_usage(organization_id)

        

        export_data = {

            "organization": {

                "id": org.id,

                "name": org.name,

                "slug": org.slug,

                "description": org.description,

                "plan": org.plan.value,

                "settings": org.settings,

                "created_at": org.created_at.isoformat(),

                "updated_at": org.updated_at.isoformat(),

            },

            "members": members,

            "teams": [t.__dict__ for t in teams],

            "quotas": {k: v.__dict__ for k, v in quotas.items()},

            "exported_at": datetime.now(timezone.utc).isoformat(),

        }

        

        return {

            "format": format_type,

            "data": export_data,

            "size_bytes": len(json.dumps(export_data).encode('utf-8')),

        }



def get_org_service(db) -> OrganizationService:

    """获取组织鏈嶅姟瀹炰緥"""

    return OrganizationService(db)





