# ═══════════════════════════════════════════════
# RMFOOD Docker 构建排除文件
# ═══════════════════════════════════════════════

# Git
.git
.gitignore

# Python
__pycache__
*.pyc
*.pyo
*.egg-info
.eggs
dist
build
*.egg
.mypy_cache
.pytest_cache
.ruff_cache

# 虚拟环境（后端）
backend/.venv
backend/venv
backend/venv/

# IDE
.vscode
.idea
*.swp
*.swo

# 测试（不需要打包到生产镜像）
backend/tests
backend/tests-reports
**/test_*.py
**/test_*.ts
**/tests/
coverage/
htmlcov/
.coverage
*.xml

# 文档
docs/
*.md
!README.md

# 环境文件
.env
.env.*
!.env.example

# 临时文件
backend/tmp/
backend/temp_files/
*.tmp
*.bak

# 前端构建产物（由 Dockerfile.frontend 单独构建）
frontend/node_modules
frontend/dist
frontend/build
frontend/.vite-cache
frontend/tsconfig.tsbuildinfo

# 数据文件
backend/data/
backend/uploads/
backend/pg_data/
*.db
*.sqlite

# 报告文件
backend/*.report.*
backend/*_REPORT.*
backend/*report.*
backend/*.json
backend/*.txt
backend/*.log

# 部署文档（不需要打包到镜像）
DEPLOYMENT_*.md
LAN_*.md
PRODUCTION_*.md
NETWORK_*.md
QUICK_START.md
FINAL_CLOSURE_REPORT.md

# 调试截图
debug_*.png
*.png
*.jpg
*.jpeg
*.gif

# 脚本（不需要打包到镜像）
scripts/
run_backend.py
run_backend_simple.py
start-lan.bat
stop-lan.bat
start_backend.bat
backend/start*.bat
backend/stop*.bat
backend/restart*.bat
backend/restart*.ps1
backend/test_*.py
backend/test_*.ps1
backend/*.ps1

# Docker compose 文件
docker-compose*.yml
!docker-compose.yml

# Claude 配置
.claude/
backend/.claude/

# 其他大目录
backend/alembic/
backend/deploy/
backend/static/
