# ═══════════════════════════════════════════════
# RMFOOD Docker 构建排除文件
# ═══════════════════════════════════════════════

# Git
.git
.gitignore

# Python
__pycache__
*.pyc
*.pyo
*.egg-info
.eggs
dist
build
*.egg
.mypy_cache
.pytest_cache
.ruff_cache

# 虚拟环境
.venv
venv
env

# IDE
.vscode
.idea
*.swp
*.swo

# 测试（不需要打包到生产镜像）
tests/
**/test_*.py
**/tests/
coverage/
htmlcov/
.coverage
*.xml

# 文档
docs/
*.md
!README.md

# 环境文件
.env
.env.*
!.env.example

# 临时文件
tmp/
temp/
*.tmp
*.bak

# 前端构建产物（由 Dockerfile.frontend 单独构建）
frontend/node_modules
frontend/dist
frontend/build

# 数据文件
data/
*.db
*.sqlite

# 报告文件
*.report.html
*_REPORT.md
*_report.*

# 部署文档（不需要打包到镜像）
DEPLOYMENT_*.md
LAN_*.md
PRODUCTION_*.md
NETWORK_*.md
QUICK_START.md
FINAL_CLOSURE_REPORT.md

# 调试截图
debug_*.png

# 脚本（不需要打包到镜像）
scripts/
run_backend.py
run_backend_simple.py
start-lan.bat
stop-lan.bat
start_backend.bat

# Docker compose 文件
docker-compose*.yml
!docker-compose.yml

# 前端构建缓存
frontend/.vite-cache/
frontend/tsconfig.tsbuildinfo

# Claude 配置
.claude/
backend/.claude/
