# ============================================================
# RMFOOD Docker 构建排除文件 - 生产环境精确配置
# 构建上下文：项目根目录
# 注意事项：以下规则直接影响 backend/app/、backend/alembic/ 等
# ============================================================

# ===== Git / IDE =====
.git
.gitignore
.vscode
.idea
.husky
*.swp
*.swo
*~
.trae

# ===== Python 虚拟环境 / 缓存 =====
.venv/
venv/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
.mypy_cache/
.pytest_cache/
.ruff_cache/

# ===== 测试报告 =====
tests-reports/
coverage/
htmlcov/
.coverage

# ===== 日志文件（根目录）=====
*.log
logs/

# ===== 临时文件 =====
tmp/
temp/
*.tmp
*.bak

# ===== Docker 卷内容（宿主机挂载）=====
uploads/
pg_data/
pg_data_new/
pg_data_backup_*/

# ===== 数据库文件 =====
*.db
*.sqlite
*.sqlite3

# ===== 环境文件 =====
.env
.env.local
.env.*.local

# ===== 文档（非运行时必需）=====
docs/
reports/
ai-docs/
*.md
!README.md
!backend/requirements.txt
!backend/alembic.ini

# ===== 调试截图 =====
debug_*.png
*.png
*.jpg
*.jpeg
*.gif
ai-page.png
screenshot-*.png

# ===== 前端构建产物 =====
frontend/node_modules/
frontend/.vite/
frontend/tsconfig.tsbuildinfo
frontend/test-results/
frontend/playwright-report/
frontend/tests-reports/
frontend/frontend.log

# 预构建 dist：生产镜像直接烘焙该目录，必须保留
# 反转下方 *.png 排除规则，以纳入 dist 内的静态资源（svg/png/woff 等）
!frontend/dist/
!frontend/dist/**
!frontend/dist/**/*.png
!frontend/dist/**/*.jpg
!frontend/dist/**/*.jpeg
!frontend/dist/**/*.gif
!frontend/dist/**/*.svg
!frontend/dist/**/*.woff
!frontend/dist/**/*.woff2
!frontend/dist/**/*.webp

# ===== Claude 配置 =====
.claude/
backend/.claude/

# ===== 大型二进制/数据文件（非运行时必需）=====
backend/=1.44.0
backend/uv.lock
backend/openapi_*.json
backend/rmfood.db
backend/server*.log
backend/backend_output.log
openfoodfacts/en.openfoodfacts.org.products.csv
tcmsp_data/

# ===== 已废弃的开发脚本（根目录）=====
run_backend.py
start_*.bat
stop_*.bat
start_*.ps1
stop_*.ps1
restart_*.ps1
execute_import.py
final_import_runner.py
import_runner.py
fix_alembic.sh
check_*.py
create_*.py
cleanup_*.py
verify_*.py
embed_to_rmfoodfp.py
generate_*.py
*.ps1
fix_*.py
fix_*.sh

# ===== Docker 自身配置（不影响构建）=====
docker-compose*.yml
Dockerfile*
.dockerignore

