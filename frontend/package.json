{
  "name": "rmfood-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:ci": "vitest run --coverage --reporter=verbose",
    "audit:lighthouse": "lighthouse http://localhost:3000 --view --output html --output-path ./lighthouse-report.html",
    "build:optimized": "vite build --config vite.config.optimized.ts",
    "tokens:generate": "npx tsx scripts/generate-css-variables.ts",
    "tokens:watch": "nodemon --watch scripts/generate-css-variables.ts --watch src/types/design-tokens.ts --exec \"npx tsx scripts/generate-css-variables.ts\""
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sentry/react": "^10.66.0",
    "@sentry/tracing": "^7.120.4",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.24",
    "@types/d3": "^7.4.3",
    "@types/dompurify": "^3.0.5",
    "@use-gesture/react": "^10.3.1",
    "antd": "^6.5.1",
    "axios": "^1.10.0",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "docx": "^9.6.1",
    "dompurify": "^3.4.2",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.40.0",
    "fuse.js": "^7.3.0",
    "html2canvas": "^1.4.1",
    "i18next": "^26.2.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lodash-es": "^4.18.1",
    "lucide-react": "^0.525.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.6.1",
    "recharts": "^2.15.3",
    "tailwind-merge": "^3.3.0",
    "web-vitals": "^5.2.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.3",
    "@eslint/js": "^9.39.4",
    "@faker-js/faker": "^9.6.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.24",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.11.4",
    "eslint": "^9.39.4",
    "eslint-plugin-i18next": "^6.0.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.4",
    "rimraf": "^5.0.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.1.8",
    "terser": "^5.46.1",
    "ts-jest": "^29.4.9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.10",
    "vitest": "^3.2.4"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/**/*.{css,scss,less}": [
      "prettier --write"
    ]
  }
}
