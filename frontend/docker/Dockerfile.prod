# ============================================
# RMFOOD 配方平台 - 生产环境 Dockerfile
# 多阶段构建，优化镜像大小
# ============================================

# ---------- 阶段 1: 构建 ----------
FROM node:20-alpine AS builder

# 设置工作目录
WORKDIR /app

# 安装依赖（先复制 package 文件以利用 Docker 缓存）
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund 2>&1 | tail -5

# 复制源代码
COPY . .

# 设置环境变量
ENV NODE_ENV=production
ENV VITE_BACKEND_URL=http://backend:8000

# 构建生产版本
RUN npm run build 2>&1 | tail -10

# ---------- 阶段 2: 运行时 ----------
FROM nginx:alpine AS runtime

# 复制自定义 nginx 配置
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# 复制构建产物
COPY --from=builder /app/dist /usr/share/nginx/html

# 创建非 root 用户
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nginx-user -u 1001

# 设置权限
RUN chown -R nginx-user:nodejs /usr/share/nginx/html && \
    chown -R nginx-user:nodejs /var/cache/nginx && \
    chown -R nginx-user:nodejs /var/log/nginx && \
    chown -R nginx-user:nodejs /etc/nginx/conf.d && \
    touch /var/run/nginx.pid && \
    chown -R nginx-user:nodejs /var/run/nginx.pid

# 暴露端口
EXPOSE 80

# 健康检查
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost/health || exit 1

# 切换到非 root 用户
USER nginx-user

# 启动 nginx
CMD ["nginx", "-g", "daemon off;"]
