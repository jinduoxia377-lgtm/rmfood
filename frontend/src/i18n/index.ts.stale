import i18n from 'i18next'
import { initReactI18next } from 'react-i18next'
import zhCN from './zh-CN'
import zhCNAI from './zh-CN/ai'
import enUS from './en-US'
import enUSAI from './en-US/ai'

export interface LanguageConfig {
  code: string
  name: string
  nativeName: string
  flag: string
  dir: 'ltr' | 'rtl'
  dateFormat: string
}

export const SUPPORTED_LANGUAGES: LanguageConfig[] = [
  {
    code: 'zh-CN',
    name: 'Chinese (Simplified)',
    nativeName: '简体中文',
    flag: '🇨🇳',
    dir: 'ltr',
    dateFormat: 'YYYY年MM月DD日',
  },
  {
    code: 'en-US',
    name: 'English (US)',
    nativeName: 'English',
    flag: '🇺🇸',
    dir: 'ltr',
    dateFormat: 'MM/DD/YYYY',
  },
]

const DEFAULT_LANGUAGE = 'zh-CN'

// 预计算 AI 翻译合并结果（基础文件优先，AI 专项文件补充）
const zhCNAIMerged = { ...(zhCN.translation?.ai || {}), ...zhCNAI }
const enUSAIMerged = { ...(enUS.translation?.ai || {}), ...enUSAI }

i18n.use(initReactI18next).init({
  resources: {
    'zh-CN': {
      translation: {
        ...(zhCN.translation || {}),
        ai: zhCNAIMerged,
      },
    },
    'en-US': {
      translation: {
        ...(enUS.translation || {}),
        ai: enUSAIMerged,
      },
    },
  },
  lng: localStorage.getItem('rmfood-language') || DEFAULT_LANGUAGE,
  fallbackLng: DEFAULT_LANGUAGE,
  defaultNS: 'translation',
  ns: ['translation'],
  interpolation: {
    escapeValue: false,
  },
  react: {
    useSuspense: false,
    bindI18n: 'languageChanged loaded',
    bindI18nStore: 'added removed',
  },
  returnEmptyString: false,
  returnObjects: false,
  keySeparator: '.',
  nsSeparator: ':',
  missingKeyHandler: (lng, ns, key, fallbackValue) => {
    if (import.meta.env.DEV) {
      console.warn(`[i18n] Missing key: ${key} in language: ${lng}, namespace: ${ns}`)
    }
  },
  // 注意：saveMissing 已禁用 — 该选项会在键首次查找失败时将键名作为值写入资源，
// 覆盖后续 addResourceBundle 注册的正确翻译值，导致 safeT() 误判为未翻译
  // saveMissing: true,
  // saveMissingTo: 'current',
})

// 通过 addResourceBundle API 显式注册 AI 翻译（确保嵌套键在原生 API 层可用）
i18n.addResourceBundle('zh-CN', 'translation', { ai: zhCNAIMerged }, true, true)
i18n.addResourceBundle('en-US', 'translation', { ai: enUSAIMerged }, true, true)

i18n.on('languageChanged', (lng) => {
  localStorage.setItem('rmfood-language', lng)
  document.documentElement.lang = lng
  const langConfig = SUPPORTED_LANGUAGES.find(l => l.code === lng)
  if (langConfig) {
    document.documentElement.dir = langConfig.dir
  }
})

export default i18n
