# ============================================
# RMFOOD 配方平台 - 环境变量模板
# 复制为 .env.production 并填入实际值
# ============================================

# ---------- 前端配置 ----------
# 后端 API 地址（Docker 内部网络）
VITE_BACKEND_URL=http://backend:8000

# 前端端口
VITE_PORT=80

# ---------- 后端配置 ----------
# 数据库连接
DATABASE_URL=postgresql://rmfood:rmfood_password@db:5432/rmfood

# Redis 连接
REDIS_URL=redis://redis:6379/0

# 密钥（生产环境必须更换！）
SECRET_KEY=your-super-secret-key-change-in-production

# PostgreSQL 密码
POSTGRES_PASSWORD=your-strong-postgres-password

# ---------- 安全配置 ----------
# 启用 HTTPS（生产环境建议）
HTTPS_ENABLED=false

# CORS 允许的域名
CORS_ORIGINS=https://your-domain.com

# ---------- WebSocket ----------
# 分析页实时数据 WebSocket（由后端主服务提供，需登录 Cookie 认证）
VITE_WS_ANALYTICS_URL=ws://backend:8000/api/v1/analytics/ws/dashboard

# ---------- 日志配置 ----------
# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=WARNING
