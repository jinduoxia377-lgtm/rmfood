# RMFOOD 配方平台 - 环境变量配置模板
# 复制此文件为 .env.local 或 .env.development.local 或 .env.production.local

# ========== 应用配置 ==========
VITE_APP_NAME=RMFOOD配方设计平台
VITE_APP_VERSION=1.0.0

# ========== 开发服务器配置 ==========
# Vite 开发服务器端口
VITE_PORT=3000

# 代理超时时间（毫秒）
VITE_PROXY_TIMEOUT=60000

# ========== 环境模式 ==========
# 可选值: development | staging | production
VITE_ENV=development

# ========== API 配置 ==========
# API 基础路径（相对路径，由 Vite 代理）
VITE_API_BASE_URL=/api/v1

# 后端服务完整 URL（用于 WebSocket 和直接调用）
VITE_BACKEND_URL=http://localhost:8000

# API 请求超时时间（毫秒）
VITE_API_TIMEOUT=30000

# 最大重试次数
VITE_MAX_RETRIES=3

# 重试延迟时间（毫秒）
VITE_RETRY_DELAY=1000

# 缓存 TTL（毫秒）
VITE_CACHE_TTL=300000

# ========== WebSocket 配置 ==========
# WebSocket 连接 URL
VITE_WS_URL=ws://localhost:8000/api/v1/ws

# WebSocket Analytics 连接 URL
VITE_WS_ANALYTICS_URL=ws://localhost:8000/api/v1/analytics/ws/dashboard

# WebSocket 重连间隔（毫秒）
VITE_WS_RECONNECT_INTERVAL=5000

# WebSocket 最大重连次数
VITE_WS_MAX_RECONNECT=5

# ========== 功能开关 ==========
# 是否启用缓存
VITE_ENABLE_CACHE=true

# 是否启用 WebSocket
VITE_ENABLE_WEBSOCKET=true

# 是否启用实时数据同步
VITE_ENABLE_REALTIME_SYNC=true

# ========== 第三方登录 OAuth 配置 ==========
# 微信开放平台 AppID — 在 https://open.weixin.qq.com 申请
VITE_WECHAT_APPID=
# QQ 互联 AppID — 在 https://connect.qq.com 申请
VITE_QQ_APPID=
# GitHub OAuth App Client ID — 在 https://github.com/settings/developers 申请
VITE_GITHUB_CLIENT_ID=

# ========== 开发配置 ==========
# 默认登录凭据（仅开发环境使用）
VITE_DEFAULT_USERNAME=admin
VITE_DEFAULT_PASSWORD=CHANGE_ME_DEV_ONLY

# ========== 白名单申请 ==========
# 申请窗口截止时间（UTC ISO 8601，如 2026-10-25T16:00:00Z）。
# 留空时登录页/申请页不展示窗口截止倒计时（上线前由运维配置）。
VITE_WHITELIST_WINDOW_END=
