/**
 * RMFOOD 小程序 - 全局布局规范
 * 对齐桌面规范 DESIGN.md §6/§9，解决页面排版和边距问题
 * 注意：页面容器/列表/卡片基础类在 grid-system.wxss 定义，
 * 本文件仅补充导航、滚动、安全区与组件布局适配，避免重复定义。
 */

/* ============================================
   1. 页面基础样式
   ============================================ */

page {
  /* 安全区域适配 */
  padding-top: env(safe-area-inset-top);
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}

/* ============================================
   2. 滚动容器规范
   ============================================ */

/* 内容滚动区 - 自动计算高度 */
.content-scroll {
  flex: 1;
  height: 0;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

/* ============================================
   3. 固定导航栏规范
   ============================================ */

/* 固定顶部导航 - 自动适配状态栏 */
.fixed-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: var(--z-index-fixed, 100);
  padding-top: env(safe-area-inset-top);
  box-sizing: border-box;
}

/* Large Title 导航 - 首页专用 */
.large-title-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: var(--z-index-fixed, 100);
  background: var(--blur-bg, rgba(255, 255, 255, 0.8));
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border-bottom: 0.5rpx solid var(--color-separator);
  padding-top: env(safe-area-inset-top);
  box-sizing: border-box;
}

/* ============================================
   4. 内容间距规范
   ============================================ */

/* 页面内容区 - 自动偏移固定导航 */
.page-content {
  padding-top: calc(env(safe-area-inset-top) + 120rpx);
  padding-left: var(--space-md, 32rpx);
  padding-right: var(--space-md, 32rpx);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* ============================================
   5. 底部安全区规范
   ============================================ */

/* 底部间距 - 适配TabBar和安全区域 */
.bottom-spacing {
  height: calc(100rpx + env(safe-area-inset-bottom));
}

/* ============================================
   6. 内容卡片容器规范
   ============================================ */

/* 内容卡片 - 统一圆角和阴影 */
.content-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-card, 24rpx);
  padding: var(--space-lg, 48rpx);
  margin-bottom: var(--space-md, 32rpx);
  box-shadow: var(--shadow-sm);
}

/* ============================================
   7. 网格布局规范
   ============================================ */

/* 网格容器 */
.grid-container {
  display: grid;
  gap: var(--space-md, 32rpx);
  grid-template-columns: repeat(3, 1fr);
}

/* ============================================
   8. 响应式适配
   ============================================ */

/* 小屏幕设备适配 */
@media screen and (max-width: 375px) {
  .page-content {
    padding-left: var(--space-3, 24rpx);
    padding-right: var(--space-3, 24rpx);
  }
}

/* 大屏幕设备适配 */
@media screen and (min-width: 414px) {
  .page-content {
    max-width: 690rpx;
    margin-left: auto;
    margin-right: auto;
  }
}

/* ============================================
   9. 通用工具类
   ============================================ */

/* 安全区域padding */
.pt-safe { padding-top: env(safe-area-inset-top); }
.pb-safe { padding-bottom: env(safe-area-inset-bottom); }
.pl-safe { padding-left: env(safe-area-inset-left); }
.pr-safe { padding-right: env(safe-area-inset-right); }

/* 内容区padding */
.p-content {
  padding: var(--space-lg, 48rpx);
}

.p-x {
  padding-left: var(--space-lg, 48rpx);
  padding-right: var(--space-lg, 48rpx);
}

.p-y {
  padding-top: var(--space-lg, 48rpx);
  padding-bottom: var(--space-lg, 48rpx);
}

/* 文本截断 */
.text-truncate {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-truncate-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.text-truncate-3 {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}