/**
 * RMFOOD 小程序 - 全局布局规范
 * 解决所有页面的排版和边距问题
 */

/* ============================================
   1. 页面基础样式
   ============================================ */

page {
  /* 安全区域适配 */
  padding-top: env(safe-area-inset-top);
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}

/* ============================================
   2. 页面容器规范
   ============================================ */

/* 标准页面容器 - 适配所有页面 */
.page-container {
  min-height: 100vh;
  min-height: 100dvh; /* 动态视口高度，适配移动端 */
  background: var(--color-bg-page);
  display: flex;
  flex-direction: column;
  /* 确保内容不被TabBar遮挡 */
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

/* ============================================
   3. 滚动容器规范
   ============================================ */

/* 内容滚动区 - 自动计算高度 */
.content-scroll {
  flex: 1;
  /* 确保滚动区域不超出安全区域 */
  height: 0;
}

/* ============================================
   4. 固定导航栏规范
   ============================================ */

/* 固定顶部导航 - 自动适配状态栏 */
.fixed-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: var(--z-index-fixed, 100);
  /* 自动适配状态栏高度 */
  padding-top: env(safe-area-inset-top);
  box-sizing: border-box;
}

/* Large Title 导航 - 首页专用 */
.large-title-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: var(--z-index-fixed, 100);
  background: var(--blur-bg, rgba(255, 255, 255, 0.8));
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border-bottom: 0.5rpx solid var(--color-separator);
  /* 适配状态栏 */
  padding-top: env(safe-area-inset-top);
  box-sizing: border-box;
}

/* ============================================
   5. 内容间距规范
   ============================================ */

/* 页面内容区 - 自动偏移固定导航 */
.page-content {
  /* 根据实际导航高度调整 */
  padding-top: calc(env(safe-area-inset-top) + 120rpx);
  padding-left: var(--space-md, 16rpx);
  padding-right: var(--space-md, 16rpx);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* ============================================
   6. 底部安全区规范
   ============================================ */

/* 底部间距 - 适配TabBar和安全区域 */
.bottom-spacing {
  height: calc(100rpx + env(safe-area-inset-bottom));
  /* TabBar高度约100rpx + 安全区域 */
}

/* ============================================
   7. 卡片容器规范
   ============================================ */

/* 内容卡片 - 统一圆角和阴影 */
.content-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-card, 16rpx);
  padding: var(--space-lg, 24rpx);
  margin-bottom: var(--space-md, 16rpx);
  box-shadow: var(--shadow-sm);
}

/* ============================================
   8. 列表项规范
   ============================================ */

/* 列表容器 */
.list-container {
  background: var(--color-bg-card);
  border-radius: var(--radius-card, 16rpx);
  overflow: hidden;
  margin-bottom: var(--space-md, 16rpx);
}

/* 列表项 */
.list-item {
  display: flex;
  align-items: center;
  padding: var(--space-lg, 24rpx);
  background: var(--color-bg-card);
  /* 确保点击区域足够大 */
  min-height: 88rpx;
}

/* 分割线 */
.list-item:not(:last-child)::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: var(--space-lg, 24rpx);
  right: 0;
  height: 0.5rpx;
  background: var(--color-separator);
}

/* ============================================
   9. 网格布局规范
   ============================================ */

/* 网格容器 */
.grid-container {
  display: grid;
  gap: var(--space-md, 16rpx);
  /* 默认3列 */
  grid-template-columns: repeat(3, 1fr);
}

/* ============================================
   10. 响应式适配
   ============================================ */

/* 小屏幕设备适配 */
@media screen and (max-width: 375px) {
  .page-content {
    padding-left: var(--space-sm, 12rpx);
    padding-right: var(--space-sm, 12rpx);
  }
}

/* 大屏幕设备适配 */
@media screen and (min-width: 414px) {
  .page-content {
    max-width: 690rpx;
    margin-left: auto;
    margin-right: auto;
  }
}

/* ============================================
   11. 组件适配
   ============================================ */

/* Apple NavBar 适配 */
.apple-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: var(--z-index-fixed, 100);
  background: var(--blur-bg, rgba(255, 255, 255, 0.8));
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border-bottom: 0.5rpx solid var(--color-separator);
  /* 适配状态栏 */
  padding-top: env(safe-area-inset-top);
  box-sizing: border-box;
}

.apple-navbar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 44rpx;
  padding: 0 var(--space-lg, 24rpx);
}

/* ============================================
   12. 通用工具类
   ============================================ */

/* 安全区域padding */
.pt-safe { padding-top: env(safe-area-inset-top); }
.pb-safe { padding-bottom: env(safe-area-inset-bottom); }
.pl-safe { padding-left: env(safe-area-inset-left); }
.pr-safe { padding-right: env(safe-area-inset-right); }

/* 内容区padding */
.p-content {
  padding: var(--space-lg, 24rpx);
}

.p-x {
  padding-left: var(--space-lg, 24rpx);
  padding-right: var(--space-lg, 24rpx);
}

.p-y {
  padding-top: var(--space-lg, 24rpx);
  padding-bottom: var(--space-lg, 24rpx);
}

/* 文本截断 */
.text-truncate {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-truncate-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.text-truncate-3 {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
