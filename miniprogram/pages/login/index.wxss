
.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
  background: linear-gradient(180deg, var(--color-brand-50) 0%, var(--color-bg-page) 100%);
}

.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 96rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 32rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--color-brand-500);
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: var(--color-text-tertiary);
}

.login-form {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: var(--color-brand-500);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
}

.agreement {
  margin-top: 48rpx;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  display: flex;
  align-items: center;
}

.link {
  color: var(--color-brand-500);
}

/* ============================================
   底部安全区
   ============================================ */
.bottom-spacing {
  height: calc(40rpx + env(safe-area-inset-bottom));
}
