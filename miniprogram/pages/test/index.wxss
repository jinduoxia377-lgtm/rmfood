.container {
  padding: 24rpx;
}

.section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #353535;
  margin-bottom: 24rpx;
}

.icon-list {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.badge-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.badge-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
