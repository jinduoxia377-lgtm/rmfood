.container {
  padding: 24rpx;
}

.section {
  background-color: var(--color-bg-card);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: var(--font-size-title-3);
  font-weight: 600;
  color: var(--color-text-secondary);
  margin-bottom: 24rpx;
}

.icon-list {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.badge-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.badge-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* ============================================
   底部安全区
   ============================================ */
.bottom-spacing {
  height: calc(40rpx + env(safe-area-inset-bottom));
}
