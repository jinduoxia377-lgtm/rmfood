<!-- Apple Style 搜索页面 -->
<view class="page-container">
  <!-- 导航栏 -->
  <view class="search-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="search-nav-content">
      <view class="nav-btn" bindtap="onCancel" aria-label="取消">
        <text class="cancel-text">取消</text>
      </view>
      <view class="nav-title">搜索</view>
      <view class="nav-placeholder"></view>
    </view>
  </view>

  <!-- Search Bar -->
  <view class="search-bar-container" style="padding-top: {{navHeight}}rpx;">
    <view class="apple-searchbar" bindtap="focusSearch">
      <view class="search-icon-wrap">
        <icon name="search" size="sm" color="var(--color-text-tertiary)" />
      </view>
      <input
        class="search-input"
        placeholder="搜索食材、配方..."
        placeholder-class="search-placeholder"
        value="{{searchQuery}}"
        bindinput="onSearchInput"
        bindconfirm="onSearch"
        focus="{{hasSearch}}"
        confirm-type="search"
        aria-label="搜索输入框"
      />
      <view wx:if="{{searchQuery}}" class="search-clear" bindtap="clearSearch" aria-label="清除">
        <text class="clear-text">×</text>
      </view>
    </view>
    
    <!-- 语音搜索 -->
    <view class="voice-btn {{isVoiceRecording ? 'recording' : ''}}" bindtap="startVoiceSearch" aria-label="语音搜索">
      <icon name="mic" size="md" color="var(--color-system-blue)" />
    </view>
  </view>

  <!-- 分段控制器 -->
  <view class="segmented-container" wx:if="{{hasSearch}}">
    <view class="apple-segmented">
      <view 
        class="apple-segmented-item {{activeTab === 'all' ? 'active' : ''}}"
        bindtap="switchTab"
        data-tab="all"
      >全部</view>
      <view 
        class="apple-segmented-item {{activeTab === 'ingredient' ? 'active' : ''}}"
        bindtap="switchTab"
        data-tab="ingredient"
      >食材</view>
      <view 
        class="apple-segmented-item {{activeTab === 'formula' ? 'active' : ''}}"
        bindtap="switchTab"
        data-tab="formula"
      >配方</view>
      <view 
        class="apple-segmented-item {{activeTab === 'knowledge' ? 'active' : ''}}"
        bindtap="switchTab"
        data-tab="knowledge"
      >知识</view>
    </view>
  </view>

  <!-- 滚动内容 -->
  <scroll-view
    class="content-scroll"
    scroll-y
    refresher-enabled
    refresher-triggered="{{loading && !searched}}"
    bindrefresherrefresh="onPullDownRefresh"
    style="margin-top: {{hasSearch ? 100 : 0}}rpx;"
  >
    
    <!-- 未搜索状态 -->
    <view wx:if="{{!hasSearch}}" class="empty-state">
      <view class="empty-icon">
        <icon name="search" size="xl" color="var(--color-text-tertiary)" />
      </view>
      <text class="empty-title">搜索食材、配方</text>
      <text class="empty-desc">输入关键词开始探索药食同源世界</text>
      
      <!-- 热门搜索 -->
      <view class="hot-search">
        <text class="hot-title">热门搜索</text>
        <view class="hot-tags">
          <view 
            wx:for="{{hotKeywords}}" 
            wx:key="index"
            class="hot-tag"
            bindtap="searchKeyword"
            data-keyword="{{item}}"
          >{{item}}</view>
        </view>
      </view>
      
      <!-- 搜索历史 -->
      <view wx:if="{{history.length > 0}}" class="search-history">
        <view class="history-header">
          <text class="history-title">搜索历史</text>
          <view class="clear-history" bindtap="clearHistory">
            <text class="clear-text">清除</text>
          </view>
        </view>
        <view class="history-list">
          <view 
            wx:for="{{history}}" 
            wx:key="id"
            class="history-item"
            bindtap="searchHistory"
            data-id="{{item.id}}"
          >
            <icon name="history" size="sm" color="var(--color-text-tertiary)" />
            <text class="history-text">{{item.keyword}}</text>
            <view class="history-delete" bindtap="deleteHistory" data-id="{{item.id}}">
              <icon name="close" size="sm" color="var(--color-text-tertiary)" />
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 搜索结果 -->
    <view wx:if="{{hasSearch}}" class="results-area">
      <!-- 结果统计 -->
      <view class="results-info">
        <text class="results-count">找到 {{results.length}} 个结果</text>
        <view class="filter-btn" bindtap="toggleFilter" aria-label="筛选">
          <icon name="filter" size="sm" color="var(--color-system-blue)" />
          <text>筛选</text>
        </view>
      </view>

      <!-- 筛选面板 -->
      <view wx:if="{{showFilter}}" class="filter-panel apple-card">
        <view class="filter-section">
          <text class="filter-label">药性</text>
          <view class="filter-options">
            <view 
              wx:for="{{natureOptions}}" 
              wx:key="index"
              class="filter-option {{filters.nature === item ? 'active' : ''}}"
              bindtap="applyFilter"
              data-type="nature"
              data-value="{{item}}"
            >{{item}}</view>
          </view>
        </view>
        
        <view class="filter-section">
          <text class="filter-label">功效</text>
          <view class="filter-options">
            <view 
              wx:for="{{effectOptions}}" 
              wx:key="index"
              class="filter-option {{filters.effect === item ? 'active' : ''}}"
              bindtap="applyFilter"
              data-type="effect"
              data-value="{{item}}"
            >{{item}}</view>
          </view>
        </view>
        
        <view class="filter-actions">
          <view class="filter-btn clear" bindtap="clearFilter">清除</view>
          <view class="filter-btn apply" bindtap="applyFilters">确定</view>
        </view>
      </view>

      <!-- 结果列表 -->
      <view class="results-list">
        <view 
          wx:for="{{results}}" 
          wx:key="id"
          class="result-item apple-list-item"
          bindtap="viewResult"
          data-id="{{item.id}}"
        >
          <view class="result-icon-wrap">
            <image 
              wx:if="{{item.imageUrl}}"
              class="result-icon"
              src="{{item.imageUrl}}"
              mode="aspectFill"
            />
            <view wx:else class="result-icon-placeholder">
              <icon name="{{item.type === 'ingredient' ? 'ingredient' : 'formula'}}" size="md" color="var(--color-text-tertiary)" />
            </view>
          </view>
          <view class="result-content">
            <text class="result-title">{{item.title}}</text>
            <text class="result-desc">{{item.subtitle}}</text>
            <view class="result-tags">
              <tag wx:for="{{item.tags}}" wx:key="index" wx:for-item="tag" class="tag-apple primary">{{tag}}</tag>
            </view>
          </view>
          <view class="result-accessory">
            <icon name="arrow-right" size="sm" color="var(--color-text-tertiary)" />
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view wx:if="{{results.length === 0 && searched}}" class="empty-results">
        <view class="empty-icon">
          <icon name="empty" size="xl" color="var(--color-text-tertiary)" />
        </view>
        <text class="empty-title">未找到相关结果</text>
        <text class="empty-desc">请尝试其他关键词或筛选条件</text>
      </view>
    </view>

    <!-- 底部间距 -->
    <view class="bottom-spacing"></view>
  </scroll-view>
</view>
