/* search/index.wxss - 药食同源搜索页样式 */

/* 页面容器 */
.page-container {
  min-height: 100vh;
  background: var(--color-bg-primary);
  display: flex;
  flex-direction: column;
}

/* 搜索头部 */
.header {
  background: linear-gradient(135deg, var(--color-brand-500) 0%, var(--color-brand-400) 100%);
  position: sticky;
  top: 0;
  z-index: var(--z-index-sticky);
  box-shadow: var(--shadow-brand);
}

.header-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-3) var(--space-4);
  gap: var(--space-3);
}

.nav-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.header-title {
  flex: 1;
  text-align: center;
}

.title-main {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-white);
}

/* 搜索框 */
.search-bar {
  padding: var(--space-3) var(--space-4);
  background: var(--color-bg-secondary);
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  padding: var(--space-3) var(--space-4);
  background: var(--color-bg-primary);
  border-radius: var(--radius-full);
  gap: var(--space-2);
}

.search-input {
  flex: 1;
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
}

.search-placeholder {
  color: var(--color-text-muted);
}

/* 搜索历史 */
.history-section {
  background: var(--color-bg-secondary);
  margin-top: var(--space-2);
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-3) var(--space-4);
}

.history-title {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}

.history-clear {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
  cursor: pointer;
}

.history-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  padding: 0 var(--space-4) var(--space-4);
}

.history-item {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  padding: var(--space-2) var(--space-3);
  background: var(--color-bg-primary);
  border-radius: var(--radius-full);
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.history-item:active {
  background: rgba(45, 90, 61, 0.1);
  color: var(--color-primary);
}

/* 结果统计 */
.result-stats {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-3) var(--space-4);
  background: var(--color-bg-secondary);
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
  border-bottom: 1rpx solid var(--color-border);
}

.sort-selector {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  padding: var(--space-1) var(--space-2);
  background: var(--color-bg-primary);
  border-radius: var(--radius-md);
  cursor: pointer;
}

/* 结果列表 */
.results-section {
  padding: var(--space-3) var(--space-4);
}

.results-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.result-card {
  background: var(--color-bg-secondary);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  box-shadow: var(--shadow-sm);
  transition: all var(--transition-fast);
}

.result-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-md);
}

.result-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-tertiary);
  margin-bottom: var(--space-3);
}

.result-content {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.result-name {
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.result-desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.result-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-1);
}

/* 热门搜索 */
.hot-section {
  background: var(--color-bg-secondary);
  margin-top: var(--space-2);
}

.hot-header {
  padding: var(--space-3) var(--space-4);
}

.hot-title {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}

.hot-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  padding: 0 var(--space-4) var(--space-4);
}

.hot-item {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-2) var(--space-3);
  background: linear-gradient(135deg, rgba(45, 90, 61, 0.1), rgba(74, 124, 92, 0.1));
  border-radius: var(--radius-full);
  font-size: var(--font-size-sm);
  color: var(--color-primary);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.hot-item:active {
  transform: scale(0.95);
}

.hot-rank {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary);
  color: var(--color-text-white);
  border-radius: var(--radius-sm);
  font-size: var(--font-size-xs);
}

.hot-count {
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
}

/* 分类标签 */
.category-section {
  background: var(--color-bg-secondary);
  margin-top: var(--space-2);
  padding: var(--space-4);
}

.category-header {
  margin-bottom: var(--space-3);
}

.category-title {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-3);
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-2);
  cursor: pointer;
  padding: var(--space-3);
  border-radius: var(--radius-lg);
  transition: all var(--transition-fast);
}

.category-item:active {
  background: var(--color-bg-tertiary);
  transform: scale(0.95);
}

.category-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-primary);
}

.category-name {
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  text-align: center;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-12) var(--space-6);
  gap: var(--space-4);
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--color-gray-200);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-12) var(--space-6);
  gap: var(--space-3);
}

.empty-text {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  font-weight: var(--font-weight-medium);
}

.empty-desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
  text-align: center;
}

/* 响应式设计 */
@media screen and (min-width: 768px) {
  .category-grid {
    grid-template-columns: repeat(6, 1fr);
  }
}
