/* ============================================
   Apple Style 鎼滅储椤甸潰鏍峰紡
   ============================================ */

.page-container {
  min-height: 100vh;
  background: var(--color-bg-page);
  display: flex;
  flex-direction: column;

  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
 }

/* ============================================
   鎼滅储瀵艰埅鏍?   ============================================ */
.search-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: var(--z-index-fixed);
  background: var(--blur-bg);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border-bottom: 0.5rpx solid var(--color-separator);
}

.search-nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 44rpx;
  padding: 0 16rpx;
}

.nav-btn {
  padding: 8rpx;
  margin: -8rpx;
  -webkit-tap-highlight-color: transparent;
}

.cancel-text {
  font-size: var(--font-size-body);
  color: var(--color-system-blue);
}

.nav-title {
  font-size: var(--font-size-title-3);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.nav-placeholder {
  width: 60rpx;
}

/* ============================================
   Search Bar 瀹瑰櫒
   ============================================ */
.search-bar-container {
  position: fixed;
  top: calc(env(safe-area-inset-top) + 44rpx);
  left: 0;
  right: 0;
  z-index: var(--z-index-sticky);
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  background: var(--color-bg-page);
}

.apple-searchbar {
  flex: 1;
  background: rgba(118, 118, 128, 0.12);
  border-radius: 10rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  padding: 0 12rpx;
}

.search-icon-wrap {
  width: 24rpx;
  height: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: var(--font-size-body);
  background: transparent;
  border: none;
  outline: none;
  color: var(--color-text-primary);
  height: 100%;
  padding: 0 4rpx;
}

.search-placeholder {
  color: var(--color-text-tertiary);
}

.search-clear {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: var(--color-gray-400);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.clear-text {
  color: white;
  font-size: 16rpx;
  line-height: 1;
  font-weight: 500;
}

/* 璇煶鎼滅储 */
.voice-btn {
  width: 44rpx;
  height: 44rpx;
  margin-left: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  -webkit-tap-highlight-color: transparent;
}

.voice-btn:active {
  background: var(--color-bg-hover);
}

.voice-btn.recording {
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* ============================================
   鍒嗘鎺у埗鍣?   ============================================ */
.segmented-container {
  position: fixed;
  top: calc(env(safe-area-inset-top) + 92rpx);
  left: 0;
  right: 0;
  z-index: var(--z-index-sticky);
  background: var(--color-bg-page);
  padding: 8rpx 0;
}

.apple-segmented {
  display: flex;
  background: rgba(118, 118, 128, 0.12);
  border-radius: 9rpx;
  padding: 2rpx;
  margin: 0 16rpx;
}

.apple-segmented-item {
  flex: 1;
  text-align: center;
  padding: 6rpx 0;
  font-size: var(--font-size-callout);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  border-radius: 7rpx;
  transition: all var(--transition-fast);
  -webkit-tap-highlight-color: transparent;
}

.apple-segmented-item.active {
  background: var(--color-bg-card);
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.08),
              0 1rpx 2rpx rgba(0, 0, 0, 0.04);
}

/* ============================================
   婊氬姩鍐呭鍖?   ============================================ */
.content-scroll {
  flex: 1;

  height: 0;
 }

/* ============================================
   绌虹姸鎬?   ============================================ */
.empty-state {
  padding: 60rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-full);
  background: var(--color-bg-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: var(--font-size-title-3);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: var(--font-size-callout);
  color: var(--color-text-secondary);
  text-align: center;
  line-height: var(--line-height-relaxed);
}

/* ============================================
   鐑棬鎼滅储
   ============================================ */
.hot-search {
  width: 100%;
  margin-top: 40rpx;
}

.hot-title {
  font-size: var(--font-size-title-3);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  padding: 0 16rpx 16rpx;
}

.hot-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 0 16rpx;
}

.hot-tag {
  padding: 10rpx 20rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-full);
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  box-shadow: var(--shadow-sm);
  -webkit-tap-highlight-color: transparent;
}

.hot-tag:active {
  transform: scale(0.96);
  opacity: 0.9;
}

/* ============================================
   鎼滅储鍘嗗彶
   ============================================ */
.search-history {
  width: 100%;
  margin-top: 32rpx;
}

.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16rpx 16rpx;
}

.history-title {
  font-size: var(--font-size-title-3);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.clear-history {
  padding: 8rpx;
  margin: -8rpx;
  -webkit-tap-highlight-color: transparent;
}

.clear-text {
  font-size: var(--font-size-body);
  color: var(--color-system-blue);
}

.history-list {
  display: flex;
  flex-direction: column;
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  overflow: hidden;
  margin: 0 16rpx;
  box-shadow: var(--shadow-sm);
}

.history-item {
  display: flex;
  align-items: center;
  padding: 14rpx 16rpx;
  background: var(--color-bg-card);
  -webkit-tap-highlight-color: transparent;
}

.history-item:active {
  background: var(--color-bg-hover);
}

.history-item:not(:last-child) {
  border-bottom: 0.5rpx solid var(--color-separator);
}

.history-text {
  flex: 1;
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  margin-left: 12rpx;
}

.history-delete {
  padding: 8rpx;
  margin: -8rpx;
  -webkit-tap-highlight-color: transparent;
}

/* ============================================
   缁撴灉鍖哄煙
   ============================================ */
.results-area {
  padding: 16rpx;
}

.results-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.results-count {
  font-size: var(--font-size-callout);
  color: var(--color-text-secondary);
}

.filter-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 12rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  font-size: var(--font-size-callout);
  color: var(--color-system-blue);
  box-shadow: var(--shadow-sm);
  -webkit-tap-highlight-color: transparent;
}

.filter-btn:active {
  background: var(--color-bg-hover);
}

/* 绛涢€夐潰鏉?*/
.filter-panel {
  margin-bottom: 16rpx;
}

.filter-section {
  padding: 16rpx;
}

.filter-label {
  font-size: var(--font-size-callout);
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
  display: block;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.filter-option {
  padding: 8rpx 16rpx;
  background: var(--color-bg-tertiary);
  border-radius: var(--radius-full);
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  -webkit-tap-highlight-color: transparent;
}

.filter-option.active {
  background: var(--color-system-blue);
  color: white;
}

.filter-actions {
  display: flex;
  gap: 12rpx;
  padding: 12rpx 16rpx;
  border-top: 0.5rpx solid var(--color-separator);
}

.filter-btn.clear {
  flex: 1;
  text-align: center;
  padding: 12rpx;
  background: var(--color-bg-tertiary);
  border-radius: var(--radius-md);
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
}

.filter-btn.apply {
  flex: 1;
  text-align: center;
  padding: 12rpx;
  background: var(--color-system-blue);
  border-radius: var(--radius-md);
  font-size: var(--font-size-body);
  color: white;
  font-weight: var(--font-weight-semibold);
}

/* 缁撴灉鍒楄〃 */
.results-list {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.result-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
  background: var(--color-bg-card);
  -webkit-tap-highlight-color: transparent;
}

.result-item:active {
  background: var(--color-bg-hover);
}

.result-item:not(:last-child) {
  border-bottom: 0.5rpx solid var(--color-separator);
}

.result-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.result-icon {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.result-icon-placeholder {
  width: 100%;
  height: 100%;
  background: var(--color-bg-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-content {
  flex: 1;
  min-width: 0;
}

.result-title {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  display: block;
}

.result-desc {
  font-size: var(--font-size-callout);
  color: var(--color-text-secondary);
  margin-top: 4rpx;
  display: block;
}

.result-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.result-accessory {
  color: var(--color-text-tertiary);
  margin-left: 8rpx;
}

/* ============================================
   绌虹粨鏋?   ============================================ */
.empty-results {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 32rpx;
}

/* ============================================
   搴曢儴闂磋窛
   ============================================ */
.bottom-spacing {
  height: calc(40rpx + env(safe-area-inset-bottom));
}

/* ============================================
   Apple Tag
   ============================================ */
.tag-apple {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-medium);
}

.tag-apple.primary { background: rgba(0, 122, 255, 0.12); color: var(--color-system-blue); }
.tag-apple.success { background: var(--color-success-bg); color: var(--color-success); }
.tag-apple.warning { background: var(--color-warning-bg); color: var(--color-warning); }
.tag-apple.danger { background: var(--color-danger-bg); color: var(--color-danger); }
.tag-apple.info { background: var(--color-info-bg); color: var(--color-info); }
