<!--pages/profile/index/index.wxml-->
<view class="profile-container">
  <view class="profile-header">
    <view class="avatar">
      <image src="/assets/images/default-avatar.png" mode="aspectFill"></image>
    </view>
    <view class="user-info">
      <text class="username">未登录</text>
      <text class="user-desc">登录后享受更多服务</text>
    </view>
  </view>
  <view class="profile-menu">
    <navigator url="/pages/profile/history/index" class="menu-item">
      <text>历史记录</text>
      <text class="arrow">></text>
    </navigator>
    <navigator url="/pages/settings/index" class="menu-item">
      <text>设置</text>
      <text class="arrow">></text>
    </navigator>
  </view>
</view>
