/* 我的收藏页面样式 */
.page-container {
  min-height: 100vh;
  background: var(--color-bg-page);
  display: flex;
  flex-direction: column;
}

.content-scroll {
  flex: 1;
}

/* 收藏列表 */
.favorites-list {
  padding: 16rpx;
}

.favorite-item {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: 20rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  box-shadow: var(--shadow-sm);
}

.favorite-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  flex-shrink: 0;
  background: var(--color-gray-100);
}

.favorite-image image {
  width: 100%;
  height: 100%;
}

.favorite-info {
  flex: 1;
  margin: 0 20rpx;
}

.favorite-name {
  font-size: var(--font-size-title-4);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin-bottom: 8rpx;
}

.favorite-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.tag {
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
  background: var(--color-bg-secondary);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
}

.favorite-meta {
  display: flex;
  gap: 16rpx;
}

.meta-item {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
}

.unfavorite-btn {
  padding: 8rpx;
  margin: -8rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: var(--font-size-hero);
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: var(--font-size-body);
  color: var(--color-text-tertiary);
  margin-bottom: 40rpx;
}

.go-discover-btn {
  background: var(--color-brand-500);
  color: var(--color-text-white);
  border-radius: var(--radius-full);
  padding: 16rpx 48rpx;
  font-size: var(--font-size-body);
}

/* 加载状态 */
.loading-state {
  padding: 16rpx;
}

.skeleton-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: 20rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}

.skeleton-image {
  width: 120rpx;
  height: 120rpx;
  background: var(--color-gray-100);
  border-radius: var(--radius-md);
  flex-shrink: 0;
}

.skeleton-info {
  flex: 1;
  margin: 0 20rpx;
}

.skeleton-line {
  height: 32rpx;
  background: var(--color-gray-100);
  border-radius: 4rpx;
  margin-bottom: 12rpx;
}

.skeleton-line.short {
  width: 60%;
}

.skeleton-line.medium {
  width: 40%;
}
