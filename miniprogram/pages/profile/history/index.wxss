/* 历史记录页样式 */
.container {
  padding: 24rpx;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.history-item {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
}

.history-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.history-time {
  font-size: 24rpx;
  color: #999999;
}

.history-score {
  display: flex;
  align-items: baseline;
}

.score-value {
  font-size: 36rpx;
  font-weight: 700;
}

.score-label {
  font-size: 22rpx;
  margin-left: 4rpx;
}

.history-product {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 32rpx;
  color: #999999;
}
