/* pages/profile/history/index.wxss */
.history-container {
  min-height: 100vh;
  background: #F2F2F7;
  padding: 24rpx;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #8E8E93;
  font-size: 28rpx;
}

.history-list {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
}

.history-item {
  padding: 28rpx 24rpx;
  border-bottom: 0.5rpx solid #F2F2F7;
  font-size: 28rpx;
  color: #1D1D1F;
}