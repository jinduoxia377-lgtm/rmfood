<!--pages/profile/history/index.wxml-->
<view class="history-container">
  <view class="empty-state" wx:if="{{!history.length}}">
    <text>暂无历史记录</text>
  </view>
  <view class="history-list" wx:else>
    <view class="history-item" wx:for="{{history}}" wx:key="id">
      <text>{{item.name || item.query}}</text>
    </view>
  </view>
</view>
