/**
 * 食品安全国家标准合规核查页面样式 - 基于 Apple HIG */

/* 页面容器 */
.page-container {
  min-height: 100vh;
  background: var(--bg-primary, var(--color-gray-100));
  display: flex;
  flex-direction: column;

  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
 }

/* 头部 */
.header {
  background: linear-gradient(135deg, var(--color-brand-500) 0%, var(--color-brand-400) 100%);
  padding-bottom: 24rpx;
}

.header-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx;
}

.hamburger {
  width: 44rpx;
  height: 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.hamburger-line {
  width: 100%;
  height: 3rpx;
  background: var(--color-text-inverse);
  border-radius: 2rpx;
  transition: opacity var(--transition-normal), transform var(--transition-normal);
}

.hamburger-line.active:nth-child(1) {
  transform: translateY(7rpx) rotate(45deg);
}

.hamburger-line.active:nth-child(2) {
  opacity: 0;
}

.hamburger-line.active:nth-child(3) {
  transform: translateY(-7rpx) rotate(-45deg);
}

.header-title .title-main {
  color: var(--color-text-inverse);
  font-size: var(--font-size-title-2);
  font-weight: 600;
}

.header-action {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-title-2);
}

/* Tab 切换 */
.tab-container {
  background: var(--color-text-inverse);
  border-bottom: 1rpx solid var(--border-color, var(--color-border));
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-scroll {
  white-space: nowrap;
}

.tab-list {
  display: flex;
  padding: 0 16rpx;
}

.tab-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 28rpx;
  border-bottom: 4rpx solid transparent;
  transition: opacity var(--transition-normal), transform var(--transition-normal);
}

.tab-item.active {
  border-bottom-color: var(--primary, var(--color-brand-500));
  color: var(--primary, var(--color-brand-500));
}

.tab-icon {
  font-size: var(--font-size-title-2);
  margin-bottom: 8rpx;
}

.tab-name {
  font-size: var(--font-size-caption);
  color: var(--text-secondary, #6B7280);
}

.tab-item.active .tab-name {
  color: var(--primary, var(--color-brand-500));
  font-weight: 600;
}

/* 内容滚动区 */
.content-scroll {
  flex: 1;
  height: calc(100vh - 280rpx);

  height: 0;
 }

.tab-content {
  padding: 24rpx 32rpx;
}

/* 卡片容器 */
.card {
  background: var(--color-text-inverse);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: var(--font-size-body);
  font-weight: 600;
  color: var(--text-primary, var(--color-text-primary));
}

.add-btn {
  font-size: var(--font-size-callout);
  color: var(--primary, var(--color-brand-500));
  font-weight: 500;
}

.subsection-title {
  font-size: var(--font-size-callout);
  font-weight: 600;
  color: var(--text-primary, var(--color-text-primary));
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--border-color, var(--color-border));
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.filter-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--bg-primary, var(--color-gray-100));
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  gap: 12rpx;
}

.filter-icon {
  font-size: var(--font-size-body);
}

.filter-input {
  flex: 1;
  font-size: var(--font-size-callout);
  background: transparent;
}

.filter-select {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 20rpx;
  background: var(--bg-primary, var(--color-gray-100));
  border-radius: 12rpx;
  font-size: var(--font-size-callout);
  color: var(--text-secondary, #6B7280);
}

.select-arrow {
  font-size: var(--font-size-fine-print);
}

/* 排序栏 */
.sort-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.sort-item {
  padding: 10rpx 24rpx;
  background: var(--bg-primary, var(--color-gray-100));
  border-radius: 20rpx;
  font-size: var(--font-size-caption);
  color: var(--text-secondary, #6B7280);
}

.sort-item.active {
  background: rgba(45, 90, 61, 0.1);
  color: var(--primary, var(--color-brand-500));
  font-weight: 600;
}

/* 标准统计 */
.std-stats .stat-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.std-stats .stat-item {
  text-align: center;
  padding: 16rpx 0;
}

.std-stats .stat-num {
  display: block;
  font-size: var(--font-size-title-1);
  font-weight: 700;
  color: var(--primary, var(--color-brand-500));
  line-height: 1;
}

.std-stats .stat-label {
  display: block;
  font-size: var(--font-size-caption);
  color: var(--text-muted, #9CA3AF);
  margin-top: 8rpx;
}

/* 标准列表 */
.standards-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.standard-item {
  background: var(--color-text-inverse);
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.std-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.std-code {
  font-size: var(--font-size-callout);
  font-weight: 600;
  color: var(--primary, var(--color-brand-500));
  font-family: monospace;
}

.std-priority {
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  font-size: var(--font-size-fine-print);
  font-weight: 600;
}

.std-priority.priority-P0 {
  background: rgba(239, 68, 68, 0.1);
  color: var(--color-danger);
}

.std-priority.priority-P1 {
  background: rgba(245, 158, 11, 0.1);
  color: var(--color-warning);
}

.std-priority.priority-P2 {
  background: rgba(107, 114, 128, 0.1);
  color: var(--color-text-tertiary);
}

.std-title {
  font-size: var(--font-size-body);
  font-weight: 600;
  color: var(--text-primary, var(--color-text-primary));
  margin-bottom: 12rpx;
  display: block;
}

.std-meta {
  display: flex;
  gap: 24rpx;
  font-size: var(--font-size-caption);
  color: var(--text-muted, #9CA3AF);
}

/* 添加剂列表 */
.additive-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.additive-item {
  background: var(--color-text-inverse);
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.additive-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.additive-name {
  font-size: var(--font-size-body);
  font-weight: 600;
  color: var(--text-primary, var(--color-text-primary));
  flex: 1;
}

.additive-function {
  padding: 6rpx 16rpx;
  background: rgba(59, 130, 246, 0.1);
  border-radius: 20rpx;
  font-size: var(--font-size-caption);
  color: var(--color-info);
  white-space: nowrap;
  margin-left: 16rpx;
}

.additive-meta {
  display: flex;
  gap: 24rpx;
  margin-bottom: 12rpx;
  font-size: var(--font-size-caption);
  color: var(--text-secondary, #6B7280);
}

.additive-usage {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 16rpx;
  background: rgba(59, 130, 246, 0.05);
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.usage-label {
  font-size: var(--font-size-caption);
  color: var(--text-muted, #9CA3AF);
}

.usage-value {
  font-size: var(--font-size-callout);
  font-weight: 600;
  color: var(--color-info);
}

.additive-categories {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.cat-tag {
  padding: 4rpx 12rpx;
  background: var(--bg-primary, var(--color-gray-100));
  border-radius: 8rpx;
  font-size: var(--font-size-caption);
  color: var(--text-secondary, #6B7280);
}

.cat-tag.purple {
  background: rgba(139, 92, 246, 0.1);
  color: var(--color-accent-500);
}

/* 药食同源列表 */
.homology-list {
  display: flex;
  flex-direction: column;
  gap: 1rpx;
  background: var(--border-color, var(--color-border));
  border-radius: 16rpx;
  overflow: hidden;
}

.homology-item {
  background: var(--color-text-inverse);
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
}

.homology-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.homology-icon {
  font-size: var(--font-size-body);
}

.homology-name {
  font-size: var(--font-size-body);
  color: var(--text-primary, var(--color-text-primary));
  font-weight: 500;
}

.homology-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.homology-dosage {
  font-size: var(--font-size-caption);
  color: var(--text-secondary, #6B7280);
}

.homology-arrow {
  font-size: var(--font-size-body);
  color: var(--text-muted, #9CA3AF);
}

/* 禁用列表 */
.prohibited-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.prohibited-item {
  background: var(--color-text-inverse);
  border-radius: 12rpx;
  padding: 20rpx;
  border-left: 4rpx solid var(--color-danger);
}

.prohibited-pair {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.pair-name {
  padding: 6rpx 16rpx;
  background: rgba(239, 68, 68, 0.1);
  border-radius: 20rpx;
  font-size: var(--font-size-caption);
  color: var(--color-danger);
  font-weight: 500;
}

.prohibited-rule {
  font-size: var(--font-size-caption);
  color: var(--text-secondary, #6B7280);
}

.prohibited-subsection {
  margin-top: 24rpx;
}

.prohibited-material {
  background: var(--color-text-inverse);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  border-left: 4rpx solid var(--color-danger);
}

.material-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.material-name {
  font-size: var(--font-size-body);
  font-weight: 600;
  color: var(--color-danger);
}

.material-category {
  padding: 4rpx 12rpx;
  background: rgba(239, 68, 68, 0.1);
  border-radius: 8rpx;
  font-size: var(--font-size-caption);
  color: var(--color-danger);
}

.material-source {
  display: block;
  font-size: var(--font-size-caption);
  color: var(--text-muted, #9CA3AF);
  margin-bottom: 8rpx;
}

.material-reason {
  display: block;
  font-size: var(--font-size-caption);
  color: var(--text-secondary, #6B7280);
}

/* 人群选择器 */
.population-selector {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.population-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  background: var(--bg-primary, var(--color-gray-100));
  border-radius: 12rpx;
  font-size: var(--font-size-callout);
  color: var(--text-secondary, #6B7280);
}

.population-item.active {
  background: rgba(45, 90, 61, 0.1);
  color: var(--primary, var(--color-brand-500));
  font-weight: 600;
}

.ingredients-section {
  margin-bottom: 24rpx;
}

.ingredient-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.ingredient-name {
  flex: 2;
  padding: 16rpx 20rpx;
  background: var(--bg-primary, var(--color-gray-100));
  border-radius: 12rpx;
  font-size: var(--font-size-callout);
}

.ingredient-dosage {
  flex: 1;
  padding: 16rpx 20rpx;
  background: var(--bg-primary, var(--color-gray-100));
  border-radius: 12rpx;
  font-size: var(--font-size-callout);
  text-align: right;
}

.remove-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(239, 68, 68, 0.1);
  border-radius: 50%;
  color: var(--color-danger);
  font-size: var(--font-size-caption);
}

.check-btn {
  width: 100%;
  padding: 28rpx 0;
  background: linear-gradient(135deg, var(--color-brand-500) 0%, var(--color-brand-400) 100%);
  color: var(--color-text-inverse);
  border-radius: 16rpx;
  font-size: var(--font-size-subtitle);
  font-weight: 600;
  border: none;
  margin-bottom: 24rpx;
}

.check-btn::after {
  border: none;
}

/* 检查结果 */
.check-result {
  margin-bottom: 24rpx;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--border-color, var(--color-border));
}

.result-score {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.score-value {
  font-size: var(--font-size-stat);
  font-weight: 700;
  line-height: 1;
}

.score-label {
  font-size: var(--font-size-caption);
  color: var(--text-muted, #9CA3AF);
}

.result-status {
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  font-size: var(--font-size-callout);
  font-weight: 600;
}

.result-status.compliant {
  background: rgba(34, 197, 94, 0.1);
  color: var(--color-success);
}

.result-status.warning {
  background: rgba(245, 158, 11, 0.1);
  color: var(--color-warning);
}

.result-status.non_compliant {
  background: rgba(239, 68, 68, 0.1);
  color: var(--color-danger);
}

/* 违规项 */
.violations-section {
  margin-bottom: 20rpx;
}

.violation-item {
  padding: 16rpx;
  background: rgba(239, 68, 68, 0.03);
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  border-left: 4rpx solid var(--color-danger);
}

.violation-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.violation-ingredient {
  font-size: var(--font-size-callout);
  font-weight: 600;
  color: var(--text-primary, var(--color-text-primary));
}

.violation-type {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: var(--font-size-caption);
}

.violation-type.type-exceeds_limit { background: rgba(239, 68, 68, 0.1); color: var(--color-danger); }
.violation-type.type-prohibited_combo { background: rgba(245, 158, 11, 0.1); color: var(--color-warning); }
.violation-type.type-child_forbidden { background: rgba(168, 85, 247, 0.1); color: var(--color-accent-600); }
.violation-type.type-not_in_directory { background: rgba(107, 114, 128, 0.1); color: var(--color-text-tertiary); }
.violation-type.type-gb2760 { background: rgba(59, 130, 246, 0.1); color: var(--color-info); }
.violation-type.type-gb14880 { background: rgba(139, 92, 246, 0.1); color: var(--color-accent-500); }
.violation-type.type-prohibited_tcm { background: rgba(239, 68, 68, 0.1); color: var(--color-danger); }

.violation-message {
  font-size: var(--font-size-caption);
  color: var(--text-secondary, #6B7280);
  display: block;
  margin-bottom: 8rpx;
}

.violation-dosage {
  display: flex;
  gap: 24rpx;
  font-size: var(--font-size-caption);
}

.dosage-label { color: var(--text-muted, #9CA3AF); }
.dosage-actual { color: var(--color-danger); font-weight: 600; }

/* 警示与建议 */
.warnings-section, .suggestions-section {
  margin-bottom: 20rpx;
}

.warning-item, .suggestion-item {
  padding: 12rpx 16rpx;
  background: rgba(245, 158, 11, 0.05);
  border-radius: 8rpx;
  margin-bottom: 8rpx;
  font-size: var(--font-size-caption);
  color: var(--text-secondary, #6B7280);
}

.suggestion-item {
  background: rgba(59, 130, 246, 0.05);
}

/* 结果操作 */
.result-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-color, var(--color-border));
}

.action-btn {
  flex: 1;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: var(--font-size-callout);
  border: none;
}

.action-btn.auto-fix {
  background: rgba(59, 130, 246, 0.1);
  color: var(--color-info);
}

.action-btn.save-btn {
  background: rgba(45, 90, 61, 0.1);
  color: var(--primary, var(--color-brand-500));
}

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 60rpx 0;
  color: var(--text-muted, #9CA3AF);
  font-size: var(--font-size-callout);
}

/* 闁诲孩顔栭崰鏍э耿闁秵鍋?*/
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}

.modal-content {
  width: 100%;
  max-width: 640rpx;
  max-height: 85vh;
  background: var(--color-text-inverse);
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
}

.modal-header {
  padding: 24rpx;
  color: var(--color-text-inverse);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.modal-title {
  font-size: var(--font-size-body);
  font-weight: 600;
  flex: 1;
  margin-right: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.modal-close {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  color: var(--color-text-inverse);
  font-size: var(--font-size-body);
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx;
}

/* 详情内容 */
.detail-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.detail-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.detail-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 16rpx;
  background: var(--bg-primary, var(--color-gray-100));
  border-radius: 12rpx;
}

.detail-label {
  font-size: var(--font-size-caption);
  color: var(--text-muted, #9CA3AF);
}

.detail-value {
  font-size: var(--font-size-callout);
  color: var(--text-primary, var(--color-text-primary));
  font-weight: 500;
}

.detail-value.danger { color: var(--color-danger); font-weight: 700; }
.detail-value.highlight { color: var(--color-info); font-weight: 700; }

.detail-section {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.detail-section-title {
  font-size: var(--font-size-caption);
  font-weight: 600;
  color: var(--text-muted, #9CA3AF);
  text-transform: uppercase;
  letter-spacing: 0.05rpx;
}

.detail-section-content {
  font-size: var(--font-size-callout);
  color: var(--text-primary, var(--color-text-primary));
  line-height: 1.6;
  padding: 16rpx;
  background: var(--bg-primary, var(--color-gray-100));
  border-radius: 12rpx;
}

.detail-section-content.pre-wrap {
  white-space: pre-wrap;
}

.detail-link {
  font-size: var(--font-size-caption);
  color: var(--primary, var(--color-brand-500));
}

.detail-hazard {
  padding: 16rpx;
  background: rgba(239, 68, 68, 0.05);
  border-radius: 12rpx;
  border-left: 4rpx solid var(--color-danger);
}

.hazard-title {
  display: block;
  font-size: var(--font-size-caption);
  font-weight: 600;
  color: var(--color-danger);
  margin-bottom: 8rpx;
}

.hazard-content {
  font-size: var(--font-size-caption);
  color: var(--text-secondary, #6B7280);
  line-height: 1.6;
}

/* 徽标 */
.badge {
  display: inline-flex;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: var(--font-size-caption);
}

.badge.success { background: rgba(34, 197, 94, 0.1); color: var(--color-success); }
.badge.default { background: rgba(107, 114, 128, 0.1); color: var(--color-text-tertiary); }
.badge.info { background: rgba(59, 130, 246, 0.1); color: var(--color-info); }
.badge.purple { background: rgba(139, 92, 246, 0.1); color: var(--color-accent-500); }
.badge.danger { background: rgba(239, 68, 68, 0.1); color: var(--color-danger); }

/* 标签列表 */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tag {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: var(--font-size-caption);
}

.tag.info { background: rgba(59, 130, 246, 0.1); color: var(--color-info); }
.tag.purple { background: rgba(139, 92, 246, 0.1); color: var(--color-accent-500); }

/* 底部间距 */
.bottom-spacing {
  height: 40rpx;
}




/* ============================================
   底部安全区适配        ============================================ */
.bottom-spacing {
  height: calc(40rpx + env(safe-area-inset-bottom));
}
