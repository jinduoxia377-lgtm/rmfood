/**
 * 合规标准 - 样式
 */

/* 页面容器 */
.page-container {
  min-height: 100vh;
  background: var(--bg-primary, #F5F5F5);
  display: flex;
  flex-direction: column;
}

/* 顶部导航 */
.header {
  background: linear-gradient(135deg, #2D5A3D 0%, #4A7C5C 100%);
  padding-bottom: 24rpx;
}

.header-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx;
}

.hamburger {
  width: 44rpx;
  height: 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.hamburger-line {
  width: 100%;
  height: 3rpx;
  background: #fff;
  border-radius: 2rpx;
  transition: all 0.3s ease;
}

.hamburger-line.active:nth-child(1) {
  transform: translateY(7rpx) rotate(45deg);
}

.hamburger-line.active:nth-child(2) {
  opacity: 0;
}

.hamburger-line.active:nth-child(3) {
  transform: translateY(-7rpx) rotate(-45deg);
}

.header-title .title-main {
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
}

.header-action {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

/* Tab 导航 */
.tab-container {
  background: #fff;
  border-bottom: 1rpx solid var(--border-color, #E5E7EB);
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-scroll {
  white-space: nowrap;
}

.tab-list {
  display: flex;
  padding: 0 16rpx;
}

.tab-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 28rpx;
  border-bottom: 4rpx solid transparent;
  transition: all 0.3s ease;
}

.tab-item.active {
  border-bottom-color: var(--primary, #2D5A3D);
  color: var(--primary, #2D5A3D);
}

.tab-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.tab-name {
  font-size: 24rpx;
  color: var(--text-secondary, #6B7280);
}

.tab-item.active .tab-name {
  color: var(--primary, #2D5A3D);
  font-weight: 600;
}

/* 内容区 */
.content-scroll {
  flex: 1;
  height: calc(100vh - 280rpx);
}

.tab-content {
  padding: 24rpx 32rpx;
}

/* 卡片通用 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary, #111827);
}

.add-btn {
  font-size: 26rpx;
  color: var(--primary, #2D5A3D);
  font-weight: 500;
}

.subsection-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary, #111827);
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--border-color, #E5E7EB);
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.filter-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--bg-primary, #F5F5F5);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  gap: 12rpx;
}

.filter-icon {
  font-size: 28rpx;
}

.filter-input {
  flex: 1;
  font-size: 26rpx;
  background: transparent;
}

.filter-select {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 20rpx;
  background: var(--bg-primary, #F5F5F5);
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--text-secondary, #6B7280);
}

.select-arrow {
  font-size: 20rpx;
}

/* 排序栏 */
.sort-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.sort-item {
  padding: 10rpx 24rpx;
  background: var(--bg-primary, #F5F5F5);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: var(--text-secondary, #6B7280);
}

.sort-item.active {
  background: rgba(45, 90, 61, 0.1);
  color: var(--primary, #2D5A3D);
  font-weight: 600;
}

/* 国家标准统计 */
.std-stats .stat-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.std-stats .stat-item {
  text-align: center;
  padding: 16rpx 0;
}

.std-stats .stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary, #2D5A3D);
  line-height: 1;
}

.std-stats .stat-label {
  display: block;
  font-size: 22rpx;
  color: var(--text-muted, #9CA3AF);
  margin-top: 8rpx;
}

/* 标准列表 */
.standards-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.standard-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.std-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.std-code {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary, #2D5A3D);
  font-family: monospace;
}

.std-priority {
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.std-priority.priority-P0 {
  background: rgba(239, 68, 68, 0.1);
  color: #EF4444;
}

.std-priority.priority-P1 {
  background: rgba(245, 158, 11, 0.1);
  color: #F59E0B;
}

.std-priority.priority-P2 {
  background: rgba(107, 114, 128, 0.1);
  color: #6B7280;
}

.std-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary, #111827);
  margin-bottom: 12rpx;
  display: block;
}

.std-meta {
  display: flex;
  gap: 24rpx;
  font-size: 24rpx;
  color: var(--text-muted, #9CA3AF);
}

/* 添加剂列表 */
.additive-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.additive-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.additive-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.additive-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary, #111827);
  flex: 1;
}

.additive-function {
  padding: 6rpx 16rpx;
  background: rgba(59, 130, 246, 0.1);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #3B82F6;
  white-space: nowrap;
  margin-left: 16rpx;
}

.additive-meta {
  display: flex;
  gap: 24rpx;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: var(--text-secondary, #6B7280);
}

.additive-usage {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 16rpx;
  background: rgba(59, 130, 246, 0.05);
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.usage-label {
  font-size: 24rpx;
  color: var(--text-muted, #9CA3AF);
}

.usage-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #3B82F6;
}

.additive-categories {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.cat-tag {
  padding: 4rpx 12rpx;
  background: var(--bg-primary, #F5F5F5);
  border-radius: 8rpx;
  font-size: 22rpx;
  color: var(--text-secondary, #6B7280);
}

.cat-tag.purple {
  background: rgba(139, 92, 246, 0.1);
  color: #8B5CF6;
}

/* 药食同源列表 */
.homology-list {
  display: flex;
  flex-direction: column;
  gap: 1rpx;
  background: var(--border-color, #E5E7EB);
  border-radius: 16rpx;
  overflow: hidden;
}

.homology-item {
  background: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
}

.homology-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.homology-icon {
  font-size: 28rpx;
}

.homology-name {
  font-size: 28rpx;
  color: var(--text-primary, #111827);
  font-weight: 500;
}

.homology-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.homology-dosage {
  font-size: 24rpx;
  color: var(--text-secondary, #6B7280);
}

.homology-arrow {
  font-size: 28rpx;
  color: var(--text-muted, #9CA3AF);
}

/* 禁忌列表 */
.prohibited-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.prohibited-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  border-left: 4rpx solid #EF4444;
}

.prohibited-pair {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.pair-name {
  padding: 6rpx 16rpx;
  background: rgba(239, 68, 68, 0.1);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #DC2626;
  font-weight: 500;
}

.prohibited-rule {
  font-size: 24rpx;
  color: var(--text-secondary, #6B7280);
}

.prohibited-subsection {
  margin-top: 24rpx;
}

.prohibited-material {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  border-left: 4rpx solid #EF4444;
}

.material-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.material-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #DC2626;
}

.material-category {
  padding: 4rpx 12rpx;
  background: rgba(239, 68, 68, 0.1);
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #DC2626;
}

.material-source {
  display: block;
  font-size: 24rpx;
  color: var(--text-muted, #9CA3AF);
  margin-bottom: 8rpx;
}

.material-reason {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary, #6B7280);
}

/* 合规检查 */
.population-selector {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.population-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  background: var(--bg-primary, #F5F5F5);
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--text-secondary, #6B7280);
}

.population-item.active {
  background: rgba(45, 90, 61, 0.1);
  color: var(--primary, #2D5A3D);
  font-weight: 600;
}

.ingredients-section {
  margin-bottom: 24rpx;
}

.ingredient-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.ingredient-name {
  flex: 2;
  padding: 16rpx 20rpx;
  background: var(--bg-primary, #F5F5F5);
  border-radius: 12rpx;
  font-size: 26rpx;
}

.ingredient-dosage {
  flex: 1;
  padding: 16rpx 20rpx;
  background: var(--bg-primary, #F5F5F5);
  border-radius: 12rpx;
  font-size: 26rpx;
  text-align: right;
}

.remove-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(239, 68, 68, 0.1);
  border-radius: 50%;
  color: #EF4444;
  font-size: 24rpx;
}

.check-btn {
  width: 100%;
  padding: 28rpx 0;
  background: linear-gradient(135deg, #2D5A3D 0%, #4A7C5C 100%);
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  margin-bottom: 24rpx;
}

.check-btn::after {
  border: none;
}

/* 检查结果 */
.check-result {
  margin-bottom: 24rpx;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--border-color, #E5E7EB);
}

.result-score {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.score-value {
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1;
}

.score-label {
  font-size: 24rpx;
  color: var(--text-muted, #9CA3AF);
}

.result-status {
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.result-status.compliant {
  background: rgba(34, 197, 94, 0.1);
  color: #16A34A;
}

.result-status.warning {
  background: rgba(245, 158, 11, 0.1);
  color: #D97706;
}

.result-status.non_compliant {
  background: rgba(239, 68, 68, 0.1);
  color: #DC2626;
}

/* 违规项 */
.violations-section {
  margin-bottom: 20rpx;
}

.violation-item {
  padding: 16rpx;
  background: rgba(239, 68, 68, 0.03);
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  border-left: 4rpx solid #EF4444;
}

.violation-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.violation-ingredient {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary, #111827);
}

.violation-type {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.violation-type.type-exceeds_limit { background: rgba(239, 68, 68, 0.1); color: #DC2626; }
.violation-type.type-prohibited_combo { background: rgba(245, 158, 11, 0.1); color: #D97706; }
.violation-type.type-child_forbidden { background: rgba(168, 85, 247, 0.1); color: #7C3AED; }
.violation-type.type-not_in_directory { background: rgba(107, 114, 128, 0.1); color: #6B7280; }
.violation-type.type-gb2760 { background: rgba(59, 130, 246, 0.1); color: #3B82F6; }
.violation-type.type-gb14880 { background: rgba(139, 92, 246, 0.1); color: #8B5CF6; }
.violation-type.type-prohibited_tcm { background: rgba(239, 68, 68, 0.1); color: #DC2626; }

.violation-message {
  font-size: 24rpx;
  color: var(--text-secondary, #6B7280);
  display: block;
  margin-bottom: 8rpx;
}

.violation-dosage {
  display: flex;
  gap: 24rpx;
  font-size: 22rpx;
}

.dosage-label { color: var(--text-muted, #9CA3AF); }
.dosage-actual { color: #DC2626; font-weight: 600; }

/* 警告和建议 */
.warnings-section, .suggestions-section {
  margin-bottom: 20rpx;
}

.warning-item, .suggestion-item {
  padding: 12rpx 16rpx;
  background: rgba(245, 158, 11, 0.05);
  border-radius: 8rpx;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary, #6B7280);
}

.suggestion-item {
  background: rgba(59, 130, 246, 0.05);
}

/* 操作按钮 */
.result-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-color, #E5E7EB);
}

.action-btn {
  flex: 1;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  border: none;
}

.action-btn.auto-fix {
  background: rgba(59, 130, 246, 0.1);
  color: #3B82F6;
}

.action-btn.save-btn {
  background: rgba(45, 90, 61, 0.1);
  color: var(--primary, #2D5A3D);
}

/* 加载和空状态 */
.loading-state {
  text-align: center;
  padding: 60rpx 0;
  color: var(--text-muted, #9CA3AF);
  font-size: 26rpx;
}

/* 弹窗 */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(4rpx);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}

.modal-content {
  width: 100%;
  max-width: 640rpx;
  max-height: 85vh;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
}

.modal-header {
  padding: 24rpx;
  color: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.modal-title {
  font-size: 28rpx;
  font-weight: 600;
  flex: 1;
  margin-right: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.modal-close {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  color: #fff;
  font-size: 28rpx;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx;
}

/* 详情内容 */
.detail-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.detail-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.detail-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 16rpx;
  background: var(--bg-primary, #F5F5F5);
  border-radius: 12rpx;
}

.detail-label {
  font-size: 22rpx;
  color: var(--text-muted, #9CA3AF);
}

.detail-value {
  font-size: 26rpx;
  color: var(--text-primary, #111827);
  font-weight: 500;
}

.detail-value.danger { color: #DC2626; font-weight: 700; }
.detail-value.highlight { color: #3B82F6; font-weight: 700; }

.detail-section {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.detail-section-title {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-muted, #9CA3AF);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.detail-section-content {
  font-size: 26rpx;
  color: var(--text-primary, #111827);
  line-height: 1.6;
  padding: 16rpx;
  background: var(--bg-primary, #F5F5F5);
  border-radius: 12rpx;
}

.detail-section-content.pre-wrap {
  white-space: pre-wrap;
}

.detail-link {
  font-size: 24rpx;
  color: var(--primary, #2D5A3D);
}

.detail-hazard {
  padding: 16rpx;
  background: rgba(239, 68, 68, 0.05);
  border-radius: 12rpx;
  border-left: 4rpx solid #EF4444;
}

.hazard-title {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: #DC2626;
  margin-bottom: 8rpx;
}

.hazard-content {
  font-size: 24rpx;
  color: var(--text-secondary, #6B7280);
  line-height: 1.6;
}

/* 徽章 */
.badge {
  display: inline-flex;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.badge.success { background: rgba(34, 197, 94, 0.1); color: #16A34A; }
.badge.default { background: rgba(107, 114, 128, 0.1); color: #6B7280; }
.badge.info { background: rgba(59, 130, 246, 0.1); color: #3B82F6; }
.badge.purple { background: rgba(139, 92, 246, 0.1); color: #8B5CF6; }
.badge.danger { background: rgba(239, 68, 68, 0.1); color: #DC2626; }

/* 标签列表 */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tag {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.tag.info { background: rgba(59, 130, 246, 0.1); color: #3B82F6; }
.tag.purple { background: rgba(139, 92, 246, 0.1); color: #8B5CF6; }

/* 底部间距 */
.bottom-spacing {
  height: 40rpx;
}
