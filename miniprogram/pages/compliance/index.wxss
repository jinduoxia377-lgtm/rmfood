/**
 * 闂備礁鎲￠懝楣冩偋閹板府缍栧鑸靛姇閸愨偓闂佹悶鍎滈崘鈺冨讲 - 闂備礁鎼粔鎾床閼碱剚顫? */

/* 濠碉紕鍋戦崐妤呭极鐠囧樊鐒介柟娈垮枓閸嬫捇宕烽鐔锋畬濠?*/
.page-container {
  min-height: 100vh;
  background: var(--bg-primary, var(--color-gray-100));
  display: flex;
  flex-direction: column;

  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
 }

/* 濠碉紕鍋戦崐鏇㈡偉婵傜纾块悗鐢电《閸嬫挻鎷呴崘顭戞闂?*/
.header {
  background: linear-gradient(135deg, var(--color-brand-500) 0%, var(--color-brand-400) 100%);
  padding-bottom: 24rpx;
}

.header-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx;
}

.hamburger {
  width: 44rpx;
  height: 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.hamburger-line {
  width: 100%;
  height: 3rpx;
  background: var(--color-text-inverse);
  border-radius: 2rpx;
  transition: opacity var(--transition-normal), transform var(--transition-normal);
}

.hamburger-line.active:nth-child(1) {
  transform: translateY(7rpx) rotate(45deg);
}

.hamburger-line.active:nth-child(2) {
  opacity: 0;
}

.hamburger-line.active:nth-child(3) {
  transform: translateY(-7rpx) rotate(-45deg);
}

.header-title .title-main {
  color: var(--color-text-inverse);
  font-size: 36rpx;
  font-weight: 600;
}

.header-action {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

/* Tab 闂佽绨肩徊缁樼珶閸儱鏄?*/
.tab-container {
  background: var(--color-text-inverse);
  border-bottom: 1rpx solid var(--border-color, var(--color-border));
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-scroll {
  white-space: nowrap;
}

.tab-list {
  display: flex;
  padding: 0 16rpx;
}

.tab-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 28rpx;
  border-bottom: 4rpx solid transparent;
  transition: opacity var(--transition-normal), transform var(--transition-normal);
}

.tab-item.active {
  border-bottom-color: var(--primary, var(--color-brand-500));
  color: var(--primary, var(--color-brand-500));
}

.tab-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.tab-name {
  font-size: 24rpx;
  color: var(--text-secondary, #6B7280);
}

.tab-item.active .tab-name {
  color: var(--primary, var(--color-brand-500));
  font-weight: 600;
}

/* 闂備礁鎲￠崝鏇㈠箠鎼搭煈鏁婇柟鐗堟緲缁€?*/
.content-scroll {
  flex: 1;
  height: calc(100vh - 280rpx);

  height: 0;
 }

.tab-content {
  padding: 24rpx 32rpx;
}

/* 闂備礁鎲￠〃鎰閺囩喐娅犻柡宥庡幗閻掔粯鎱ㄥΟ鍧楀摵闁?*/
.card {
  background: var(--color-text-inverse);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary, var(--color-text-primary));
}

.add-btn {
  font-size: 26rpx;
  color: var(--primary, var(--color-brand-500));
  font-weight: 500;
}

.subsection-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary, var(--color-text-primary));
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--border-color, var(--color-border));
}

/* 缂傚倷鐒︾粙鎺楁儎椤栫偛鐒垫い鎺嗗亾妞わ缚鍗抽幃?*/
.filter-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.filter-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--bg-primary, var(--color-gray-100));
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  gap: 12rpx;
}

.filter-icon {
  font-size: 28rpx;
}

.filter-input {
  flex: 1;
  font-size: 26rpx;
  background: transparent;
}

.filter-select {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 20rpx;
  background: var(--bg-primary, var(--color-gray-100));
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--text-secondary, #6B7280);
}

.select-arrow {
  font-size: 20rpx;
}

/* 闂備礁婀遍崕銈囨暜閹烘棁濮虫い鎾卞灩閸愨偓?*/
.sort-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.sort-item {
  padding: 10rpx 24rpx;
  background: var(--bg-primary, var(--color-gray-100));
  border-radius: 20rpx;
  font-size: 24rpx;
  color: var(--text-secondary, #6B7280);
}

.sort-item.active {
  background: rgba(45, 90, 61, 0.1);
  color: var(--primary, var(--color-brand-500));
  font-weight: 600;
}

/* 闂備焦鎮堕崕鏉懳涢崟顖ｆ晩鐎广儱顦崘鈧梺鎼炲劀閸愨晝褰茬紓鍌氬€烽懗鍫曞窗閺囥埄鏁?*/
.std-stats .stat-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.std-stats .stat-item {
  text-align: center;
  padding: 16rpx 0;
}

.std-stats .stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary, var(--color-brand-500));
  line-height: 1;
}

.std-stats .stat-label {
  display: block;
  font-size: 22rpx;
  color: var(--text-muted, #9CA3AF);
  margin-top: 8rpx;
}

/* 闂備礁鎼粔鏉懨洪妶澶婇棷妞ゆ牜鍋涚粈鍡樹繆閵堝懎顏ラ柍?*/
.standards-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.standard-item {
  background: var(--color-text-inverse);
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.std-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.std-code {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary, var(--color-brand-500));
  font-family: monospace;
}

.std-priority {
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.std-priority.priority-P0 {
  background: rgba(239, 68, 68, 0.1);
  color: var(--color-danger);
}

.std-priority.priority-P1 {
  background: rgba(245, 158, 11, 0.1);
  color: var(--color-warning);
}

.std-priority.priority-P2 {
  background: rgba(107, 114, 128, 0.1);
  color: var(--color-text-tertiary);
}

.std-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary, var(--color-text-primary));
  margin-bottom: 12rpx;
  display: block;
}

.std-meta {
  display: flex;
  gap: 24rpx;
  font-size: 24rpx;
  color: var(--text-muted, #9CA3AF);
}

/* 婵犵數鍎戠紞鈧い鏇嗗嫭鍙忛柣鎰惈缁€鍫ユ煕鐏炴崘澹橀柣蹇旂懇閹?*/
.additive-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.additive-item {
  background: var(--color-text-inverse);
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.additive-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.additive-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary, var(--color-text-primary));
  flex: 1;
}

.additive-function {
  padding: 6rpx 16rpx;
  background: rgba(59, 130, 246, 0.1);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: var(--color-info);
  white-space: nowrap;
  margin-left: 16rpx;
}

.additive-meta {
  display: flex;
  gap: 24rpx;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: var(--text-secondary, #6B7280);
}

.additive-usage {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 16rpx;
  background: rgba(59, 130, 246, 0.05);
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.usage-label {
  font-size: 24rpx;
  color: var(--text-muted, #9CA3AF);
}

.usage-value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-info);
}

.additive-categories {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.cat-tag {
  padding: 4rpx 12rpx;
  background: var(--bg-primary, var(--color-gray-100));
  border-radius: 8rpx;
  font-size: 22rpx;
  color: var(--text-secondary, #6B7280);
}

.cat-tag.purple {
  background: rgba(139, 92, 246, 0.1);
  color: var(--color-accent-500);
}

/* 闂備浇鍋愰悺鏃堝垂閸泙澶愬Χ婢跺﹨袝闁诲繒鍋涙晶浠嬫偉闁秵鐓曢柟鐑樻惄濞堟瑩鏌?*/
.homology-list {
  display: flex;
  flex-direction: column;
  gap: 1rpx;
  background: var(--border-color, var(--color-border));
  border-radius: 16rpx;
  overflow: hidden;
}

.homology-item {
  background: var(--color-text-inverse);
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
}

.homology-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.homology-icon {
  font-size: 28rpx;
}

.homology-name {
  font-size: 28rpx;
  color: var(--text-primary, var(--color-text-primary));
  font-weight: 500;
}

.homology-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.homology-dosage {
  font-size: 24rpx;
  color: var(--text-secondary, #6B7280);
}

.homology-arrow {
  font-size: 28rpx;
  color: var(--text-muted, #9CA3AF);
}

/* 缂傚倷绀侀崐椋庣矆娴ｇ儤宕插鑸靛姇缁€鍡樹繆閵堝懎顏ラ柍?*/
.prohibited-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.prohibited-item {
  background: var(--color-text-inverse);
  border-radius: 12rpx;
  padding: 20rpx;
  border-left: 4rpx solid var(--color-danger);
}

.prohibited-pair {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.pair-name {
  padding: 6rpx 16rpx;
  background: rgba(239, 68, 68, 0.1);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: var(--color-danger);
  font-weight: 500;
}

.prohibited-rule {
  font-size: 24rpx;
  color: var(--text-secondary, #6B7280);
}

.prohibited-subsection {
  margin-top: 24rpx;
}

.prohibited-material {
  background: var(--color-text-inverse);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  border-left: 4rpx solid var(--color-danger);
}

.material-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.material-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-danger);
}

.material-category {
  padding: 4rpx 12rpx;
  background: rgba(239, 68, 68, 0.1);
  border-radius: 8rpx;
  font-size: 22rpx;
  color: var(--color-danger);
}

.material-source {
  display: block;
  font-size: 24rpx;
  color: var(--text-muted, #9CA3AF);
  margin-bottom: 8rpx;
}

.material-reason {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary, #6B7280);
}

/* 闂備礁鎲￠懝楣冩偋閹板府缍栧璺好″☉銏犵劦妞ゆ帒瀚拑?*/
.population-selector {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.population-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  background: var(--bg-primary, var(--color-gray-100));
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--text-secondary, #6B7280);
}

.population-item.active {
  background: rgba(45, 90, 61, 0.1);
  color: var(--primary, var(--color-brand-500));
  font-weight: 600;
}

.ingredients-section {
  margin-bottom: 24rpx;
}

.ingredient-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.ingredient-name {
  flex: 2;
  padding: 16rpx 20rpx;
  background: var(--bg-primary, var(--color-gray-100));
  border-radius: 12rpx;
  font-size: 26rpx;
}

.ingredient-dosage {
  flex: 1;
  padding: 16rpx 20rpx;
  background: var(--bg-primary, var(--color-gray-100));
  border-radius: 12rpx;
  font-size: 26rpx;
  text-align: right;
}

.remove-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(239, 68, 68, 0.1);
  border-radius: 50%;
  color: var(--color-danger);
  font-size: 24rpx;
}

.check-btn {
  width: 100%;
  padding: 28rpx 0;
  background: linear-gradient(135deg, var(--color-brand-500) 0%, var(--color-brand-400) 100%);
  color: var(--color-text-inverse);
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  margin-bottom: 24rpx;
}

.check-btn::after {
  border: none;
}

/* 婵犵妲呴崑鈧柛瀣崌閺岋紕浠︾拠鎻掑Б缂備緡鍠撻崝鎴濐嚕?*/
.check-result {
  margin-bottom: 24rpx;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--border-color, var(--color-border));
}

.result-score {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.score-value {
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1;
}

.score-label {
  font-size: 24rpx;
  color: var(--text-muted, #9CA3AF);
}

.result-status {
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.result-status.compliant {
  background: rgba(34, 197, 94, 0.1);
  color: var(--color-success);
}

.result-status.warning {
  background: rgba(245, 158, 11, 0.1);
  color: var(--color-warning);
}

.result-status.non_compliant {
  background: rgba(239, 68, 68, 0.1);
  color: var(--color-danger);
}

/* 闂佸搫顦弲婊呮崲閸℃冻缍栧璺侯儍娴?*/
.violations-section {
  margin-bottom: 20rpx;
}

.violation-item {
  padding: 16rpx;
  background: rgba(239, 68, 68, 0.03);
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  border-left: 4rpx solid var(--color-danger);
}

.violation-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.violation-ingredient {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary, var(--color-text-primary));
}

.violation-type {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.violation-type.type-exceeds_limit { background: rgba(239, 68, 68, 0.1); color: var(--color-danger); }
.violation-type.type-prohibited_combo { background: rgba(245, 158, 11, 0.1); color: var(--color-warning); }
.violation-type.type-child_forbidden { background: rgba(168, 85, 247, 0.1); color: var(--color-accent-600); }
.violation-type.type-not_in_directory { background: rgba(107, 114, 128, 0.1); color: var(--color-text-tertiary); }
.violation-type.type-gb2760 { background: rgba(59, 130, 246, 0.1); color: var(--color-info); }
.violation-type.type-gb14880 { background: rgba(139, 92, 246, 0.1); color: var(--color-accent-500); }
.violation-type.type-prohibited_tcm { background: rgba(239, 68, 68, 0.1); color: var(--color-danger); }

.violation-message {
  font-size: 24rpx;
  color: var(--text-secondary, #6B7280);
  display: block;
  margin-bottom: 8rpx;
}

.violation-dosage {
  display: flex;
  gap: 24rpx;
  font-size: 22rpx;
}

.dosage-label { color: var(--text-muted, #9CA3AF); }
.dosage-actual { color: var(--color-danger); font-weight: 600; }

/* 闂佽崵濮崑鎾绘煥閺囨浜鹃梺纭咁嚋缁绘繂鐣烽鍡曟勃闁伙絽鐬兼径鍕煟?*/
.warnings-section, .suggestions-section {
  margin-bottom: 20rpx;
}

.warning-item, .suggestion-item {
  padding: 12rpx 16rpx;
  background: rgba(245, 158, 11, 0.05);
  border-radius: 8rpx;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary, #6B7280);
}

.suggestion-item {
  background: rgba(59, 130, 246, 0.05);
}

/* 闂備胶鎳撻悘婵堢矓瀹曞洨绀婇柡鍐ㄧ墕缁犳澘顭块懜闈涘閻?*/
.result-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-color, var(--color-border));
}

.action-btn {
  flex: 1;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  border: none;
}

.action-btn.auto-fix {
  background: rgba(59, 130, 246, 0.1);
  color: var(--color-info);
}

.action-btn.save-btn {
  background: rgba(45, 90, 61, 0.1);
  color: var(--primary, var(--color-brand-500));
}

/* 闂備礁鎲″缁樻叏閹灐褰掑炊椤掆偓濡炵晫鈧厜鍋撻柍褜鍓熼崺鐐哄冀椤撶喎浜归梺鐓庢憸椤ｄ粙宕?*/
.loading-state {
  text-align: center;
  padding: 60rpx 0;
  color: var(--text-muted, #9CA3AF);
  font-size: 26rpx;
}

/* 闁诲孩顔栭崰鏍э耿闁秵鍋?*/
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}

.modal-content {
  width: 100%;
  max-width: 640rpx;
  max-height: 85vh;
  background: var(--color-text-inverse);
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
}

.modal-header {
  padding: 24rpx;
  color: var(--color-text-inverse);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.modal-title {
  font-size: 28rpx;
  font-weight: 600;
  flex: 1;
  margin-right: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.modal-close {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  color: var(--color-text-inverse);
  font-size: 28rpx;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx;
}

/* 闂佽崵濮村ù鍕⒔閸曨垰纾块煫鍥ㄧ☉缁€鍐煕濞戝崬寮鹃柛?*/
.detail-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.detail-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.detail-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 16rpx;
  background: var(--bg-primary, var(--color-gray-100));
  border-radius: 12rpx;
}

.detail-label {
  font-size: 22rpx;
  color: var(--text-muted, #9CA3AF);
}

.detail-value {
  font-size: 26rpx;
  color: var(--text-primary, var(--color-text-primary));
  font-weight: 500;
}

.detail-value.danger { color: var(--color-danger); font-weight: 700; }
.detail-value.highlight { color: var(--color-info); font-weight: 700; }

.detail-section {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.detail-section-title {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-muted, #9CA3AF);
  text-transform: uppercase;
  letter-spacing: 0.05rpx;
}

.detail-section-content {
  font-size: 26rpx;
  color: var(--text-primary, var(--color-text-primary));
  line-height: 1.6;
  padding: 16rpx;
  background: var(--bg-primary, var(--color-gray-100));
  border-radius: 12rpx;
}

.detail-section-content.pre-wrap {
  white-space: pre-wrap;
}

.detail-link {
  font-size: 24rpx;
  color: var(--primary, var(--color-brand-500));
}

.detail-hazard {
  padding: 16rpx;
  background: rgba(239, 68, 68, 0.05);
  border-radius: 12rpx;
  border-left: 4rpx solid var(--color-danger);
}

.hazard-title {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-danger);
  margin-bottom: 8rpx;
}

.hazard-content {
  font-size: 24rpx;
  color: var(--text-secondary, #6B7280);
  line-height: 1.6;
}

/* 闁诲骸鐏氭竟鍡涘疾椤愶附鍋?*/
.badge {
  display: inline-flex;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.badge.success { background: rgba(34, 197, 94, 0.1); color: var(--color-success); }
.badge.default { background: rgba(107, 114, 128, 0.1); color: var(--color-text-tertiary); }
.badge.info { background: rgba(59, 130, 246, 0.1); color: var(--color-info); }
.badge.purple { background: rgba(139, 92, 246, 0.1); color: var(--color-accent-500); }
.badge.danger { background: rgba(239, 68, 68, 0.1); color: var(--color-danger); }

/* 闂備礁鎼粔鏉懨洪妸鈺婃晢闁绘垼妫勭粈鍡樹繆閵堝懎顏ラ柍?*/
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tag {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.tag.info { background: rgba(59, 130, 246, 0.1); color: var(--color-info); }
.tag.purple { background: rgba(139, 92, 246, 0.1); color: var(--color-accent-500); }

/* 闂佸湱鍘ч悺銊ッ洪悢鐓庣？闁圭虎鍠楅埛鎺旂棯閹屽剳闁?*/
.bottom-spacing {
  height: 40rpx;
}




/* ============================================
   閹煎瓨娲熼崕瀵糕偓鐟邦槸閸欏繘宕?   ============================================ */
.bottom-spacing {
  height: calc(40rpx + env(safe-area-inset-bottom));
}
