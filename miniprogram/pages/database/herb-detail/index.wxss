/* 药材详情页样式 */
.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--color-bg-page) 0%, var(--color-bg-card) 100%);
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

/* 顶部导航 */
.header {
  background: linear-gradient(135deg, var(--color-brand-500) 0%, var(--color-brand-400) 100%);
  padding: 0 24rpx;
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-content {
  display: flex;
  align-items: center;
  height: 88rpx;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
}

.back-icon {
  font-size: var(--font-size-3xl);
  color: var(--color-bg-card);
  font-weight: 300;
  line-height: 1;
}

.header-title {
  flex: 1;
  text-align: center;
}

.title-main {
  color: var(--color-bg-card);
  font-size: var(--font-size-title-3);
  font-weight: 500;
}

.header-actions {
  width: 64rpx;
  display: flex;
  justify-content: flex-end;
}

.action-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
}

.action-icon {
  font-size: var(--font-size-title-2);
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 3rpx solid var(--color-border-light);
  border-top-color: var(--color-brand-500);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 24rpx;
  color: var(--color-text-placeholder);
  font-size: var(--font-size-body);
}

/* 内容区 */
.content-scroll {
  height: calc(100vh - 88rpx);
  padding: 24rpx;
  box-sizing: border-box;
}

/* 基本信息卡片 */
.info-card {
  background: var(--color-bg-card);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.herb-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 28rpx;
}

.herb-name-section {
  flex: 1;
}

.herb-name {
  display: block;
  font-size: var(--font-size-title-1);
  font-weight: 600;
  color: var(--color-brand-500);
  margin-bottom: 8rpx;
}

.herb-latin {
  display: block;
  font-size: var(--font-size-callout);
  color: var(--color-text-placeholder);
  font-style: italic;
}

.herb-badges {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.badge {
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
  font-size: var(--font-size-caption);
  font-weight: 500;
}

.badge.homology {
  background: linear-gradient(135deg, var(--color-warning), var(--color-warning));
  color: var(--color-text-inverse);
}

.badge.category {
  background: var(--color-bg-hover);
  color: var(--color-text-tertiary);
}

.herb-meta {
  display: flex;
  justify-content: space-between;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--color-bg-hover);
}

.meta-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.meta-label {
  font-size: var(--font-size-caption);
  color: var(--color-text-placeholder);
  margin-bottom: 8rpx;
}

.meta-value {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  font-weight: 500;
}

.nature-ping { color: var(--color-success-text); }
.nature-han { color: var(--color-info-text); }
.nature-liang { color: var(--color-accent-300); }
.nature-wen { color: var(--color-warning-text); }
.nature-re { color: var(--color-danger-text); }

/* 区块卡片 */
.section-card {
  background: var(--color-bg-card);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.section-card.warning {
  border-left: 4rpx solid var(--color-warning);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: var(--font-size-subtitle);
  font-weight: 600;
  color: var(--color-text-secondary);
}

.section-more {
  font-size: var(--font-size-callout);
  color: var(--color-brand-500);
}

.section-stats {
  font-size: var(--font-size-caption);
  color: var(--color-text-placeholder);
}

.section-content {
  padding: 8rpx 0;
}

.content-text {
  font-size: var(--font-size-body);
  line-height: 1.8;
  color: var(--color-text-tertiary);
}

/* 化合物列表 */
.compound-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.compound-item {
  padding: 20rpx 24rpx;
  background: var(--color-bg-tertiary);
  border-radius: 16rpx;
}

.compound-name {
  display: block;
  font-size: var(--font-size-body);
  font-weight: 500;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.compound-meta {
  display: flex;
  gap: 24rpx;
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
}

.compound-mw { color: var(--color-brand-500); }
.compound-ob { color: var(--color-warning-text); }
.compound-dl { color: var(--color-info-text); }

/* 知识图谱 */
.graph-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.graph-node {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 20rpx;
  background: var(--color-bg-tertiary);
  border-radius: 16rpx;
  font-size: var(--font-size-callout);
}

.node-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}

.node-dot.herb { background: var(--color-brand-500); }
.node-dot.compound { background: var(--color-warning); }
.node-dot.target { background: var(--color-info); }
.node-dot.disease { background: var(--color-danger); }

.node-label {
  color: var(--color-text-secondary);
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 使用注意 */
.warning-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
}

.warning-icon {
  font-size: var(--font-size-body);
}

.warning-text {
  font-size: var(--font-size-body);
  color: var(--color-text-tertiary);
}

.no-warning {
  padding: 12rpx 0;
}

.safe-text {
  font-size: var(--font-size-body);
  color: var(--color-success-text);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: var(--font-size-hero-xl);
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: var(--font-size-body);
  color: var(--color-text-placeholder);
}

/* 底部安全区 */
.bottom-spacing {
  height: calc(40rpx + env(safe-area-inset-bottom));
}
