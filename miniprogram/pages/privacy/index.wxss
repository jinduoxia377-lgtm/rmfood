/* 闅愮鏀跨瓥椤垫牱寮?*/
.container {
  padding: 24rpx;
  background-color: var(--color-gray-100);
}

.content-card {
  background-color: var(--color-bg-card);
  border-radius: 24rpx;
  padding: 32rpx;
}

.content-header {
  margin-bottom: 32rpx;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.update-time {
  font-size: 24rpx;
  color: var(--color-text-placeholder);
}

.content-body {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}

.section-content {
  font-size: 28rpx;
  color: var(--color-text-tertiary);
  line-height: 1.8;
}

.sub-section {
  padding-left: 24rpx;
  margin-top: 16rpx;
}

.sub-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.sub-content {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  line-height: 1.6;
}

/* ============================================
   底部安全区
   ============================================ */
.bottom-spacing {
  height: calc(40rpx + env(safe-area-inset-bottom));
}
