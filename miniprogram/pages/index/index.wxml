<!-- 
  药食同源配方平台 - 首页
  使用项目现有组件：Icon, Avatar, SkeletonLoader, Tag
-->

<view class="page-container">
  
  <!-- ==================== 顶部导航（固定） ==================== -->
  <view class="header" style="padding-top: {{statusBarHeight}}px;">
    <view class="header-top">
      <view class="brand">
        <text class="brand-title">药食同源</text>
        <text class="brand-subtitle">配方设计平台</text>
      </view>
      <view class="header-actions">
        <view class="action-btn" bindtap="goToSearch">
          <icon name="search" size="md" color="#007AFF" />
        </view>
        <view class="action-btn" bindtap="goToProfile">
          <avatar src="{{userInfo && userInfo.avatar_url || ''}}" size="sm" />
        </view>
      </view>
    </view>
    
    <!-- 搜索框 -->
    <view class="search-bar" bindtap="goToSearch">
      <icon name="search" size="sm" color="#8E8E93" />
      <text class="search-placeholder">搜索食材、配方、健康知识...</text>
    </view>
  </view>
  
  <!-- ==================== 滚动内容区 ==================== -->
  <scroll-view 
    class="content"
    style="margin-top: {{headerHeight}}px;"
    scroll-y
    refresher-enabled
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onPullDownRefresh"
    bindscrolltolower="onReachBottom"
    lower-threshold="100"
  >
    
    <!-- 骨架屏 -->
    <skeleton-loader wx:if="{{showSkeleton}}" type="list" count="4" />
    
    <!-- 实际内容 -->
    <view wx:if="{{!showSkeleton}}" class="body">
      
      <!-- ===== 快捷功能 ===== -->
      <view class="section">
        <view class="section-header">
          <text class="section-title">快捷功能</text>
        </view>
        
        <view class="quick-grid">
          <!-- AI顾问 -->
          <view class="quick-item" bindtap="startAiChat">
            <view class="quick-icon blue">
              <icon name="ai" size="lg" color="#FFFFFF" />
            </view>
            <text class="quick-name">AI顾问</text>
            <text class="quick-desc">智能配方设计</text>
          </view>
          
          <!-- 配料分析 -->
          <view class="quick-item" bindtap="startIngredientAnalysis">
            <view class="quick-icon green">
              <icon name="ingredient" size="lg" color="#FFFFFF" />
            </view>
            <text class="quick-name">配料分析</text>
            <text class="quick-desc">拍照识别成分</text>
          </view>
          
          <!-- 配方库 -->
          <view class="quick-item" bindtap="goToFormulas">
            <view class="quick-icon orange">
              <icon name="formula" size="lg" color="#FFFFFF" />
            </view>
            <text class="quick-name">配方库</text>
            <text class="quick-desc">精选药膳配方</text>
          </view>
          
          <!-- 历史记录 -->
          <view class="quick-item" bindtap="goToHistory">
            <view class="quick-icon purple">
              <icon name="history" size="lg" color="#FFFFFF" />
            </view>
            <text class="quick-name">历史记录</text>
          </view>
          
          <!-- 数据库 -->
          <view class="quick-item" bindtap="goToDatabase">
            <view class="quick-icon teal">
              <icon name="database" size="lg" color="#FFFFFF" />
            </view>
            <text class="quick-name">数据库</text>
            <text class="quick-desc">药材肽类检索</text>
          </view>
          
          <!-- 合规标准 -->
          <view class="quick-item" bindtap="goToCompliance">
            <view class="quick-icon red">
              <icon name="compliance" size="lg" color="#FFFFFF" />
            </view>
            <text class="quick-name">合规标准</text>
            <text class="quick-desc">食药物质查询</text>
          </view>
        </view>
      </view>
      
      <!-- ===== 今日推荐 ===== -->
      <view class="section" wx:if="{{featuredFormula}}">
        <view class="section-header">
          <text class="section-title">今日推荐</text>
          <view class="more" bindtap="goToFormulas">
            <text>查看全部</text>
            <icon name="arrow-right" size="xs" color="#007AFF" />
          </view>
        </view>
        
        <view class="featured-card" bindtap="viewFormulaDetail" data-id="{{featuredFormula.id}}">
          <view class="featured-body">
            <text class="featured-title">{{featuredFormula.title}}</text>
            <text class="featured-subtitle">{{featuredFormula.subtitle}}</text>
            <view class="featured-tags">
              <tag wx:for="{{featuredFormula.tags}}" wx:key="index" wx:for-item="tag" type="{{tag.type}}">{{tag.text}}</tag>
            </view>
          </view>
        </view>
      </view>
      
      <!-- ===== 健康提示 ===== -->
      <view class="section" wx:if="{{healthTips.length > 0}}">
        <view class="section-header">
          <text class="section-title">健康提示</text>
        </view>
        
        <scroll-view class="tip-scroll" scroll-x show-scrollbar="{{false}}">
          <view class="tip-list">
            <view 
              wx:for="{{healthTips}}" 
              wx:key="index"
              class="tip-card"
              bindtap="viewTipDetail"
              data-index="{{index}}"
            >
              <tag class="tip-tag" type="{{item.type}}">{{item.tag}}</tag>
              <text class="tip-title">{{item.title}}</text>
              <text class="tip-desc">{{item.desc}}</text>
            </view>
          </view>
        </scroll-view>
      </view>
      
      <!-- ===== 最近配方 ===== -->
      <view class="section" wx:if="{{recentFormulas.length > 0}}">
        <view class="section-header">
          <text class="section-title">最近配方</text>
          <view class="more" bindtap="goToFormulas">
            <text>全部</text>
            <icon name="arrow-right" size="xs" color="#007AFF" />
          </view>
        </view>
        
        <view class="formula-list">
          <view 
            wx:for="{{recentFormulas}}" 
            wx:key="id"
            class="formula-item"
            bindtap="viewFormulaDetail"
            data-id="{{item.id}}"
          >
            <view class="formula-info">
              <text class="formula-name">{{item.title}}</text>
              <text class="formula-subtitle">{{item.subtitle}}</text>
              <view class="formula-meta">
                <text>{{item.ingredients || '食材丰富'}}</text>
                <text class="divider">·</text>
                <text>{{item.difficulty || '简易'}}</text>
              </view>
            </view>
            <icon name="arrow-right" size="sm" color="#8E8E93" />
          </view>
        </view>
      </view>
      
      <!-- 空状态 -->
      <view wx:if="{{!showSkeleton && !hasContent}}" class="empty-state-wrapper">
        <empty-state icon="empty" title="暂无内容" desc="暂时没有配方数据，快去搜索或咨询AI顾问吧"></empty-state>
      </view>
      
      <!-- 底部间距 -->
      <view class="bottom-space"></view>
    </view>
    
  </scroll-view>
  
</view>
