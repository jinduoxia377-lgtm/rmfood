/**
 * 药食同源配方平台 - 首页样式
 * 使用项目现有组件：Icon, Avatar, SkeletonLoader, Tag
 */

/* ============================================
   页面容器
   ============================================ */

.page-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  min-height: 100dvh;
  background: #F2F2F7;
}

/* ============================================
   顶部导航
   ============================================ */

.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border-bottom: 0.5rpx solid rgba(60, 60, 67, 0.08);
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
}

.brand {
  display: flex;
  flex-direction: column;
}

.brand-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1D1D1F;
  letter-spacing: -0.5rpx;
}

.brand-subtitle {
  font-size: 22rpx;
  color: #8E8E93;
  margin-top: 2rpx;
}

.header-actions {
  display: flex;
  gap: 12rpx;
}

.action-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.04);
}

.action-btn:active {
  background: rgba(0, 0, 0, 0.08);
}

/* 搜索框 */
.search-bar {
  margin: 0 24rpx 16rpx;
  height: 72rpx;
  background: rgba(118, 118, 128, 0.1);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
}

.search-placeholder {
  font-size: 28rpx;
  color: #8E8E93;
  margin-left: 12rpx;
}

/* ============================================
   滚动内容区
   ============================================ */

.content {
  flex: 1;
  background: #F2F2F7;
}

.body {
  padding-bottom: 40rpx;
}

/* ============================================
   Section 通用样式
   ============================================ */

.section {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D1D1F;
}

.more {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx;
  margin: -8rpx;
}

.more text {
  font-size: 26rpx;
  color: #007AFF;
}

/* ============================================
   快捷功能区
   ============================================ */

.quick-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  padding: 0 24rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 12rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
}

.quick-item:active {
  opacity: 0.8;
}

.quick-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.quick-icon.blue { background: linear-gradient(135deg, #007AFF, #5AC8FA); }
.quick-icon.green { background: linear-gradient(135deg, #34C759, #30D158); }
.quick-icon.orange { background: linear-gradient(135deg, #FF9500, #FFCC00); }
.quick-icon.purple { background: linear-gradient(135deg, #AF52DE, #5856D6); }
.quick-icon.teal { background: linear-gradient(135deg, #5AC8FA, #007AFF); }
.quick-icon.red { background: linear-gradient(135deg, #FF3B30, #FF453A); }

.quick-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1D1D1F;
  text-align: center;
}

.quick-desc {
  font-size: 20rpx;
  color: #8E8E93;
  margin-top: 4rpx;
  text-align: center;
}

/* ============================================
   今日推荐卡片
   ============================================ */

.featured-card {
  margin: 0 24rpx;
  background: linear-gradient(135deg, #007AFF 0%, #5AC8FA 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  color: white;
}

.featured-card:active {
  opacity: 0.95;
}

.featured-body {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.featured-title {
  font-size: 34rpx;
  font-weight: 600;
  color: white;
}

.featured-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.featured-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

/* ============================================
   健康提示
   ============================================ */

.tip-scroll {
  white-space: nowrap;
}

.tip-list {
  display: inline-flex;
  gap: 16rpx;
  padding: 0 24rpx;
}

.tip-card {
  display: inline-block;
  width: 260rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
}

.tip-tag {
  margin-bottom: 12rpx;
}

.tip-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1D1D1F;
  line-height: 1.4;
  display: block;
  margin-bottom: 8rpx;
}

.tip-desc {
  font-size: 22rpx;
  color: #8E8E93;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ============================================
   配方列表
   ============================================ */

.formula-list {
  margin: 0 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
}

.formula-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 0.5rpx solid rgba(60, 60, 67, 0.08);
}

.formula-item:last-child {
  border-bottom: none;
}

.formula-item:active {
  background: rgba(0, 0, 0, 0.02);
}

.formula-info {
  flex: 1;
  min-width: 0;
}

.formula-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D1D1F;
  display: block;
}

.formula-subtitle {
  font-size: 24rpx;
  color: #8E8E93;
  margin-top: 6rpx;
  display: block;
}

.formula-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #8E8E93;
}

.divider {
  opacity: 0.5;
}

/* ============================================
   底部间距
   ============================================ */

.bottom-space {
  height: 40rpx;
}
