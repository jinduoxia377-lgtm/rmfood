@import '/miniprogram_npm/weui-wxss/dist/style/weui.wxss';

/**app.wxss**/
/* ==================== RMFOOD Design Token System ==================== */
/* 版本: V1.0 | 更新日期: 2026-01-15 */

page {
  /* ===== 品牌色彩 ===== */
  --color-primary: #2D5A3D;              /* 草本绿 - 主色 */
  --color-primary-light: #4A7C5C;        /* 浅绿 - 辅助色 */
  --color-primary-dark: #1E3D2A;         /* 深绿 - 深色变体 */
  --color-accent: #1976D2;               /* AI蓝 - 强调色 */
  --color-accent-light: #42A5F5;         /* 浅蓝 */
  
  /* ===== 状态色彩 ===== */
  --color-success: #22C55E;              /* 绿色 - 成功 */
  --color-warning: #F59E0B;              /* 琥珀色 - 警告 */
  --color-danger: #EF4444;               /* 红色 - 危险/错误 */
  --color-info: #3B82F6;                 /* 蓝色 - 信息 */
  
  /* ===== 中性色 ===== */
  --color-text-primary: #1A1A1A;         /* 主文字 */
  --color-text-secondary: #333333;       /* 次文字 */
  --color-text-muted: #666666;           /* 辅助文字 */
  --color-text-placeholder: #999999;     /* 占位符 */
  --color-text-disabled: #CCCCCC;        /* 禁用文字 */
  --color-text-white: #FFFFFF;           /* 白色文字 */
  
  /* ===== 背景色 ===== */
  --color-bg-primary: #F5F7FA;           /* 页面背景 */
  --color-bg-secondary: #FFFFFF;         /* 卡片背景 */
  --color-bg-tertiary: #F8F9FA;          /* 次要背景 */
  --color-bg-hover: #F0F0F0;             /* 悬停背景 */
  --color-bg-active: #E8E8E8;            /* 激活背景 */
  
  /* ===== 边框色 ===== */
  --color-border: #E5E7EB;               /* 默认边框 */
  --color-border-light: #F3F4F6;         /* 浅边框 */
  --color-border-dark: #D1D5DB;          /* 深边框 */
  
  /* ===== 阴影 ===== */
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  --shadow-brand: 0 4rpx 24rpx rgba(45, 90, 61, 0.2);
  
  /* ===== 圆角 ===== */
  --radius-sm: 8rpx;                     /* 小圆角 */
  --radius-md: 16rpx;                    /* 中圆角 */
  --radius-lg: 24rpx;                    /* 大圆角 */
  --radius-xl: 32rpx;                    /* 超大圆角 */
  --radius-full: 50%;                    /* 圆形 */
  
  /* ===== 间距 ===== */
  --space-xs: 8rpx;                      /* 超紧凑 */
  --space-sm: 16rpx;                     /* 紧凑 */
  --space-md: 24rpx;                     /* 常规 */
  --space-lg: 32rpx;                     /* 宽松 */
  --space-xl: 48rpx;                     /* 超宽松 */
  --space-2xl: 64rpx;                    /* 页面级 */
  --space-3xl: 96rpx;                    /* 超大间距 */
  
  /* ===== 字号 ===== */
  --font-size-xs: 20rpx;                 /* 辅助说明 */
  --font-size-sm: 24rpx;                 /* 次要信息 */
  --font-size-base: 28rpx;               /* 正文 */
  --font-size-md: 32rpx;                 /* 卡片标题 */
  --font-size-lg: 40rpx;                 /* 页面标题 */
  --font-size-xl: 48rpx;                 /* 大标题 */
  --font-size-2xl: 64rpx;                /* 超大标题 */
  
  /* ===== 字重 ===== */
  --font-weight-light: 300;              /* 细体 */
  --font-weight-regular: 400;            /* 常规 */
  --font-weight-medium: 500;             /* 中等 */
  --font-weight-semibold: 600;           /* 半粗 */
  --font-weight-bold: 700;               /* 粗体 */
  
  /* ===== 行高 ===== */
  --line-height-tight: 1.25;             /* 紧凑 */
  --line-height-normal: 1.5;             /* 正常 */
  --line-height-relaxed: 1.75;           /* 宽松 */
  
  /* ===== 过渡动画 ===== */
  --transition-fast: 150ms ease;         /* 快速过渡 */
  --transition-normal: 300ms ease;       /* 正常过渡 */
  --transition-slow: 500ms ease;         /* 慢速过渡 */
  
  /* ===== 字体族 ===== */
  --font-family-base: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  --font-family-monospace: 'SF Mono', Monaco, 'Cascadia Code', monospace;
  
  /* ===== 基础样式 ===== */
  background-color: var(--color-bg-primary);
  font-family: var(--font-family-base);
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  line-height: var(--line-height-normal);
  -webkit-tap-highlight-color: transparent;
}

/* ==================== 通用样式类 ==================== */

/* 文字样式 */
.text-primary { color: var(--color-text-primary); }
.text-secondary { color: var(--color-text-secondary); }
.text-muted { color: var(--color-text-muted); }
.text-placeholder { color: var(--color-text-placeholder); }
.text-white { color: var(--color-text-white); }
.text-success { color: var(--color-success); }
.text-warning { color: var(--color-warning); }
.text-danger { color: var(--color-danger); }
.text-accent { color: var(--color-accent); }

/* 背景样式 */
.bg-primary { background-color: var(--color-bg-primary); }
.bg-secondary { background-color: var(--color-bg-secondary); }
.bg-brand { background-color: var(--color-primary); }

/* 圆角 */
.radius-sm { border-radius: var(--radius-sm); }
.radius-md { border-radius: var(--radius-md); }
.radius-lg { border-radius: var(--radius-lg); }
.radius-xl { border-radius: var(--radius-xl); }
.radius-full { border-radius: var(--radius-full); }

/* 阴影 */
.shadow-sm { box-shadow: var(--shadow-sm); }
.shadow-md { box-shadow: var(--shadow-md); }
.shadow-lg { box-shadow: var(--shadow-lg); }
.shadow-brand { box-shadow: var(--shadow-brand); }

/* 间距 */
.p-xs { padding: var(--space-xs); }
.p-sm { padding: var(--space-sm); }
.p-md { padding: var(--space-md); }
.p-lg { padding: var(--space-lg); }
.p-xl { padding: var(--space-xl); }

.m-xs { margin: var(--space-xs); }
.m-sm { margin: var(--space-sm); }
.m-md { margin: var(--space-md); }
.m-lg { margin: var(--space-lg); }
.m-xl { margin: var(--space-xl); }

/* 字号 */
.fs-xs { font-size: var(--font-size-xs); }
.fs-sm { font-size: var(--font-size-sm); }
.fs-base { font-size: var(--font-size-base); }
.fs-md { font-size: var(--font-size-md); }
.fs-lg { font-size: var(--font-size-lg); }
.fs-xl { font-size: var(--font-size-xl); }
.fs-2xl { font-size: var(--font-size-2xl); }

/* 字重 */
.fw-light { font-weight: var(--font-weight-light); }
.fw-regular { font-weight: var(--font-weight-regular); }
.fw-medium { font-weight: var(--font-weight-medium); }
.fw-semibold { font-weight: var(--font-weight-semibold); }
.fw-bold { font-weight: var(--font-weight-bold); }

/* 过渡动画 */
.transition-fast { transition: all var(--transition-fast); }
.transition-normal { transition: all var(--transition-normal); }
.transition-slow { transition: all var(--transition-slow); }

/* ==================== 组件样式 ==================== */

/* 按钮基础样式 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-md) var(--space-xl);
  border-radius: var(--radius-full);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-medium);
  transition: all var(--transition-normal);
  border: none;
  cursor: pointer;
}

.btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.btn-primary {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
  color: var(--color-text-white);
}

.btn-secondary {
  background-color: var(--color-bg-secondary);
  color: var(--color-text-primary);
  border: 1rpx solid var(--color-border);
}

.btn-text {
  background: transparent;
  color: var(--color-primary);
  padding: var(--space-xs) var(--space-md);
}

.btn-danger {
  background-color: var(--color-danger);
  color: var(--color-text-white);
}

.btn-success {
  background-color: var(--color-success);
  color: var(--color-text-white);
}

.btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* 卡片样式 */
.card {
  background-color: var(--color-bg-secondary);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  overflow: hidden;
}

/* 输入框样式 */
.input {
  width: 100%;
  padding: var(--space-md);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: var(--font-size-base);
  background-color: var(--color-bg-secondary);
  color: var(--color-text-primary);
  transition: border-color var(--transition-fast);
}

.input:focus {
  border-color: var(--color-primary);
  outline: none;
}

.input::placeholder {
  color: var(--color-text-placeholder);
}

/* 标签样式 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: var(--space-xs) var(--space-sm);
  border-radius: var(--radius-sm);
  font-size: var(--font-size-sm);
  background-color: var(--color-bg-tertiary);
  color: var(--color-text-secondary);
}

.tag-primary {
  background-color: rgba(45, 90, 61, 0.1);
  color: var(--color-primary);
}

.tag-success {
  background-color: rgba(34, 197, 94, 0.1);
  color: var(--color-success);
}

.tag-warning {
  background-color: rgba(245, 158, 11, 0.1);
  color: var(--color-warning);
}

.tag-danger {
  background-color: rgba(239, 68, 68, 0.1);
  color: var(--color-danger);
}

/* 分割线 */
.divider {
  height: 1rpx;
  background-color: var(--color-border);
  margin: var(--space-md) 0;
}

/* 加载状态 */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-2xl);
}

/* Toast 提示 */
.toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background-color: rgba(0, 0, 0, 0.75);
  color: var(--color-text-white);
  padding: var(--space-md) var(--space-xl);
  border-radius: var(--radius-md);
  font-size: var(--font-size-base);
  z-index: 9999;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translate(-50%, -50%) scale(0.9); }
  to { opacity: 1; transform: translate(-50%, -50%) scale(1); }
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* ==================== Page Transition Animations ==================== */
/* 页面进入动画 */
.page-enter {
  animation: slideInRight 0.35s ease forwards;
}

.page-exit {
  animation: slideOutLeft 0.35s ease forwards;
}

@keyframes slideInRight {
  from {
    transform: translateX(100%);
    opacity: 0;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}

@keyframes slideOutLeft {
  from {
    transform: translateX(0);
    opacity: 1;
  }
  to {
    transform: translateX(-100%);
    opacity: 0;
  }
}

/* 页面淡入动画 */
.fade-enter {
  animation: fadeIn 0.3s ease forwards;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 底部弹出动画 */
.bottom-sheet-enter {
  animation: slideUp 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

/* 缩放动画 */
.scale-enter {
  animation: scaleIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes scaleIn {
  from {
    transform: scale(0.8);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

/* 微动效 */
.micro-fade-in {
  animation: microFadeIn 0.3s ease forwards;
}

@keyframes microFadeIn {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.micro-slide-up {
  animation: microSlideUp 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes microSlideUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.micro-scale-in {
  animation: microScaleIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes microScaleIn {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* 点击反馈 */
.tap-feedback:active {
  transform: scale(0.96);
  opacity: 0.8;
  transition: all 0.15s ease;
}

/* 骨架屏动画 */
.skeleton-pulse {
  animation: skeletonPulse 1.5s ease-in-out infinite;
}

@keyframes skeletonPulse {
  0%, 100% {
    opacity: 0.4;
  }
  50% {
    opacity: 0.8;
  }
}

/* ==================== End of Animations ==================== */