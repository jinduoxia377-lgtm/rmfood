/**
 * RMFOOD 小程序 - 排版系统 (Typography System)
 * 对齐桌面端主题系统规范 DESIGN.md §3（Apple HIG 14 级排版刻度）
 * 所有字号引用 design-tokens.wxss 设计令牌
 */

/* ============================================
   1. Display / Hero（桌面 Display 56px 对应移动 28px）
   ============================================ */

.text-hero-display {
  font-size: var(--font-size-display);      /* 56rpx / 28px */
  line-height: 1.15;
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  letter-spacing: -1rpx;
}

.text-display {
  font-size: var(--font-size-display);
  line-height: 1.15;
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  letter-spacing: -1rpx;
}

/* ============================================
   2. Large Title（页面大标题，桌面 40px 对应 24px）
   ============================================ */

.text-large-title {
  font-size: var(--font-size-large-title);  /* 48rpx / 24px */
  line-height: 1.2;
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  letter-spacing: -0.5rpx;
}

/* ============================================
   3. Title 系列（桌面 34/28/22/17px 语义）
   ============================================ */

.text-title-1 {
  font-size: var(--font-size-title-1);      /* 40rpx / 20px */
  line-height: 1.25;
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.text-title-2 {
  font-size: var(--font-size-title-2);      /* 36rpx / 18px */
  line-height: 1.3;
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.text-title-3 {
  font-size: var(--font-size-title-3);      /* 32rpx / 16px */
  line-height: 1.35;
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

/* 兼容旧类名（title-xl/lg/md/sm） */
.text-title-xl {
  font-size: var(--font-size-2xl);          /* 44rpx / 22px */
  line-height: 1.2;
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  letter-spacing: -0.5rpx;
}

.text-title-lg {
  font-size: var(--font-size-title-1);       /* 40rpx / 20px */
  line-height: 1.25;
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
}

.text-title-md {
  font-size: var(--font-size-title-2);      /* 36rpx / 18px */
  line-height: 1.3;
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.text-title-sm {
  font-size: var(--font-size-title-3);      /* 32rpx / 16px */
  line-height: 1.35;
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

/* ============================================
   4. Subtitle（副标题，桌面 21px 对应 15px）
   ============================================ */

.text-subtitle {
  font-size: var(--font-size-subtitle);     /* 30rpx / 15px */
  line-height: 1.4;
  font-weight: var(--font-weight-medium);
  color: var(--color-text-secondary);
}

/* ============================================
   5. Body 正文（桌面 17px 对应移动 14px 微信标准）
   ============================================ */

.text-body {
  font-size: var(--font-size-body);           /* 28rpx / 14px */
  line-height: var(--line-height-normal);
  font-weight: var(--font-weight-regular);
  color: var(--color-text-primary);
}

.text-body-strong {
  font-size: var(--font-size-body);
  line-height: var(--line-height-normal);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.text-body-sm {
  font-size: var(--font-size-callout);        /* 26rpx / 13px */
  line-height: 1.5;
  font-weight: var(--font-weight-regular);
  color: var(--color-text-primary);
}

/* ============================================
   6. Callout 注释（桌面 17px 语义 → 移动 13px）
   ============================================ */

.text-callout {
  font-size: var(--font-size-callout);       /* 26rpx / 13px */
  line-height: var(--line-height-relaxed);
  font-weight: var(--font-weight-regular);
  color: var(--color-text-secondary);
}

/* ============================================
   7. Caption 说明（桌面 14/12px 语义 → 移动 12px）
   ============================================ */

.text-caption {
  font-size: var(--font-size-caption);       /* 24rpx / 12px */
  line-height: 1.4;
  font-weight: var(--font-weight-regular);
  color: var(--color-text-secondary);
}

.text-caption-strong {
  font-size: var(--font-size-caption-strong);
  line-height: 1.4;
  font-weight: var(--font-weight-medium);
  color: var(--color-text-secondary);
}

.text-caption-sm {
  font-size: var(--font-size-fine-print);   /* 20rpx / 10px */
  line-height: 1.4;
  font-weight: var(--font-weight-regular);
  color: var(--color-text-tertiary);
}

/* ============================================
   8. Fine Print / Micro Legal（桌面 12/10px 语义）
   ============================================ */

.text-fine-print {
  font-size: var(--font-size-fine-print);   /* 20rpx / 10px */
  line-height: 1.3;
  font-weight: var(--font-weight-regular);
  color: var(--color-text-tertiary);
}

.text-micro-legal {
  font-size: var(--font-size-micro-legal);  /* 16rpx / 8px */
  line-height: 1.3;
  font-weight: var(--font-weight-regular);
  color: var(--color-text-quaternary);
}

/* ============================================
   9. Link 链接
   ============================================ */

.text-link {
  font-size: var(--font-size-body);
  color: var(--color-brand-primary);
  text-decoration: none;
}

/* ============================================
   10. 截断工具类
   ============================================ */

.text-truncate {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-truncate-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.text-truncate-3 {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ============================================
   11. 容器排版
   ============================================ */

.title-container {
  margin-bottom: var(--space-3);   /* 24rpx */
}

.content-area {
  font-size: var(--font-size-body);
  line-height: var(--line-height-relaxed);
  color: var(--color-text-secondary);
}