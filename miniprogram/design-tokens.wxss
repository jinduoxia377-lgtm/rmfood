/**
 * RMFOOD 小程序 - 设计令牌 (Design Tokens)
 * Apple UI Design System - iOS 18 Human Interface Guidelines
 * 
 * Apple Design Principles:
 * - Clarity: 界面元素清晰易懂，不喧宾夺主
 * - Deference: UI 服务于内容，不抢夺注意力
 * - Depth: 层次分明的视觉深度感
 */

page {
  /* ============================================
     1. 字体家族 (System Font)
     ============================================ */
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", 
               "Helvetica Neue", "PingFang SC", "Hiragino Sans GB", 
               "Microsoft YaHei", sans-serif;
  
  /* ============================================
     2. 系统颜色 (System Colors) - iOS 18
     ============================================ */
   
  /* 品牌色 */
  --color-system-blue: #007AFF;
  --color-system-green: #34C759;
  --color-system-red: #FF3B30;
  --color-system-orange: #FF9500;
  --color-system-yellow: #FFCC00;
  --color-system-purple: #AF52DE;
  --color-system-pink: #FF2D55;
  --color-system-teal: #5AC8FA;
  --color-system-indigo: #5856D6;
  --color-system-brown: #A2845E;
  --color-system-mint: #1AC7B8;
  --color-system-seafoam: #40E8D6;
  --color-system-cyan: #40E8D6;
  
  /* 品牌色系 - 药食同源主题 */
  --color-brand-50: #F0F7F4;
  --color-brand-100: #D9ECE1;
  --color-brand-200: #B3D9C3;
  --color-brand-400: #4A7C5C;
  --color-brand-500: #2D5A3D;
  --color-brand-600: #1E4030;
  --color-brand-700: #153024;
  
  /* 主色别名 */
  --color-primary: var(--color-system-blue);
  --color-primary-light: rgba(0, 122, 255, 0.12);
  
  /* ============================================
     3. 文字颜色 (Text Colors)
     ============================================ */
  
  --color-text-primary: #000000;
  --color-text-secondary: #3C3C43;
  --color-text-tertiary: #8E8E93;
  --color-text-quaternary: #AEAEB2;
  --color-text-placeholder: #C7C7CC;
  --color-text-white: #FFFFFF;
  --color-text-disabled: #C7C7CC;
  --color-text-inverse: #FFFFFF;
  --color-text-muted: #8E8E93;
  
  /* ============================================
     4. 背景颜色 (Background Colors) - iOS 18
     ============================================ */
  
  --color-bg-page: #F2F2F7;           /* iOS 分组背景 */
  --color-bg-card: #FFFFFF;           /* 卡片背景 */
  --color-bg-secondary: #F2F2F7;      /* 次级背景 */
  --color-bg-tertiary: #E5E5EA;       /* 三级背景 */
  --color-bg-primary: #FFFFFF;
  --color-bg-hover: rgba(0, 0, 0, 0.04);
  
  /* 分组背景 */
  --color-grouped-bg: #F2F2F7;
  --color-grouped-separator: #C6C6C8;
  
  /* ============================================
     5. 边框颜色 (Border Colors)
     ============================================ */
  
  --color-border: #E5E5EA;
  --color-border-light: #F2F2F7;
  --color-border-dark: #D1D1D6;
  --color-separator: rgba(60, 60, 67, 0.1);
  --color-divider: rgba(60, 60, 67, 0.2);
  
  /* ============================================
     6. 状态颜色 (System Colors for States)
     ============================================ */
  
  --color-success: var(--color-system-green);
  --color-success-light: #D1FAE5;
  --color-success-bg: #ECFDF5;
  --color-warning: var(--color-system-orange);
  --color-warning-light: #FEF3C7;
  --color-warning-bg: #FFFBEB;
  --color-danger: var(--color-system-red);
  --color-danger-light: #FEE2E2;
  --color-danger-bg: #FEF2F2;
  --color-info: var(--color-system-teal);
  --color-info-light: #E0F2FE;
  --color-info-bg: #F0F9FF;
  
  /* ============================================
     7. 中性灰度 (Neutral Grays)
     ============================================ */
  
  --color-gray-50: #FAFAFA;
  --color-gray-100: #F5F5F5;
  --color-gray-200: #EEEEEE;
  --color-gray-300: #E0E0E0;
  --color-gray-400: #BDBDBD;
  --color-gray-500: #9E9E9E;
  --color-gray-600: #757575;
  --color-gray-700: #616161;
  --color-gray-800: #424242;
  --color-gray-900: #212121;
  
  /* ============================================
     8. 阴影系统 (Shadow System)
     ============================================ */
  
  --shadow-none: none;
  --shadow-sm: 0 1rpx 3rpx rgba(0,0,0,0.04), 0 1rpx 2rpx rgba(0,0,0,0.06);
  --shadow-md: 0 4rpx 12rpx rgba(0,0,0,0.06), 0 2rpx 4rpx rgba(0,0,0,0.04);
  --shadow-lg: 0 12rpx 28rpx rgba(0,0,0,0.08), 0 4rpx 10rpx rgba(0,0,0,0.04);
  --shadow-xl: 0 20rpx 40rpx rgba(0,0,0,0.12);
  --shadow-brand: 0 4rpx 16rpx rgba(0, 122, 255, 0.2);
  --shadow-inset: inset 0 1rpx 0 rgba(255,255,255,0.5);
  
  /* ============================================
     9. 圆角系统 (Corner Radius)
     ============================================ */
  
  --radius-none: 0rpx;
  --radius-xs: 4rpx;
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-xl: 20rpx;
  --radius-2xl: 24rpx;
  --radius-full: 999rpx;
  
  /* iOS 按钮/卡片圆角 */
  --radius-button: 12rpx;
  --radius-card: 14rpx;
  --radius-list: 12rpx;
  --radius-input: 10rpx;
  --radius-segment: 9rpx;
  
  /* ============================================
     10. 字号系统 (Typography) - 微信规范
     ============================================ */
  
  /* SF Pro 标准字号 */
  --font-size-display: 48rpx;
  --font-size-large-title: 34rpx;
  --font-size-title-1: 28rpx;
  --font-size-title-2: 22rpx;
  --font-size-title-3: 17rpx;
  --font-size-body: 17rpx;
  --font-size-callout: 16rpx;
  --font-size-caption: 12rpx;
  --font-size-caption-strong: 13rpx;
  
  /* 小程序专用字号 (rpx) */
  --font-size-xs: 20rpx;      /* 辅助说明文字 */
  --font-size-sm: 24rpx;      /* 次要信息 */
  --font-size-md: 28rpx;      /* 正文基础 */
  --font-size-lg: 32rpx;      /* 小标题 */
  --font-size-xl: 36rpx;      /* 标题 */
  --font-size-2xl: 44rpx;     /* 大标题 */
  --font-size-3xl: 56rpx;     /* 超大标题 */
  --font-size-base: 28rpx;    /* 默认正文 */
  
  /* 字重 */
  --font-weight-light: 300;
  --font-weight-regular: 400;
  --font-weight-medium: 500;
  --font-weight-semibold: 600;
  --font-weight-bold: 700;
  
  /* 行高 */
  --line-height-tight: 1.15;
  --line-height-normal: 1.47;
  --line-height-relaxed: 1.7;
  --line-height-loose: 2;
  
  /* ============================================
     11. 间距系统 (Spacing) - 8pt 基准网格
     ============================================ */
  
  --space-xxs: 4rpx;
  --space-xs: 8rpx;
  --space-sm: 12rpx;
  --space-md: 16rpx;
  --space-lg: 20rpx;
  --space-xl: 24rpx;
  --space-2xl: 32rpx;
  --space-3xl: 40rpx;
  --space-4xl: 48rpx;
  
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-5: 40rpx;
  --space-6: 48rpx;
  --space-8: 64rpx;
  --space-10: 80rpx;
  --space-12: 96rpx;
  --space-16: 128rpx;
  --space-20: 160rpx;
  
  /* ============================================
     12. 过渡动画 (Transitions)
     ============================================ */
  
  --transition-fast: 0.15s ease;
  --transition-normal: 0.3s cubic-bezier(0.4, 0.0, 0.2, 1);
  --transition-slow: 0.5s cubic-bezier(0.4, 0.0, 0.2, 1);
  --transition-spring: 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  --transition-ease-out: 0.3s cubic-bezier(0.0, 0.0, 0.2, 1);
  
  /* ============================================
     13. Z-Index 层级 (Z-Index)
     ============================================ */
  
  --z-index-dropdown: 100;
  --z-index-sticky: 200;
  --z-index-fixed: 300;
  --z-index-modal: 1000;
  --z-index-toast: 9999;
  --z-index-popup: 1100;
  --z-index-sheet: 1200;
  
  /* ============================================
     14. 毛玻璃效果 (Blur Effects)
     ============================================ */
  
  --blur-bg: rgba(252, 252, 254, 0.94);
  --blur-bg-secondary: rgba(242, 242, 247, 0.94);
  --blur-strong: rgba(252, 252, 254, 0.85);
  
  /* ============================================
     15. 全局默认值
     ============================================ */
  
  color: var(--color-text-primary);
  background-color: var(--color-bg-page);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

/* ============================================
   Apple UI 工具类
   ============================================ */

/* 字号工具类 */
.text-display { font-size: var(--font-size-display); }
.text-large-title { font-size: var(--font-size-large-title); }
.text-title-1 { font-size: var(--font-size-title-1); }
.text-title-2 { font-size: var(--font-size-title-2); }
.text-title-3 { font-size: var(--font-size-title-3); }
.text-body { font-size: var(--font-size-body); }
.text-callout { font-size: var(--font-size-callout); }
.text-caption { font-size: var(--font-size-caption); }
.text-caption-strong { font-size: var(--font-size-caption-strong); }

/* 字重工具类 */
.font-light { font-weight: var(--font-weight-light); }
.font-regular { font-weight: var(--font-weight-regular); }
.font-medium { font-weight: var(--font-weight-medium); }
.font-semibold { font-weight: var(--font-weight-semibold); }
.font-bold { font-weight: var(--font-weight-bold); }

/* 文字颜色工具类 */
.text-primary { color: var(--color-text-primary) !important; }
.text-secondary { color: var(--color-text-secondary) !important; }
.text-tertiary { color: var(--color-text-tertiary) !important; }
.text-placeholder { color: var(--color-text-placeholder) !important; }
.text-white { color: var(--color-text-white) !important; }
.text-system-blue { color: var(--color-system-blue) !important; }
.text-system-green { color: var(--color-system-green) !important; }
.text-system-red { color: var(--color-system-red) !important; }
.text-system-orange { color: var(--color-system-orange) !important; }

/* 背景颜色工具类 */
.bg-page { background-color: var(--color-bg-page) !important; }
.bg-card { background-color: var(--color-bg-card) !important; }
.bg-primary { background-color: var(--color-primary) !important; }
.bg-system-blue { background-color: var(--color-system-blue) !important; }

/* 圆角工具类 */
.radius-none { border-radius: var(--radius-none) !important; }
.radius-sm { border-radius: var(--radius-sm) !important; }
.radius-md { border-radius: var(--radius-md) !important; }
.radius-lg { border-radius: var(--radius-lg) !important; }
.radius-xl { border-radius: var(--radius-xl) !important; }
.radius-2xl { border-radius: var(--radius-2xl) !important; }
.radius-full { border-radius: var(--radius-full) !important; }

/* 阴影工具类 */
.shadow-sm { box-shadow: var(--shadow-sm) !important; }
.shadow-md { box-shadow: var(--shadow-md) !important; }
.shadow-lg { box-shadow: var(--shadow-lg) !important; }
.shadow-xl { box-shadow: var(--shadow-xl) !important; }

/* 间距工具类 */
.p-1 { padding: var(--space-1) !important; }
.p-2 { padding: var(--space-2) !important; }
.p-3 { padding: var(--space-3) !important; }
.p-4 { padding: var(--space-4) !important; }
.px-2 { padding-left: var(--space-2) !important; padding-right: var(--space-2) !important; }
.px-4 { padding-left: var(--space-4) !important; padding-right: var(--space-4) !important; }
.py-2 { padding-top: var(--space-2) !important; padding-bottom: var(--space-2) !important; }
.py-4 { padding-top: var(--space-4) !important; padding-bottom: var(--space-4) !important; }
.m-2 { margin: var(--space-2) !important; }
.m-4 { margin: var(--space-4) !important; }

/* Flex 工具类 */
.flex { display: flex !important; }
.flex-col { flex-direction: column !important; }
.items-center { align-items: center !important; }
.justify-between { justify-content: space-between !important; }
.justify-center { justify-content: center !important; }
.gap-1 { gap: var(--space-1) !important; }
.gap-2 { gap: var(--space-2) !important; }
.gap-3 { gap: var(--space-3) !important; }
.w-full { width: 100% !important; }
.h-full { height: 100% !important; }
.flex-1 { flex: 1 !important; }

/* 文字对齐 */
.text-left { text-align: left !important; }
.text-center { text-align: center !important; }
.text-right { text-align: right !important; }
.text-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.text-multiline-ellipsis { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

/* 显隐 */
.hidden { display: none !important; }
.visible { display: flex !important; }

/* ============================================
   安全区适配工具类
   ============================================ */
.safe-top { padding-top: env(safe-area-inset-top); }
.safe-bottom { padding-bottom: env(safe-area-inset-bottom); }
.safe-left { padding-left: env(safe-area-inset-left); }
.safe-right { padding-right: env(safe-area-inset-right); }
.safe-area-box {
  padding-top: env(safe-area-inset-top);
  padding-bottom: env(safe-area-inset-bottom);
  padding-left: env(safe-area-inset-left);
  padding-right: env(safe-area-inset-right);
}

/* ============================================
   毛玻璃效果
   ============================================ */
.backdrop-blur {
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
}
.bg-blur {
  background: var(--blur-bg);
}

/* ============================================
   Apple 动画关键帧
   ============================================ */

/* Spring 弹性动画 */
@keyframes appleSpringIn {
  0% { transform: scale(0.8); opacity: 0; }
  50% { transform: scale(1.02); }
  100% { transform: scale(1); opacity: 1; }
}

@keyframes appleSlideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes appleSlideDown {
  from { transform: translateY(-20rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

@keyframes appleFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes appleScaleIn {
  from { transform: scale(0.9); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

@keyframes appleShake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-8rpx); }
  75% { transform: translateX(8rpx); }
}

@keyframes applePulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

@keyframes appleRubberBand {
  0% { transform: scale(1); }
  30% { transform: scale(1.25, 0.75); }
  40% { transform: scale(0.75, 1.25); }
  50% { transform: scale(1.15, 0.85); }
  65% { transform: scale(0.95, 1.05); }
  75% { transform: scale(1.05, 0.95); }
  100% { transform: scale(1); }
}

/* 旋转动画 */
@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 骨架屏 shimmer */
@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* 淡入上移动画 */
.animate-slide-up {
  animation: appleSlideUp 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.animate-fade-in {
  animation: appleFadeIn 0.3s ease;
}

.animate-scale-in {
  animation: appleScaleIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}
