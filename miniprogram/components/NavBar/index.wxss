/** NavBar 导航栏组件样式 */
.navbar {
  width: 100%;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
  position: relative;
  z-index: var(--z-index-sticky, 200);
}

.navbar-fixed {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
}

.navbar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 var(--space-4);
}

.navbar-left {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  min-width: 120rpx;
}

.navbar-left-text {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-medium);
}

.navbar-title {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.navbar-title-text {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-white);
}

.navbar-subtitle {
  font-size: var(--font-size-xs);
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.navbar-right {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  min-width: 120rpx;
  justify-content: flex-end;
}

/* 透明样式 */
.navbar-transparent {
  background: transparent;
}

.navbar-transparent .navbar-title-text {
  color: var(--color-text-primary);
}

.navbar-transparent .navbar-subtitle {
  color: var(--color-text-muted);
}
