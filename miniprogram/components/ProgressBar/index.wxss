.progress-bar {
  width: 100%;
}

.progress-bar-line {
  padding: 16rpx 0;
}

.progress-bar-circle {
  display: flex;
  align-items: center;
  justify-content: center;
}

.circle-progress {
  position: relative;
  display: inline-block;
}

.progress-text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 24rpx;
  color: #979797;
}

.progress-text-line {
  text-align: center;
  font-size: 24rpx;
  color: #979797;
  margin-top: 8rpx;
}