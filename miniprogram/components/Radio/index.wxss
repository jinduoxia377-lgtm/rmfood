/** Radio 閸楁洟鈧绮嶆禒鑸电壉瀵?*/
.radio {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  
}

.radio-circle {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid var(--color-gray-400);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity var(--transition-normal), transform var(--transition-normal);
  flex-shrink: 0;
}

.radio-circle-checked {
  border-color: var(--color-primary);
}

.radio-inner {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background-color: var(--color-primary);
}

.radio-circle-disabled {
  opacity: 0.5;
  
}

.radio-label {
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
}

.radio-group {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}



