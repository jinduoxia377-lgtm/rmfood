/** Loading 加载组件样式 */
.loading {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
}

/* 尺寸 */
.loading-xs {
  width: 32rpx;
  height: 32rpx;
}

.loading-sm {
  width: 48rpx;
  height: 48rpx;
}

.loading-md {
  width: 64rpx;
  height: 64rpx;
}

.loading-lg {
  width: 96rpx;
  height: 96rpx;
}

/* Spinner 样式 */
.loading-spinner {
  position: relative;
  width: 100%;
  height: 100%;
}

.spinner-ring {
  position: absolute;
  width: 100%;
  height: 100%;
  border: 4rpx solid transparent;
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 1.2s linear infinite;
}

.spinner-ring:nth-child(2) {
  width: 75%;
  height: 75%;
  top: 12.5%;
  left: 12.5%;
  border-top-color: var(--color-accent);
  animation-duration: 0.9s;
  animation-direction: reverse;
}

.spinner-ring:nth-child(3) {
  width: 50%;
  height: 50%;
  top: 25%;
  left: 25%;
  border-top-color: var(--color-success);
  animation-duration: 0.6s;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* Dots 样式 */
.loading-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: var(--color-primary);
  animation: dotBounce 1.2s ease-in-out infinite;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
  background-color: var(--color-accent);
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
  background-color: var(--color-success);
}

@keyframes dotBounce {
  0%, 80%, 100% {
    transform: scale(0.6);
    opacity: 0.5;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

/* 文字 */
.loading-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}

/* 全屏覆盖 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: var(--z-index-overlay, 500);
}
