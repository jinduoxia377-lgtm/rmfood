<!--虚拟滚动列表-->
<view class="virtual-list-container" style="height: {{containerHeight}}rpx;">
  <view class="virtual-list-spacer" style="height: {{totalHeight}}rpx;">
    <view 
      wx:for="{{visibleItems}}" 
      wx:key="id"
      class="virtual-list-item"
      style="height: {{itemHeight}}rpx;"
      data-index="{{index}}"
      bindtap="onItemTap"
    >
      <slot name="item" data-item="{{item}}" data-index="{{index}}"></slot>
    </view>
  </view>
  
  <!-- 加载中 -->
  <view wx:if="{{showLoading}}" class="virtual-list-loading">
    <text>加载中...</text>
  </view>
  
  <!-- 空状态 -->
  <view wx:if="{{showEmpty}}" class="virtual-list-empty">
    <text>暂无数据</text>
  </view>
</view>
