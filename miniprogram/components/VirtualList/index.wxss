.virtual-list {
  width: 100%;
  height: 100%;
}

.virtual-list__placeholder {
  position: relative;
  width: 100%;
}

.virtual-list__item {
  position: absolute;
  left: 0;
  right: 0;
  box-sizing: border-box;
  padding: 24rpx 32rpx;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #F5F5F5;
}