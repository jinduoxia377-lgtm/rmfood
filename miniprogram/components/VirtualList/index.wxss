/* 虚拟滚动列表样式 */
.virtual-list-container {
  position: relative;
  overflow: hidden;
}

.virtual-list-spacer {
  width: 100%;
}

.virtual-list-item {
  width: 100%;
  box-sizing: border-box;
}

.virtual-list-loading,
.virtual-list-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  color: var(--color-text-tertiary);
  font-size: var(--font-size-body);
}
