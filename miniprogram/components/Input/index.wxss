/** Input 杈撳叆妗嗙粍浠舵牱寮?*/
.input-wrapper {
  display: flex;
  align-items: center;
  width: 100%;
  padding: 24rpx 32rpx;
  background-color: var(--color-bg-card);
  border: 2rpx solid var(--color-border);
  border-radius: 16rpx;
  position: relative;
}

.input-wrapper.focus {
  border-color: var(--color-brand-500);
  box-shadow: 0 0 0 4rpx rgba(45, 90, 61, 0.1);
}

.input-wrapper.error {
  border-color: var(--color-danger);
}

.input-wrapper.error.focus {
  box-shadow: 0 0 0 4rpx rgba(239, 68, 68, 0.1);
}

.input-wrapper.disabled {
  background-color: var(--color-bg-page);
  opacity: 0.7;
}

.input {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-primary);
  background: transparent;
  border: none;
}

.input::placeholder {
  color: var(--color-text-placeholder);
}

.input-prefix {
  margin-right: 16rpx;
  display: flex;
  align-items: center;
}

.input-suffix {
  margin-left: 16rpx;
  display: flex;
  align-items: center;
}

.input-clear {
  margin-left: 16rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: var(--color-border-light);
}

.input-clear:active {
  background-color: var(--color-border);
}

.input-error {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
  padding-left: 4rpx;
}

.error-text {
  font-size: 24rpx;
  color: var(--color-danger);
}

.input-count {
  position: absolute;
  right: 32rpx;
  bottom: -32rpx;
  font-size: 20rpx;
  color: var(--color-text-placeholder);
}

.input-placeholder {
  color: var(--color-text-placeholder);
}
