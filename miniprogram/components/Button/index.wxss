/** Button 鎸夐挳缁勪欢鏍峰紡 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx 48rpx;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  position: relative;
  -webkit-tap-highlight-color: transparent;
}

.btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.btn-small {
  padding: 16rpx 32rpx;
  font-size: 24rpx;
}

.btn-large {
  padding: 32rpx 64rpx;
  font-size: 32rpx;
}

.btn-primary {
  background: linear-gradient(135deg, var(--color-brand-500) 0%, var(--color-brand-400) 100%);
  color: var(--color-bg-card);
  box-shadow: 0 4rpx 16rpx rgba(45, 90, 61, 0.3);
}

.btn-secondary {
  background-color: var(--color-bg-card);
  color: var(--color-brand-500);
  border: 2rpx solid var(--color-brand-500);
}

.btn-text {
  background: transparent;
  color: var(--color-brand-500);
  padding: 16rpx 24rpx;
}

.btn-danger {
  background-color: var(--color-danger);
  color: var(--color-bg-card);
}

.btn-success {
  background-color: var(--color-success);
  color: var(--color-bg-card);
}

.btn-disabled {
  opacity: 0.5;
  
}

.btn-loading {
  
}

.btn-loading-spinner {
  display: flex;
  align-items: center;
  justify-content: center;
}

.spinner {
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: var(--color-bg-card);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

