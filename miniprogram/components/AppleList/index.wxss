/** AppleList 组件样式 */
.apple-list {
  margin: 20rpx 16rpx;
}

.apple-list-group-title {
  font-size: var(--font-size-caption-strong);
  color: var(--color-text-tertiary);
  text-transform: uppercase;
  letter-spacing: 0.5rpx;
  padding: 8rpx 20rpx 4rpx;
  margin-top: 20rpx;
}

.apple-list-group-title:first-child {
  margin-top: 0;
}

.apple-list-item {
  display: flex;
  align-items: center;
  padding: 14rpx 16rpx;
  background: var(--color-bg-card);
  position: relative;
  min-height: 56rpx;
  -webkit-tap-highlight-color: transparent;
}

.apple-list-item:active {
  background: var(--color-bg-hover);
}

.apple-list-item:not(:last-child)::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 56rpx;
  right: 0;
  height: 0.5rpx;
  background: var(--color-separator);
}

.apple-list-item-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: var(--radius-sm);
  margin-right: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: var(--font-size-fine-print);
}

.apple-list-item-icon.blue { background: var(--color-system-blue); }
.apple-list-item-icon.green { background: var(--color-system-green); }
.apple-list-item-icon.red { background: var(--color-system-red); }
.apple-list-item-icon.orange { background: var(--color-system-orange); }
.apple-list-item-icon.purple { background: var(--color-system-purple); }
.apple-list-item-icon.teal { background: var(--color-system-teal); }
.apple-list-item-icon.gray { background: var(--color-gray-400); }
.apple-list-item-icon.brand { background: var(--color-brand-500); }

.apple-list-item-content {
  flex: 1;
  min-width: 0;
}

.apple-list-item-title {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: var(--line-height-normal);
}

.apple-list-item-subtitle {
  font-size: var(--font-size-callout);
  color: var(--color-text-secondary);
  margin-top: 2rpx;
  line-height: var(--line-height-normal);
}

.apple-list-item-accessory {
  color: var(--color-text-tertiary);
  margin-left: 8rpx;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.apple-list-item-arrow {
  width: 8rpx;
  height: 14rpx;
  border-right: 2rpx solid var(--color-text-tertiary);
  border-bottom: 2rpx solid var(--color-text-tertiary);
  transform: rotate(-45deg);
  margin-top: -4rpx;
}

.apple-toggle {
  width: 52rpx;
  height: 32rpx;
  background: rgba(120, 120, 120, 0.24);
  border-radius: 16rpx;
  position: relative;
  transition: background var(--transition-normal);
}

.apple-toggle.active {
  background: var(--color-system-green);
}

.apple-toggle .toggle-thumb {
  position: absolute;
  top: 2rpx;
  left: 2rpx;
  width: 28rpx;
  height: 28rpx;
  background: var(--color-bg-card);
  border-radius: 50%;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.15);
  transition: transform var(--transition-spring);
}

.apple-toggle.active .toggle-thumb {
  transform: translateX(20rpx);
}

.apple-badge {
  min-width: 20rpx;
  height: 20rpx;
  padding: 0 6rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-semibold);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.apple-badge.system-blue { background: var(--color-system-blue); color: white; }
.apple-badge.system-red { background: var(--color-system-red); color: white; }
.apple-badge.system-green { background: var(--color-system-green); color: white; }
.apple-badge.dot { 
  width: 8rpx; 
  height: 8rpx; 
  border-radius: 50%;
  min-width: auto;
  padding: 0;
}
