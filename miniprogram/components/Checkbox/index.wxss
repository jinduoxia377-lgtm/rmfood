/** Checkbox 多选组件样式 */
.checkbox {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  cursor: pointer;
}

.checkbox-box {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid var(--color-gray-400);
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--transition-fast);
  flex-shrink: 0;
}

.checkbox-box-checked {
  background-color: var(--color-primary);
  border-color: var(--color-primary);
}

.checkbox-box-disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.checkbox-label {
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
}

.checkbox-group {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}
