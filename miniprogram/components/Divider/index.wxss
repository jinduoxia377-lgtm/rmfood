/** Divider 分割线组件样式 */
.divider {
  display: flex;
  align-items: center;
  width: 100%;
  padding: var(--space-3) 0;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background-color: var(--color-border);
}

.divider-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
  padding: 0 var(--space-3);
  white-space: nowrap;
}

.divider-text-left {
  text-align: left;
}

.divider-text-right {
  text-align: right;
}

/* 虚线样式 */
.divider-dashed .divider-line {
  background-image: linear-gradient(to right, var(--color-border) 50%, transparent 50%);
  background-size: 8rpx 1rpx;
  background-repeat: repeat-x;
}

/* 点状样式 */
.divider-dotted .divider-line {
  background-image: radial-gradient(circle, var(--color-border) 1rpx, transparent 1rpx);
  background-size: 8rpx 1rpx;
  background-repeat: repeat-x;
}

/* 无边框样式 */
.divider-none .divider-line {
  display: none;
}
