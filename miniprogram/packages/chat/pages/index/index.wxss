/* packages/chat/pages/index/index.wxss */
.chat-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #F2F2F7;
}

.chat-header {
  padding: 40rpx 32rpx;
  background: #FFFFFF;
  text-align: center;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1D1D1F;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: #8E8E93;
  margin-top: 8rpx;
}

.chat-body {
  flex: 1;
  padding: 32rpx;
}

.welcome {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  font-size: 28rpx;
  color: #3A3A3C;
  line-height: 1.6;
}

.chat-input {
  display: flex;
  padding: 24rpx;
  background: #FFFFFF;
  gap: 16rpx;
}
