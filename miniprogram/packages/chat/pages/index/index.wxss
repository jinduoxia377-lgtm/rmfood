/* AI Chat Page - 统一设计系统 */
.page-container {
  min-height: 100vh;
  background-color: var(--color-bg-primary);
  display: flex;
  flex-direction: column;
}

/* 消息列表 */
.message-list {
  flex: 1;
  padding: var(--space-4);
  overflow-y: auto;
}

/* 欢迎区域 */
.welcome-section {
  margin-bottom: var(--space-4);
}

.welcome-card {
  background: var(--color-bg-secondary);
  border-radius: var(--radius-xl);
  padding: var(--space-5);
  text-align: center;
}

.welcome-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, var(--color-brand-100), var(--color-brand-200));
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto var(--space-4);
}

.welcome-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  margin-bottom: var(--space-2);
}

.welcome-desc {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-4);
}

.welcome-features {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.feature-item {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-4);
  background: var(--color-bg-tertiary);
  border-radius: var(--radius-lg);
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
}

/* 消息样式 */
.message {
  display: flex;
  margin-bottom: var(--space-4);
  align-items: flex-start;
}

.message-content {
  display: flex;
  max-width: 85%;
}

.user-message {
  flex-direction: row-reverse;
}

.ai-message {
  flex-direction: row;
}

.message-avatar {
  flex-shrink: 0;
  margin: 0 var(--space-2);
}

.message-bubble {
  padding: var(--space-3) var(--space-4);
  border-radius: var(--radius-xl);
  word-wrap: break-word;
  line-height: var(--line-height-relaxed);
}

.user-bubble {
  background: linear-gradient(135deg, var(--color-brand-500), var(--color-brand-400));
  color: var(--color-text-white);
  border-top-right-radius: var(--radius-sm);
}

.ai-bubble {
  background: var(--color-bg-secondary);
  color: var(--color-text-primary);
  border-top-left-radius: var(--radius-sm);
  box-shadow: var(--shadow-sm);
}

.message-content {
  font-size: var(--font-size-base);
}

/* 配方卡片 */
.formula-card {
  margin-top: var(--space-3);
  background: var(--color-bg-tertiary);
  border-radius: var(--radius-lg);
  padding: var(--space-3);
  border: 2rpx solid var(--color-brand-100);
}

.formula-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-2);
}

.formula-name {
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
  color: var(--color-primary);
}

.formula-ingredients {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-bottom: var(--space-2);
}

.formula-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  padding-top: var(--space-2);
  border-top: 1rpx solid var(--color-border);
}

.formula-action {
  font-size: var(--font-size-sm);
  color: var(--color-primary);
  font-weight: var(--font-weight-medium);
}

/* Typing Indicator */
.typing-indicator {
  display: flex;
  align-items: center;
  padding: var(--space-3) 0;
}

.typing-dots {
  display: flex;
  gap: var(--space-1);
  margin-right: var(--space-2);
}

.dot {
  width: 12rpx;
  height: 12rpx;
  background: var(--color-primary);
  border-radius: var(--radius-full);
  animation: bounce 1.4s infinite ease-in-out;
}

.dot:nth-child(1) { animation-delay: -0.32s; }
.dot:nth-child(2) { animation-delay: -0.16s; }

@keyframes bounce {
  0%, 80%, 100% {
    transform: scale(0);
    opacity: 0.5;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

.typing-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}

/* 输入区域 */
.input-area {
  background: var(--color-bg-secondary);
  padding: var(--space-3) var(--space-4);
  padding-bottom: calc(var(--space-3) + env(safe-area-inset-bottom));
  box-shadow: var(--shadow-lg);
}

.input-wrapper {
  display: flex;
  align-items: flex-end;
  gap: var(--space-2);
}

.message-input {
  flex: 1;
  font-size: var(--font-size-base);
  background: var(--color-bg-primary);
  border-radius: var(--radius-full);
  padding: var(--space-3) var(--space-4);
  min-height: 88rpx;
  max-height: 240rpx;
  color: var(--color-text-primary);
}

.input-placeholder {
  color: var(--color-text-muted);
}

.send-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-primary);
  transition: all var(--transition-fast);
  cursor: pointer;
}

.send-btn.active {
  background: linear-gradient(135deg, var(--color-brand-500), var(--color-brand-400));
}

.send-btn:active {
  transform: scale(0.9);
}

/* 快捷建议 */
.suggestions {
  margin-top: var(--space-3);
}

.suggestion-scroll {
  white-space: nowrap;
}

.suggestion-list {
  display: inline-flex;
  gap: var(--space-2);
}

.suggestion-chip {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-2) var(--space-3);
  background: var(--color-bg-primary);
  border-radius: var(--radius-full);
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.suggestion-chip:active {
  background: var(--color-brand-100);
  color: var(--color-primary);
  transform: scale(0.95);
}

/* 侧边菜单 */
.menu-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: var(--z-index-modal);
  animation: fadeIn 0.3s ease;
}

.side-menu {
  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;
  width: 80%;
  max-width: 320rpx;
  background: var(--color-bg-secondary);
  z-index: var(--z-index-modal);
  transform: translateX(-100%);
  transition: transform var(--transition-normal);
  display: flex;
  flex-direction: column;
}

.side-menu.open {
  transform: translateX(0);
}

.menu-header {
  display: flex;
  align-items: center;
  padding: var(--space-4);
  gap: var(--space-3);
  border-bottom: 1rpx solid var(--color-border);
}

.menu-user-info {
  flex: 1;
}

.menu-nickname {
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.menu-close {
  padding: var(--space-2);
  cursor: pointer;
}

.menu-items {
  flex: 1;
  padding: var(--space-3) 0;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-4);
  cursor: pointer;
  transition: background var(--transition-fast);
}

.menu-item:active {
  background: var(--color-bg-tertiary);
}

.menu-text {
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
}

/* 动画 */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 底部间距 */
.bottom-spacing {
  height: var(--space-6);
}
