/* packages/chat/pages/index/index.wxss */
.chat-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: var(--color-bg-page);
}

.chat-header {
  padding: 40rpx 32rpx;
  background: var(--color-bg-card);
  text-align: center;
}

.title {
  display: block;
  font-size: var(--font-size-title-1);
  font-weight: 700;
  color: var(--color-text-primary);
}

.subtitle {
  display: block;
  font-size: var(--font-size-callout);
  color: var(--color-text-tertiary);
  margin-top: 8rpx;
}

.chat-body {
  flex: 1;
  padding: 32rpx;
}

.welcome {
  background: var(--color-bg-card);
  border-radius: 16rpx;
  padding: 32rpx;
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.chat-input {
  display: flex;
  padding: 24rpx;
  background: var(--color-bg-card);
  gap: 16rpx;
}
