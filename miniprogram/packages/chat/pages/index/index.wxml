<!--packages/chat/pages/index/index.wxml-->
<view class="chat-container">
  <view class="chat-header">
    <text class="title">AI配方顾问</text>
    <text class="subtitle">为您定制药食同源配方</text>
  </view>
  <view class="chat-body">
    <view class="welcome">
      <text>您好！我是您的AI配方顾问，请告诉我您的健康状况或需求。</text>
    </view>
  </view>
  <view class="chat-input">
    <input placeholder="输入您的需求..." />
    <button type="primary" size="mini">发送</button>
  </view>
</view>
