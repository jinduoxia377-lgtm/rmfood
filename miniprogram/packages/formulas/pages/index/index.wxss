/* packages/formulas/pages/index/index.wxss */
.formulas-container {
  min-height: 100vh;
  background: #F2F2F7;
}

.search-bar {
  padding: 24rpx;
  background: #FFFFFF;
}

.search-bar input {
  background: #F2F2F7;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.formula-list {
  padding: 16rpx 24rpx;
}

.formula-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D1D1F;
}

.status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #E8F5E9;
  color: #4CAF50;
}

.desc {
  font-size: 26rpx;
  color: #8E8E93;
  line-height: 1.5;
}