/* 配方列表页样式 - 虚拟列表优化版 */
.page-container {
  min-height: 100vh;
  background-color: var(--color-bg-primary);
  display: flex;
  flex-direction: column;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  gap: var(--space-2);
  padding: var(--space-3) var(--space-4);
  background: var(--color-bg-secondary);
  overflow-x: auto;
  white-space: nowrap;
  position: sticky;
  top: 0;
  z-index: var(--z-index-sticky);
  box-shadow: var(--shadow-sm);
}

.filter-item {
  display: inline-flex;
  align-items: center;
  padding: var(--space-2) var(--space-4);
  background: var(--color-bg-primary);
  border-radius: var(--radius-full);
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  cursor: pointer;
  transition: all var(--transition-fast);
  flex-shrink: 0;
  border: 1rpx solid transparent;
}

.filter-item.active {
  background: linear-gradient(135deg, var(--color-brand-500), var(--color-brand-400));
  color: var(--color-text-white);
  border-color: var(--color-brand-500);
}

.filter-item:active {
  transform: scale(0.95);
}

/* 虚拟列表容器 */
.virtual-list {
  flex: 1;
  height: calc(100vh - 120rpx);
}

/* 配方卡片 */
.formula-card {
  background: var(--color-bg-secondary);
  margin: var(--space-3);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: all var(--transition-fast);
}

.formula-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-md);
}

.formula-card-content {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-4);
}

.formula-avatar {
  flex-shrink: 0;
  width: 120rpx;
  height: 120rpx;
}

.formula-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  min-width: 0;
}

.formula-name {
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.formula-desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.formula-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-1);
}

/* 加载状态 */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-16);
}

/* 侧边菜单 */
.menu-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: var(--z-index-modal);
  animation: fadeIn 0.3s ease;
}

.side-menu {
  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;
  width: 80%;
  max-width: 320rpx;
  background: var(--color-bg-secondary);
  z-index: var(--z-index-modal);
  transform: translateX(-100%);
  transition: transform var(--transition-normal);
  display: flex;
  flex-direction: column;
}

.side-menu.open {
  transform: translateX(0);
}

.menu-header {
  display: flex;
  align-items: center;
  padding: var(--space-4);
  gap: var(--space-3);
  border-bottom: 1rpx solid var(--color-border);
}

.menu-user-info {
  flex: 1;
}

.menu-nickname {
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.menu-close {
  padding: var(--space-2);
  cursor: pointer;
}

.menu-items {
  flex: 1;
  padding: var(--space-3) 0;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-4);
  cursor: pointer;
  transition: background var(--transition-fast);
}

.menu-item:active {
  background: var(--color-bg-tertiary);
}

.menu-text {
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
}

/* 动画 */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 虚拟列表项样式 */
.virtual-list__placeholder {
  position: relative;
  width: 100%;
}

.virtual-list__item {
  position: absolute;
  left: 0;
  right: 0;
  box-sizing: border-box;
}
