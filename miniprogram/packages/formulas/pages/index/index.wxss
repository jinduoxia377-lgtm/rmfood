/* packages/formulas/pages/index/index.wxss */
.formulas-container {
  min-height: 100vh;
  background: var(--color-bg-page);
}

.search-bar {
  padding: 24rpx;
  background: var(--color-bg-card);
}

.search-bar input {
  background: var(--color-bg-page);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: var(--font-size-body);
}

.formula-list {
  padding: 16rpx 24rpx;
}

.formula-card {
  background: var(--color-bg-card);
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.name {
  font-size: var(--font-size-title-3);
  font-weight: 600;
  color: var(--color-text-primary);
}

.status {
  font-size: var(--font-size-caption);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: var(--color-success-bg);
  color: var(--color-success-text);
}

.desc {
  font-size: var(--font-size-callout);
  color: var(--color-text-tertiary);
  line-height: 1.5;
}