<!--packages/formulas/pages/index/index.wxml-->
<view class="formulas-container">
  <view class="search-bar">
    <input placeholder="搜索配方..." bindinput="onSearch" />
  </view>
  <view class="formula-list">
    <view class="formula-card" wx:for="{{formulas}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <view class="card-header">
        <text class="name">{{item.name}}</text>
        <text class="status status-{{item.status}}">{{item.status}}</text>
      </view>
      <text class="desc">{{item.description}}</text>
    </view>
  </view>
</view>
