<!--packages/formulas/pages/detail/index.wxml-->
<view class="detail-container">
  <!-- 返回导航 -->
  <view class="detail-header">
    <view class="header-top">
      <text class="name">{{formula.name}}</text>
      <text class="code">{{formula.code}}</text>
    </view>
    <text class="status" wx:if="{{formula.status}}">{{formula.status}}</text>
  </view>

  <!-- 功效 -->
  <view class="detail-section" wx:if="{{formula.target_effects && formula.target_effects.length > 0}}">
    <text class="section-title">功效</text>
    <view class="tags">
      <text class="tag" wx:for="{{formula.target_effects}}" wx:key="index">{{item}}</text>
    </view>
  </view>

  <!-- 组成 -->
  <view class="detail-section" wx:if="{{ingredients.length > 0}}">
    <text class="section-title">组成</text>
    <view class="composition">
      <view class="ingredient" wx:for="{{ingredients}}" wx:key="name">
        <text class="name">{{item.name}}</text>
        <text class="weight">{{item.weight}}{{item.unit}}</text>
        <text class="prep" wx:if="{{item.prep}}">{{item.prep}}</text>
      </view>
    </view>
  </view>

  <!-- 用法用量 -->
  <view class="detail-section" wx:if="{{formula.processing_method}}">
    <text class="section-title">使用方法</text>
    <text class="method">{{formula.processing_method}}</text>
  </view>

  <view class="detail-section" wx:if="{{formula.dosage}}">
    <text class="section-title">用量</text>
    <text class="dosage">{{formula.dosage}}</text>
  </view>

  <!-- 存放条件 -->
  <view class="detail-section" wx:if="{{formula.storage_conditions}}">
    <text class="section-title">存放</text>
    <text class="storage">{{formula.storage_conditions}}</text>
  </view>

  <!-- 保质期 -->
  <view class="detail-section" wx:if="{{formula.shelf_life}}">
    <text class="section-title">保质期</text>
    <text class="shelf-life">{{formula.shelf_life}}个月</text>
  </view>

  <!-- AI建议 -->
  <view class="detail-section" wx:if="{{formula.ai_recommendations}}">
    <text class="section-title">AI分析</text>
    <text class="ai-summary">{{formula.ai_recommendations.summary || ''}}</text>
  </view>
</view>
