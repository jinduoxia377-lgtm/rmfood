/* packages/formulas/pages/detail/index.wxss */
.detail-container {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: 40rpx;
}

.detail-header {
  background: var(--color-bg-card);
  padding: 40rpx 32rpx;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.name {
  display: block;
  font-size: var(--font-size-2xl);
  font-weight: 700;
  color: var(--color-text-primary);
  flex: 1;
  margin-right: 16rpx;
}

.code {
  display: block;
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  margin-top: 8rpx;
  white-space: nowrap;
}

.status {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  background: var(--color-bg-page);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}

.detail-section {
  background: var(--color-bg-card);
  margin: 16rpx 24rpx;
  padding: 32rpx;
  border-radius: 16rpx;
}

.section-title {
  display: block;
  font-size: var(--font-size-body);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 16rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  background: var(--color-success-bg);
  color: var(--color-success-text);
  font-size: var(--font-size-caption);
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.composition {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.ingredient {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 0.5rpx solid var(--color-border-light);
}

.ingredient:last-child {
  border-bottom: none;
}

.ingredient .name {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  font-weight: 500;
}

.ingredient .weight {
  font-size: var(--font-size-callout);
  color: var(--color-text-tertiary);
}

.ingredient .prep {
  font-size: var(--font-size-caption);
  color: var(--color-brand-primary);
  margin-left: 16rpx;
}

.method, .dosage, .storage {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.shelf-life {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
}

.ai-summary {
  font-size: var(--font-size-callout);
  color: var(--color-text-tertiary);
  line-height: 1.6;
}
