/* packages/formulas/pages/detail/index.wxss */
.detail-container {
  min-height: 100vh;
  background: #F2F2F7;
  padding-bottom: 40rpx;
}

.detail-header {
  background: #FFFFFF;
  padding: 40rpx 32rpx;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.name {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #1D1D1F;
  flex: 1;
  margin-right: 16rpx;
}

.code {
  display: block;
  font-size: 24rpx;
  color: #8E8E93;
  margin-top: 8rpx;
  white-space: nowrap;
}

.status {
  font-size: 24rpx;
  color: #8E8E93;
  background: #F2F2F7;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}

.detail-section {
  background: #FFFFFF;
  margin: 16rpx 24rpx;
  padding: 32rpx;
  border-radius: 16rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 16rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  background: #E8F5E9;
  color: #2E7D32;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.composition {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.ingredient {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 0.5rpx solid #F2F2F7;
}

.ingredient:last-child {
  border-bottom: none;
}

.ingredient .name {
  font-size: 28rpx;
  color: #1D1D1F;
  font-weight: 500;
}

.ingredient .weight {
  font-size: 26rpx;
  color: #8E8E93;
}

.ingredient .prep {
  font-size: 24rpx;
  color: #007AFF;
  margin-left: 16rpx;
}

.method, .dosage, .storage {
  font-size: 28rpx;
  color: #3A3A3C;
  line-height: 1.6;
}

.shelf-life {
  font-size: 28rpx;
  color: #3A3A3C;
}

.ai-summary {
  font-size: 26rpx;
  color: #6E6E73;
  line-height: 1.6;
}
