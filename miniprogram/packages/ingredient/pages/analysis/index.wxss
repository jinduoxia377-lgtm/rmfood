/* packages/ingredient/pages/analysis/index.wxss */
.analysis-container {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding: 24rpx;
}

.search-area {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.search-area input {
  flex: 1;
  background: var(--color-bg-card);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: var(--font-size-body);
}

.result-area {
  background: var(--color-bg-card);
  border-radius: 16rpx;
  padding: 32rpx;
}

.result-header {
  margin-bottom: 24rpx;
}

.name {
  display: block;
  font-size: var(--font-size-title-2);
  font-weight: 700;
  color: var(--color-text-primary);
}

.category {
  display: block;
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  margin-top: 8rpx;
}

.result-section {
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  font-size: var(--font-size-body);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 12rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  background: var(--color-success-bg);
  color: var(--color-success-text);
  font-size: var(--font-size-caption);
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: var(--color-text-tertiary);
}