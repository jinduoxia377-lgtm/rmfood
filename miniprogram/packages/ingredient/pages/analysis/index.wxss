/* 配料分析结果页样式 - 统一设计系统 */
.page-container {
  min-height: 100vh;
  background-color: var(--color-bg-primary);
}

.content-scroll {
  height: calc(100vh - 88rpx);
}

/* 导航栏 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-3) var(--space-4);
  background: linear-gradient(135deg, var(--color-brand-500), var(--color-brand-400));
  position: sticky;
  top: 0;
  z-index: var(--z-index-sticky);
  box-shadow: var(--shadow-brand);
}

.back-btn {
  display: flex;
  align-items: center;
  padding: var(--space-2);
  margin-left: calc(var(--space-2) * -1);
  cursor: pointer;
}

.back-text {
  font-size: var(--font-size-base);
  color: var(--color-text-white);
  margin-left: var(--space-2);
}

.nav-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-white);
}

.nav-actions {
  display: flex;
  gap: var(--space-2);
}

.action-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: var(--radius-md);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.action-btn:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.95);
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-20) var(--space-6);
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 4rpx solid var(--color-gray-200);
  border-top-color: var(--color-primary);
  border-radius: var(--radius-full);
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: var(--space-4);
  font-size: var(--font-size-base);
  color: var(--color-text-muted);
}

/* 健康评分卡片 */
.health-score-card {
  background: linear-gradient(135deg, var(--color-brand-500) 0%, var(--color-brand-400) 100%);
  color: var(--color-text-white);
}

.score-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: var(--space-3);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.2);
}

.score-label {
  font-size: var(--font-size-base);
  opacity: 0.9;
}

.nova-badge {
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-full);
  font-size: var(--font-size-sm);
  background: rgba(255, 255, 255, 0.2);
}

.nova-text {
  color: var(--color-text-white);
}

.score-main {
  display: flex;
  align-items: center;
  padding: var(--space-4) 0;
}

.nutri-score-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-full);
  border: 8rpx solid;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-right: var(--space-4);
}

.nutri-letter {
  font-size: 72rpx;
  font-weight: var(--font-weight-bold);
  line-height: 1;
}

.score-details {
  flex: 1;
}

.score-value {
  font-size: 48rpx;
  font-weight: var(--font-weight-bold);
  line-height: 1;
}

.score-text {
  font-size: var(--font-size-sm);
  opacity: 0.9;
  margin-top: var(--space-2);
}

.score-breakdown {
  display: flex;
  justify-content: space-around;
  padding-top: var(--space-3);
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.breakdown-item {
  text-align: center;
}

.breakdown-label {
  display: block;
  font-size: var(--font-size-sm);
  opacity: 0.8;
  margin-bottom: var(--space-2);
}

.breakdown-value {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
}

/* 营养成分表 */
.nutrition-table {
  margin-top: var(--space-3);
}

.table-header,
.table-row {
  display: flex;
  padding: var(--space-3) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.table-header {
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-muted);
  background-color: var(--color-bg-tertiary);
}

.th-name, .td-name {
  flex: 2;
}

.th-amount, .td-amount {
  flex: 2;
  text-align: center;
}

.th-nrv, .td-nrv {
  flex: 1;
  text-align: right;
}

.important-row {
  font-weight: var(--font-weight-medium);
}

.table-footer {
  margin-top: var(--space-2);
  padding-top: var(--space-2);
  border-top: 1rpx dashed var(--color-border);
}

.footer-note {
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
}

/* 分析区域 */
.analysis-section {
  margin-top: var(--space-4);
  padding-top: var(--space-4);
  border-top: 1rpx solid var(--color-border);
}

.section-title {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-bottom: var(--space-3);
}

.title-icon {
  font-size: var(--font-size-lg);
}

.title-text {
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  flex: 1;
}

.badge {
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-md);
  font-size: var(--font-size-xs);
}

.badge-success {
  background-color: var(--color-success-light);
  color: var(--color-success);
}

.badge-warning {
  background-color: var(--color-warning-light);
  color: var(--color-warning);
}

.badge-danger {
  background-color: var(--color-danger-light);
  color: var(--color-danger);
}

/* 添加剂列表 */
.additive-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.additive-item {
  display: flex;
  align-items: center;
  padding: var(--space-3);
  background-color: var(--color-bg-secondary);
  border-radius: var(--radius-lg);
}

.additive-item.safe {
  background-color: var(--color-success-light);
}

.additive-item.warning {
  background-color: var(--color-warning-light);
}

.additive-item.danger {
  background-color: var(--color-danger-light);
}

.additive-name {
  flex: 1;
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
}

.additive-e {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
  margin-right: var(--space-3);
}

.additive-risk {
  font-size: var(--font-size-sm);
}

/* 过敏原列表 */
.allergen-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
}

.allergen-item {
  display: flex;
  align-items: center;
  padding: var(--space-2) var(--space-3);
  background-color: var(--color-warning-light);
  border-radius: var(--radius-md);
}

.allergen-name {
  font-size: var(--font-size-sm);
  color: var(--color-warning);
  margin-right: var(--space-2);
}

.allergen-level {
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
}

/* 药食同源成分 */
.herblist {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.herb-item {
  padding: var(--space-4);
  background-color: var(--color-success-light);
  border-radius: var(--radius-lg);
  border-left: 4rpx solid var(--color-success);
}

.herb-header {
  display: flex;
  align-items: baseline;
  gap: var(--space-2);
  margin-bottom: var(--space-2);
}

.herb-name {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-success);
}

.herb-latin {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
  font-style: italic;
}

.herb-function {
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  margin-bottom: var(--space-2);
}

.herb-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-1);
}

/* 改进建议 */
.suggestions-card {
  background-color: var(--color-info-light);
}

.suggestion-item {
  padding: var(--space-3) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.suggestion-item:last-child {
  border-bottom: none;
}

.suggestion-text {
  font-size: var(--font-size-base);
  color: var(--color-info);
  line-height: var(--line-height-relaxed);
}

/* 替代配方 */
.alternative-card {
  background-color: var(--color-warning-light);
}

.formula-item {
  display: flex;
  align-items: center;
  padding: var(--space-4) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.formula-item:last-child {
  border-bottom: none;
}

.formula-info {
  flex: 1;
}

.formula-name {
  display: block;
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin-bottom: var(--space-1);
}

.formula-desc {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
  margin-bottom: var(--space-2);
}

.formula-score {
  display: flex;
  align-items: baseline;
  gap: var(--space-1);
}

.score-value {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-bold);
}

.score-label {
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
}

.formula-arrow {
  font-size: var(--font-size-xl);
  color: var(--color-text-muted);
  margin-left: var(--space-3);
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: var(--space-3);
  padding: var(--space-4);
  background: var(--color-bg-secondary);
  box-shadow: var(--shadow-lg);
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  padding: var(--space-4);
  border-radius: var(--radius-lg);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-medium);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.action-btn.primary {
  background: linear-gradient(135deg, var(--color-brand-500), var(--color-brand-400));
  color: var(--color-text-white);
}

.action-btn.secondary {
  background: var(--color-bg-primary);
  color: var(--color-text-primary);
}

.action-btn:active {
  transform: scale(0.98);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-20) var(--space-6);
  gap: var(--space-3);
}

.empty-title {
  font-size: var(--font-size-lg);
  color: var(--color-text-primary);
  font-weight: var(--font-weight-semibold);
}

.empty-desc {
  font-size: var(--font-size-base);
  color: var(--color-text-muted);
  text-align: center;
}

/* 底部间距 */
.bottom-spacing {
  height: calc(var(--space-6) + env(safe-area-inset-bottom));
}
