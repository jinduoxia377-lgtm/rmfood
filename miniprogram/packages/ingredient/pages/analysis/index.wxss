/* packages/ingredient/pages/analysis/index.wxss */
.analysis-container {
  min-height: 100vh;
  background: #F2F2F7;
  padding: 24rpx;
}

.search-area {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.search-area input {
  flex: 1;
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.result-area {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
}

.result-header {
  margin-bottom: 24rpx;
}

.name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1D1D1F;
}

.category {
  display: block;
  font-size: 24rpx;
  color: #8E8E93;
  margin-top: 8rpx;
}

.result-section {
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 12rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  background: #E8F5E9;
  color: #4CAF50;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #8E8E93;
}