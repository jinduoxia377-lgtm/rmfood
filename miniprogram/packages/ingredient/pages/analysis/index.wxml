<!--packages/ingredient/pages/analysis/index.wxml-->
<view class="analysis-container">
  <view class="search-area">
    <input placeholder="输入食材名称..." bindinput="onSearch" value="{{keyword}}" />
    <button type="primary" loading="{{loading}}" bindtap="analyze">分析</button>
  </view>

  <!-- 结果区域 -->
  <view class="result-area" wx:if="{{result}}">
    <view class="result-header">
      <text class="name">{{result.name_cn}}</text>
      <text class="latin">{{result.name_latin}}</text>
    </view>

    <view class="result-section">
      <text class="section-title">性味归经</text>
      <text class="properties">{{result.nature_cn}} · {{result.meridians_cn}}</text>
    </view>

    <view class="result-section">
      <text class="section-title">功效</text>
      <text class="function">{{result.function_cn}}</text>
    </view>

    <view class="result-section">
      <text class="section-title">类别</text>
      <text class="category">{{result.category_cn}}</text>
    </view>

    <view class="result-section">
      <text class="section-title">药用部位</text>
      <text>{{result.use_part}}</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{!result && !loading}}">
    <text>请输入食材名称进行分析</text>
  </view>

  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <text>搜索中...</text>
  </view>
</view>
