/**
 * RMFOOD 小程序 - 栅格系统 (Grid System)
 * 基于 16px (32rpx) 基准网格，符合微信官方设计规范
 */

/* ============================================
   1. 页面容器规范
   ============================================ */

/* 标准页面容器 - 带安全区 */
.page-container {
  min-height: 100vh;
  background: var(--color-bg-page);
  display: flex;
  flex-direction: column;
  /* 顶部安全区 */
  padding-top: env(safe-area-inset-top);
  box-sizing: border-box;
}

/* 内容滚动区 */
.page-content {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

/* 页面内边距 - 统一 16px (32rpx) */
.page-padding {
  padding: 0 32rpx;
}

/* ============================================
   2. 栅格系统 (Grid)
   ============================================ */

/* 12列栅格 - 基准单位 16px (32rpx) */
.grid {
  display: grid;
  gap: 32rpx;
}

/* 2列 */
.grid-2 {
  grid-template-columns: repeat(2, 1fr);
}

/* 3列 */
.grid-3 {
  grid-template-columns: repeat(3, 1fr);
}

/* 4列 */
.grid-4 {
  grid-template-columns: repeat(4, 1fr);
}

/* ============================================
   3. 卡片容器规范
   ============================================ */

/* 标准卡片 - 圆角 16rpx，阴影 */
.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-sm);
  margin-bottom: 32rpx;
}

/* 卡片标题 */
.card-title {
  font-size: var(--font-size-title-3);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin-bottom: 16rpx;
}

/* 卡片内容 */
.card-content {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  line-height: var(--line-height-normal);
}

/* ============================================
   4. 列表规范
   ============================================ */

/* Apple 风格分组列表 */
.list-group {
  background: var(--color-bg-card);
  margin: 16rpx 32rpx;
  border-radius: var(--radius-card);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

/* 列表项 */
.list-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  min-height: 88rpx;
  position: relative;
  -webkit-tap-highlight-color: transparent;
}

.list-item:active {
  background: var(--color-bg-hover);
}

.list-item:not(:last-child)::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 88rpx;
  right: 0;
  height: 0.5rpx;
  background: var(--color-separator);
}

/* 列表项图标 */
.list-item-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: var(--radius-sm);
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 列表项内容 */
.list-item-content {
  flex: 1;
  min-width: 0;
}

.list-item-title {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: var(--line-height-normal);
}

.list-item-subtitle {
  font-size: var(--font-size-callout);
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

/* 列表项附属 */
.list-item-accessory {
  color: var(--color-text-tertiary);
  margin-left: 16rpx;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

/* ============================================
   5. 间距规范 (Spacing)
   ============================================ */

/* section 间距 */
.section {
  padding: 32rpx 32rpx 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: var(--font-size-title-3);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.section-more {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx;
  margin: -8rpx;
  -webkit-tap-highlight-color: transparent;
}

.more-text {
  font-size: var(--font-size-callout);
  color: var(--color-system-blue);
}

/* ============================================
   6. 底部安全区
   ============================================ */

/* TabBar 底部安全区 */
.tabbar-safe-bottom {
  height: calc(40rpx + env(safe-area-inset-bottom));
}

/* 通用底部间距 */
.bottom-spacing {
  height: calc(40rpx + env(safe-area-inset-bottom));
}

/* ============================================
   7. 表单规范
   ============================================ */

/* 输入框容器 */
.form-item {
  padding: 24rpx 32rpx;
  background: var(--color-bg-card);
}

.form-item:not(:last-child) {
  border-bottom: 0.5rpx solid var(--color-separator);
}

.form-label {
  font-size: var(--font-size-callout);
  color: var(--color-text-tertiary);
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  width: 100%;
  border: none;
  outline: none;
  background: transparent;
}

.form-input::placeholder {
  color: var(--color-text-placeholder);
}

/* ============================================
   8. 响应式断点
   ============================================ */

/* 小屏设备 (iPhone SE) */
@media (max-width: 375px) {
  .page-padding {
    padding: 0 24rpx;
  }
  .list-group {
    margin: 16rpx 24rpx;
  }
  .list-item {
    padding: 24rpx 24rpx;
  }
}

/* 大屏设备 (iPhone Plus) */
@media (min-width: 414px) {
  .page-padding {
    padding: 0 40rpx;
  }
}
