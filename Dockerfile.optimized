# ═══════════════════════════════════════════════
# RMFOOD 精简 Dockerfile - 只复制必要文件
# ═══════════════════════════════════════════════

# ─── 后端构建 ───
FROM python:3.11-slim AS backend-builder

WORKDIR /app

# 安装构建依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev g++ && rm -rf /var/lib/apt/lists/*

# 只复制 requirements 文件
COPY backend/requirements.txt .

# 安装依赖
RUN pip install --no-cache-dir --user \
    --prefix=/install -r requirements.txt 2>/dev/null || \
    pip install --no-cache-dir --user -r requirements.txt

# ─── 后端生产镜像 ───
FROM python:3.11-slim AS backend-production

# 创建用户
RUN groupadd --gid 1000 appgroup && \
    useradd --uid 1000 --gid appgroup --shell /bin/bash --create-home appuser

WORKDIR /app

# 安装运行时依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 curl && rm -rf /var/lib/apt/lists/*

# 复制已安装的包
COPY --from=backend-builder /root/.local /home/appuser/.local
COPY --from=backend-builder /usr/local/lib/python3.11/site-packages \
    /usr/local/lib/python3.11/site-packages

ENV PATH=/home/appuser/.local/bin:$PATH
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# 只复制必要的应用文件
COPY backend/app/ ./app/
COPY backend/docker-healthcheck.py /usr/local/bin/healthcheck.py

RUN chmod +x /usr/local/bin/healthcheck.py
USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python /usr/local/bin/healthcheck.py || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]


# ─── 前端构建 ───
FROM node:20-alpine AS frontend-builder

WORKDIR /app

# 只复制 package 文件来利用缓存
COPY frontend/package*.json ./
COPY frontend/pnpm-lock.yaml* ./ 2>/dev/null || true

# 安装依赖
RUN npm ci --prefer-offline --no-audit 2>&1 | tail -3

# 只复制必要的源代码
COPY frontend/src/ ./src/
COPY frontend/public/ ./public/
COPY frontend/index.html ./
COPY frontend/vite.config.ts ./
COPY frontend/tsconfig.json ./
COPY frontend/tsconfig.app.json ./
COPY frontend/.env* ./ 2>/dev/null || true

# 构建
ARG VITE_API_BASE_URL=/api
ARG VITE_APP_TITLE=RMFOOD配方平台
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_APP_TITLE=$VITE_APP_TITLE

RUN npm run build

# ─── 前端运行 ───
FROM nginx:1.25-alpine

RUN rm -rf /etc/nginx/conf.d/default.conf /usr/share/nginx/html/*

COPY --from=frontend-builder /app/dist /usr/share/nginx/html
COPY frontend/docker/nginx.conf /etc/nginx/conf.d/default.conf

RUN chown -R nginx:nginx /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
