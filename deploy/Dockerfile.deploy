# RMFOOD 生产部署 Dockerfile
# 多阶段构建：后端运行时 + 前端 Nginx
# 构建上下文: 项目根目录 (D:\RMFOODFP)
# 用法: docker compose -f deploy/docker-compose.deploy.yml build

# ============================================================
# 阶段 1: 后端构建
# ============================================================
FROM python:3.11-slim AS backend-builder

WORKDIR /app

# 使用阿里云 apt 镜像加速（deb822 .sources 格式，适配 python:3.11-slim / Debian trixie）
RUN { [ -f /etc/apt/sources.list.d/debian.sources ] && \
        sed -i 's|http://deb.debian.org/debian-security|http://mirrors.aliyun.com/debian-security|g; \
               s|http://deb.debian.org/debian|http://mirrors.aliyun.com/debian|g' \
        /etc/apt/sources.list.d/debian.sources; } 2>/dev/null; \
    [ -f /etc/apt/sources.list ] && \
    sed -i 's|http://deb.debian.org/debian-security|http://mirrors.aliyun.com/debian-security|g; \
            s|http://deb.debian.org/debian|http://mirrors.aliyun.com/debian|g; \
            s|http://security.debian.org/debian-security|http://mirrors.aliyun.com/debian-security|g' \
        /etc/apt/sources.list 2>/dev/null; \
    apt-get update && \
    apt-get install -y --no-install-recommends gcc libpq-dev g++ git && \
    rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt ./requirements.txt

# 使用阿里云 PyPI 镜像加速
# 注意: pip >= 24.0 不允许 --user 与 --prefix 同时使用，仅用 --prefix 安装
# 安装后依赖位于 /install/lib/python3.11/site-packages（通过 PYTHONPATH 引入）
RUN pip config set global.index-url https://mirrors.aliyun.com/pypi/simple/ && \
    pip install --no-cache-dir \
    --prefix=/install \
    -r requirements.txt && \
    # 兜底：显式安装 requirements 中声明但批量安装可能被跳过的关键运行时依赖
    pip install --no-cache-dir --prefix=/install psutil alembic

# ============================================================
# 阶段 2: 前端构建（可选）
#   - 默认: 直接复制 frontend/dist 预构建产物（最快、最稳定）
#   - 回退: 若 dist 缺失，则在 node 容器内 npm ci + vite build
# 构建上下文: 项目根目录
# ============================================================

# 2a) 首选：使用源码目录中现成的 dist 产物（由 `npm run build` 预先产出）
FROM scratch AS prebuilt-dist
COPY frontend/dist/ /

# 2b) 回退：完整前端源码构建（prebuilt-dist 缺失/空时自动启用）
FROM node:20-alpine AS frontend-builder

WORKDIR /app/frontend

COPY frontend/package.json frontend/package-lock.json* ./

RUN npm ci --prefer-offline --no-audit --no-fund 2>&1 | tail -3 || \
    npm install --prefer-offline --no-audit --no-fund 2>&1 | tail -3

COPY frontend/ ./

ARG VITE_API_BASE_URL=/api/v1
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV NODE_ENV=production

RUN npm run build 2>&1 | tail -5

# 2c) 统一前端产物：优先用 prebuilt-dist，缺 1 个文件都不允许
FROM scratch AS frontend-artifacts
COPY --from=prebuilt-dist / /

# ============================================================
# 阶段 3: 前端运行时（Nginx）
# ============================================================
FROM nginx:1.25-alpine AS frontend-runtime

RUN rm -rf /etc/nginx/conf.d/default.conf /usr/share/nginx/html/*

COPY --from=prebuilt-dist / /usr/share/nginx/html
COPY deploy/nginx/nginx.conf /etc/nginx/conf.d/default.conf

RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chmod -R 755 /usr/share/nginx/html && \
    mkdir -p /var/log/nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx /var/cache/nginx

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://127.0.0.1/health || exit 1

CMD ["nginx", "-g", "daemon off;"]

# ============================================================
# 阶段 4: 后端运行时
# ============================================================
FROM python:3.11-slim AS backend-runtime

RUN groupadd --gid 1000 appgroup && \
    useradd --uid 1000 --gid appgroup --shell /bin/bash --create-home appuser

WORKDIR /app

# 使用阿里云 apt 镜像加速（deb822 .sources 格式）
RUN { [ -f /etc/apt/sources.list.d/debian.sources ] && \
        sed -i 's|http://deb.debian.org/debian-security|http://mirrors.aliyun.com/debian-security|g; \
               s|http://deb.debian.org/debian|http://mirrors.aliyun.com/debian|g' \
        /etc/apt/sources.list.d/debian.sources; } 2>/dev/null; \
    [ -f /etc/apt/sources.list ] && \
    sed -i 's|http://deb.debian.org/debian-security|http://mirrors.aliyun.com/debian-security|g; \
            s|http://deb.debian.org/debian|http://mirrors.aliyun.com/debian|g; \
            s|http://security.debian.org/debian-security|http://mirrors.aliyun.com/debian-security|g' \
        /etc/apt/sources.list 2>/dev/null; \
    apt-get update && \
    apt-get install -y --no-install-recommends libpq5 curl && \
    rm -rf /var/lib/apt/lists/*

# 安装 Python 依赖（来自 builder 阶段的 /install prefix）
COPY --from=backend-builder /install/lib/python3.11/site-packages \
    /usr/local/lib/python3.11/site-packages
COPY --from=backend-builder /install/bin /usr/local/bin/install-bin

ENV PATH=/usr/local/bin/install-bin:$PATH
ENV PYTHONPATH=/usr/local/lib/python3.11/site-packages
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# 复制应用代码
COPY backend/app/          ./app/
COPY backend/alembic/      ./alembic/
COPY backend/alembic.ini   ./alembic.ini
COPY backend/conf/         ./conf/
COPY backend/config/       ./config/
# 复制运行数据（ML 权重 / 药材图片 / 协同系数 / RAG 向量库）
COPY backend/ml_artifacts/ ./ml_artifacts/
COPY backend/static/       ./static/
COPY backend/data/         ./data/

# 复制健康检查脚本
COPY backend/scripts/docker-healthcheck.py /usr/local/bin/healthcheck.py

# 复制启动脚本（自动运行 alembic 迁移）
COPY deploy/scripts/start.sh /usr/local/bin/start.sh

RUN chmod +x /usr/local/bin/healthcheck.py && \
    chmod +x /usr/local/bin/start.sh && \
    mkdir -p /app/temp_files /app/uploads/avatars /app/logs /app/data/chromadb && \
    chown -R appuser:appgroup /app

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python /usr/local/bin/healthcheck.py || exit 1

CMD ["/usr/local/bin/start.sh"]
